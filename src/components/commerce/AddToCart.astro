---
import { formatPrice } from '@/lib/site';

interface Props {
  handle: string;
  name: string;
  price: number;
  image: string;
  url: string;
  available: boolean;
  compact?: boolean;
}

const { handle, name, price, image, url, available, compact = false } = Astro.props;
---

{available ? (
  <form data-add-to-cart class:list={[compact ? '' : 'w-full']} method="post" action="#">
    <input type="hidden" name="handle" value={handle} />
    <input type="hidden" name="name" value={name} />
    <input type="hidden" name="price" value={price} />
    <input type="hidden" name="image" value={image} />
    <input type="hidden" name="url" value={url} />
    <input type="hidden" name="quantity" value="1" />
    <button type="submit" class:list={['btn-primary', compact ? '' : 'w-full']}>
      {compact ? 'Bestel nu' : `In winkelmandje · ${formatPrice(price)}`}
    </button>
  </form>
) : (
  <div class:list={[compact ? '' : 'w-full']}>
    <button type="button" disabled class:list={['btn cursor-not-allowed bg-line text-muted', compact ? '' : 'w-full']}>
      Tijdelijk uitverkocht
    </button>
    {!compact && (
      <p class="mt-2 text-center text-sm">
        Deze box is even niet op voorraad.{' '}
        <a class="text-brand underline" href="/shop/">
          Bekijk intussen onze andere boxen
        </a>
        .
      </p>
    )}
  </div>
)}
