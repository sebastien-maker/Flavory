---
// The two boxes as cards inside a hero: one tap from the top of the page to a box. Red and white side by side,
// also on a phone. The colour of the button follows the wine (docs/design-richtlijnen.md).
// The product stands free on the card (a packshot without background). During a promotion the hero is dark
// and so are the cards, with a soft glow in the colour of the wine behind the product.
// With `quickAdd` the button puts the cheapest box you can buy straight into the cart (the same form the
// product page uses, see CartDrawer.astro) and a text link leads to the product page.
import { Image, getImage } from 'astro:assets';
import {
  availableVariants,
  colourChoices,
  fromPrice,
  productImages,
  productPath,
  variantName,
  type Product,
} from '@/lib/content';
import Price from '@/components/commerce/Price.astro';
import { COLOUR_STYLES } from '@/lib/colour-choice';
import { SITE } from '@/lib/site';

interface Props {
  /** All products; the cards pick the box per colour that is for sale now. */
  products: Product[];
  quickAdd?: boolean;
  id?: string;
  class?: string;
}

const { products, quickAdd = false, id, class: className } = Astro.props;
const promo = SITE.campaign === 'blackfriday' && SITE.blackFriday.offer;
const { badge } = SITE.blackFriday;

const cards = await Promise.all(
  colourChoices(products)
    .map(async ({ label, product }) => {
      const cheapest = availableVariants(product).sort((a, b) => a.price - b.price)[0];
      const price = fromPrice(product);
      return {
        product,
        style: COLOUR_STYLES[label],
        url: productPath(product.id),
        price,
        regularPrice: product.data.variants.find((v) => v.price === price)?.regularPrice,
        // The box the quick-add button puts in the cart, with the small photo the cart shows.
        add: quickAdd && cheapest
          ? {
              variant: cheapest,
              name: variantName(product, cheapest),
              thumb: (await getImage({ src: productImages(product)[0]!.src, width: 96, height: 96, fit: 'cover', format: 'webp' })).src,
            }
          : undefined,
      };
    }),
);
---

<ul id={id} class:list={['grid grid-cols-2 gap-3', className]}>
  {cards.map(({ product, style, url, price, regularPrice, add }) => (
    <li class:list={['box-pick', style.glow]}>
      <a href={url} class="relative block" tabindex={add ? undefined : -1} aria-hidden={add ? undefined : 'true'}>
        <Image
          src={style.cutout}
          alt={add ? style.alt : ''}
          width={480}
          height={480}
          widths={[240, 360, 720]}
          sizes="(min-width: 768px) 17rem, 45vw"
          class="box-pick-img"
          loading="eager"
        />
        {promo && badge && <span class="bf-badge absolute top-2 left-2">{badge}</span>}
      </a>
      <div class="flex flex-1 flex-col px-3 pb-3.5 text-center">
        <h3 class="text-[1.375rem] leading-none">{style.title}</h3>
        <p class:list={['mt-1.5 text-sm leading-tight italic', promo ? 'bf-soft' : style.line]}>
          {product.data.duel}?
        </p>
        <p class="mt-2 mb-3 font-bold">
          <Price price={price} regularPrice={regularPrice} />
        </p>
        {add ? (
          <>
            <form data-add-to-cart method="post" action="#" class="mt-auto">
              <input type="hidden" name="handle" value={`${product.id}:${add.variant.id}`} />
              <input type="hidden" name="name" value={add.name} />
              <input type="hidden" name="price" value={add.variant.price} />
              <input type="hidden" name="regular_price" value={add.variant.regularPrice ?? ''} />
              <input type="hidden" name="image" value={add.thumb} />
              <input type="hidden" name="url" value={url} />
              <input type="hidden" name="quantity" value="1" />
              <input type="hidden" name="woo_id" value={add.variant.wooId ?? ''} />
              <button type="submit" class:list={['choice-button w-full', style.button]}>
                In winkelmandje
              </button>
            </form>
            <a href={url} class="mt-1 flex min-h-11 items-center justify-center text-sm font-bold underline">
              Bekijk de box
            </a>
          </>
        ) : (
          <a href={url} class:list={['choice-button after:absolute after:inset-0', style.button]}>
            {style.cta}
          </a>
        )}
      </div>
    </li>
  ))}
</ul>
