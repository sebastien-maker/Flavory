---
// The boxes on the home page, one card per duel: photo, price and one button that puts the Standaard box
// straight into the cart. Premium is a quiet second button on the same card, not a choice you must make first.
// White comes first, then the red duels (Merlot of Cabernet Sauvignon, then Italië of Spanje while it lasts).
// Every button is its own <form data-add-to-cart>; the cart drawer handles the submit (CartDrawer.astro).
import { Image, getImage } from 'astro:assets';
import Price from './Price.astro';
import { productPath, variantName, type Product } from '@/lib/content';
import { COLOUR_STYLES, colourOf } from '@/lib/colour-choice';
import { FORMULAS, PREMIUM_MARK, SITE, shippingLine } from '@/lib/site';

interface Props {
  /** All products; a card is made for every duel that is, or was, for sale. */
  products: Product[];
}

const { products } = Astro.props;
const colourOrder = { Wit: 0, Rood: 1 } as const;
const soldOutLabel = 'Tijdelijk uitverkocht';
const promo = SITE.campaign === 'blackfriday' && SITE.blackFriday.offer;

const boxes = await Promise.all(
  products
    .flatMap((product) => {
      const colour = colourOf(product.data.category.id);
      return [...new Set(product.data.variants.map((v) => v.duel))].map((duel) => {
        // An option that is not on sale yet gets no button here; the product page announces it.
        const variants = product.data.variants.filter((v) => v.duel === duel && !v.comingSoon);
        const group = variants[0]?.group;
        const lead = product.data.descriptions.find((d) => d.group === group)?.lead ?? '';
        return {
          product,
          colour,
          duel,
          standard: variants.find((v) => v.formula === 'Standaard'),
          premium: variants.find((v) => v.formula === 'Premium'),
          image: product.data.images.find((img) => img.group === group) ?? product.data.images[0]!,
          // The CMS text of the duel says when it is leftover stock; the card repeats that as a label.
          limited: /zolang de voorraad strekt/i.test(lead),
        };
      });
    })
    .filter((box, i, all) => (box.standard ?? box.premium) && all.findIndex((b) => b.duel === box.duel) === i)
    .sort((a, b) => colourOrder[a.colour] - colourOrder[b.colour])
    .map(async (box) => ({
      ...box,
      style: COLOUR_STYLES[box.colour],
      thumb: (await getImage({ src: box.image.src, width: 96, height: 96, fit: 'cover', format: 'webp' })).src,
    })),
);
---

<div>
  <h2 id="boxen-title" class="h2 text-center">Kies je box</h2>
  <p class="mx-auto mt-2 max-w-2xl text-center">Elke box is één avond: het spel en twee flessen wijn (75 cl).</p>
  {
    promo && (
      <p class="mt-1 text-center font-bold text-brand">
        {promo}
        {SITE.blackFriday.endDate && `, tot en met ${SITE.blackFriday.endDate}`}
      </p>
    )
  }

  <ul class="mx-auto mt-6 grid max-w-md gap-4 md:max-w-none md:grid-cols-3">
    {
      boxes.map(({ product, colour, duel, standard, premium, image, limited, style, thumb }) => {
        const url = productPath(product.id);
        const options = [standard, premium].filter((v) => v !== undefined);
        return (
          <li class="box-card">
            <Image
              src={image.src}
              alt={image.alt}
              width={480}
              height={480}
              widths={[240, 360, 480, 720]}
              sizes="(min-width: 768px) 22rem, 28rem"
              class="box-card-img"
            />
            <div class="flex flex-1 flex-col p-4">
              <p class:list={['text-sm font-bold', style.line]}>
                {style.title}
                {limited && <span class="text-muted"> · zolang de voorraad strekt</span>}
              </p>
              <h3 class="mt-1 text-xl leading-tight">
                <a href={url} class="hover:underline">
                  {duel}?
                </a>
              </h3>
              <p class="mt-2 text-sm">
                Het spel en twee {colour === 'Wit' ? 'witte' : 'rode'} wijnen (75 cl) in zakjes A en B.
              </p>
              <div class="pt-4">
                {options.map((v) => {
                  const isPremium = v.formula === 'Premium';
                  return (
                    <form
                      data-add-to-cart
                      data-box-form
                      data-sold-out-label={soldOutLabel}
                      method="post"
                      action="#"
                      class:list={[isPremium && 'mt-4 border-t border-line pt-3']}
                    >
                      <input type="hidden" name="handle" value={`${product.id}:${v.id}`} />
                      <input type="hidden" name="name" value={variantName(product, v)} />
                      <input type="hidden" name="price" value={v.price} />
                      <input type="hidden" name="regular_price" value={v.regularPrice ?? ''} />
                      <input type="hidden" name="image" value={thumb} />
                      <input type="hidden" name="url" value={url} />
                      <input type="hidden" name="quantity" value="1" />
                      <input type="hidden" name="woo_id" value={v.wooId ?? ''} />
                      {isPremium ? (
                        <p class="text-sm">
                          <strong>
                            Premium
                            <span class="premium-mark" aria-hidden="true">
                              {PREMIUM_MARK}
                            </span>{' '}
                            <span data-box-price>
                              <Price price={v.price} regularPrice={v.regularPrice} />
                            </span>
                          </strong>
                          <span class="block text-muted">{FORMULAS.Premium}</span>
                        </p>
                      ) : (
                        <p class="text-xl font-bold" data-box-price>
                          <Price price={v.price} regularPrice={v.regularPrice} />
                        </p>
                      )}
                      <button
                        type="submit"
                        class:list={[
                          'btn mt-2 w-full',
                          isPremium ? 'min-h-10 border-2 border-ink py-2 text-sm hover:bg-ink hover:text-white' : style.button,
                          'disabled:border-line disabled:bg-line disabled:text-muted',
                        ]}
                        data-label={isPremium ? 'Premium in winkelmandje' : 'In winkelmandje'}
                        disabled={!v.available}
                      >
                        {v.available ? (isPremium ? 'Premium in winkelmandje' : 'In winkelmandje') : soldOutLabel}
                      </button>
                    </form>
                  );
                })}
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>

  <p class="mt-6 text-center text-sm text-muted">
    {shippingLine()}
    <br />
    {SITE.guarantee}
  </p>
</div>

<script>
  import { WOO_API_PROXY, parseStoreProducts, storeProductsPath } from '@/lib/commerce/woo';
  import { renderPrice } from '@/lib/commerce/price';

  // Live price and stock from WooCommerce (same proxy as the product pages). The HTML already has the
  // build-time values, so a failed request changes nothing. A box that sold out since the build cannot
  // be put in the cart, and one that came back can.
  const forms = [...document.querySelectorAll<HTMLFormElement>('form[data-box-form]')];
  const field = (form: HTMLFormElement, name: string) => {
    const input = form.elements.namedItem(name);
    return input instanceof HTMLInputElement ? input : undefined;
  };
  const wooId = (form: HTMLFormElement) => Number(field(form, 'woo_id')?.value);
  const ids = [...new Set(forms.map(wooId).filter(Boolean))];

  if (ids.length > 0) {
    fetch(`${WOO_API_PROXY}${storeProductsPath(ids)}`)
      .then((res) => (res.ok ? res.json() : []))
      .then((json: unknown) => {
        const stock = parseStoreProducts(json);
        for (const form of forms) {
          const live = stock.get(wooId(form));
          if (!live) continue;
          const price = field(form, 'price');
          const regular = field(form, 'regular_price');
          if (price) price.value = String(live.price);
          if (regular) regular.value = live.regularPrice ? String(live.regularPrice) : '';
          const shown = form.querySelector('[data-box-price]');
          if (shown) renderPrice(shown, live.price, live.regularPrice);
          const button = form.querySelector('button');
          if (button) {
            button.disabled = !live.buyable;
            button.textContent = live.buyable ? (button.dataset.label ?? '') : (form.dataset.soldOutLabel ?? '');
          }
        }
      })
      .catch(() => {});
  }
</script>
