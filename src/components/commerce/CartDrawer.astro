---
import { SITE } from '@/lib/site';
import Countdown from '@/components/ui/Countdown.astro';

// Running promotion (SITE.campaign): the offer and the time left stand at the top of the cart.
const promo = !SITE.checkoutNotice && SITE.campaign === 'blackfriday' && SITE.blackFriday.offer;
const { endDate, endsAt, hurry } = SITE.blackFriday;
// Fallback when online checkout is unavailable. Without an e-mail address the link would be empty,
// so we point to the contact page instead.
const contact = SITE.email
  ? { href: `mailto:${SITE.email}`, label: SITE.email }
  : { href: '/contact/', label: 'het contactformulier' };
---

<dialog
  id="cart-drawer"
  aria-labelledby="cart-title"
  class="fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-dvh w-full max-w-md bg-cream p-0 shadow-2xl backdrop:bg-ink/50"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b border-line px-5 py-4">
      <p id="cart-title" class="font-display text-2xl">
        Je winkelmandje
      </p>
      <button
        type="button"
        data-cart-close
        class="flex size-10 items-center justify-center rounded-full hover:bg-blush"
        aria-label="Winkelmandje sluiten"
      >
        <svg class="size-5" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    {promo && (
      <p class="bg-ink px-5 py-2 text-sm font-bold text-white">
        {promo}
        {!endDate && hurry && <span class="block font-normal">{hurry}</span>}
        {endDate && (
          <span class="block font-normal first-letter:uppercase">
            {endsAt ? <Countdown endsAt={endsAt} fallback={`tot en met ${endDate}`} /> : `tot en met ${endDate}`}
          </span>
        )}
      </p>
    )}

    <p data-cart-progress class="bg-blush px-5 py-3 text-sm font-bold" aria-live="polite"></p>

    <ul data-cart-lines class="flex-1 divide-y divide-line overflow-y-auto px-5"></ul>

    {/* One box in the cart: the box of the other colour, which makes shipping free. Filled in by the script. */}
    <div data-cart-upsell hidden class="px-5 pb-4"></div>

    <div data-cart-empty hidden class="flex flex-1 flex-col items-center justify-center gap-4 px-5 text-center">
      <p class="font-display text-xl">Je winkelmandje is nog leeg.</p>
      <a href="/shop/" class="btn-primary">
        Ontdek de boxen
      </a>
    </div>

    <div data-cart-footer class="border-t border-line px-5 py-5">
      <div class="flex items-center justify-between text-lg font-bold">
        <span>Subtotaal</span>
        <span data-cart-subtotal></span>
      </div>
      <div class="mt-1 flex items-center justify-between text-sm">
        <span>Verzending in België en Nederland</span>
        <span class="font-bold" data-cart-shipping></span>
      </div>
      <p class="mt-1 text-xs text-muted">
        Inclusief btw. Gratis verzending vanaf {SITE.shipping.freeFromBoxes} boxen.
      </p>
      {SITE.checkoutNotice && (
        <p class="mt-3 rounded-lg bg-[#f28c28] px-3 py-2.5 text-sm font-bold text-ink" role="status">
          {SITE.checkoutNotice} Liever niet wachten? Mail ons via{' '}
          <a href={contact.href} class="underline">
            {contact.label}
          </a>
          .
        </p>
      )}
      <button type="button" data-cart-checkout class="btn-primary mt-4 w-full">
        Afrekenen
      </button>
      {/* Rating, guarantee, delivery time and payment logos: filled by the script, so no page carries the HTML. */}
      <div data-cart-trust class="mt-3 text-sm"></div>
      {/* Shown from the click on 'Afrekenen' until the WooCommerce checkout has loaded (that takes seconds). */}
      <div data-checkout-wait hidden class="checkout-wait" role="status" aria-live="polite">
        <svg class="checkout-glass" viewBox="0 0 64 96" aria-hidden="true">
          <defs>
            <clipPath id="checkout-bowl">
              <path d="M12 4h40v26c0 14-8 24-20 26C20 54 12 44 12 30z" />
            </clipPath>
          </defs>
          <rect class="checkout-wine" x="0" y="0" width="64" height="60" clip-path="url(#checkout-bowl)" />
          <path
            d="M12 4h40v26c0 14-8 24-20 26C20 54 12 44 12 30zM32 56v30M18 88h28"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />
        </svg>
        <p class="mt-5 text-lg font-bold">Even geduld</p>
        <p class="mt-1 max-w-xs text-center">We schenken je winkelmandje over naar de betaalpagina.</p>
      </div>
      <p data-cart-notice hidden class="mt-3 rounded-xl bg-white p-3 text-sm" role="status">
        Online afrekenen lukt nog niet voor een box in je winkelmandje. Bestellen kan intussen via{' '}
        <a class="text-brand underline" href={contact.href}>
          {contact.label}
        </a>
        .
      </p>
    </div>
  </div>
</dialog>

<template id="cart-line-template">
  <li class="flex gap-4 py-4">
    <img data-line-image alt="" width="80" height="80" class="size-20 shrink-0 rounded-xl bg-white object-cover" />
    <div class="flex flex-1 flex-col gap-2">
      <a data-line-name class="font-bold leading-tight hover:underline"></a>
      <span data-line-price class="text-sm"></span>
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-line-dec
          class="flex size-8 items-center justify-center rounded-full border border-ink"
          aria-label="Eén minder"
        >
          −
        </button>
        <span data-line-qty class="w-6 text-center font-bold" aria-live="polite"></span>
        <button
          type="button"
          data-line-inc
          class="flex size-8 items-center justify-center rounded-full border border-ink"
          aria-label="Eén meer"
        >
          +
        </button>
        <button type="button" data-line-remove class="ml-auto text-xs underline">
          Verwijderen
        </button>
      </div>
    </div>
  </li>
</template>

<script>
  import { cart, MAX_QTY, type CartLine } from '@/lib/commerce/cart';
  import { checkoutProvider, createCheckoutUrl } from '@/lib/commerce/checkout';
  import { WOO_API_PROXY, WOO_URL, parseStoreProducts, storeProductsPath } from '@/lib/commerce/woo';
  import { analyticsIds, track } from '@/lib/analytics';
  import { SITE, formatPrice } from '@/lib/site';
  import { renderPrice } from '@/lib/commerce/price';

  const dialog = document.getElementById('cart-drawer') as HTMLDialogElement;
  const $ = <T extends HTMLElement>(sel: string, root: ParentNode = dialog) => root.querySelector<T>(sel)!;
  const linesEl = $('[data-cart-lines]');
  const template = document.getElementById('cart-line-template') as HTMLTemplateElement;

  // The box the cart offers next to the one already in it (/cart-upsell.json, loaded when the cart opens).
  interface Upsell extends Omit<CartLine, 'quantity'> {
    colour: 'Wit' | 'Rood';
    product: string;
    duel: string;
    buyable?: boolean;
  }
  const upsellEl = dialog.querySelector<HTMLElement>('[data-cart-upsell]');
  const upsellButton = {
    Wit: 'bg-wine-white text-ink hover:bg-wine-white-dark',
    Rood: 'bg-brand text-white hover:bg-brand-dark',
  };
  let upsells: Upsell[] = [];

  // With one box in the cart: offer the box of the other colour, which makes shipping free.
  function renderUpsell(lines: CartLine[], count: number) {
    if (!upsellEl) return;
    const inCart = new Set(lines.map((l) => l.handle.split(':')[0]));
    const offer =
      count > 0 && count < SITE.shipping.freeFromBoxes
        ? upsells.find((u) => !inCart.has(u.product) && u.buyable !== false)
        : undefined;
    upsellEl.hidden = !offer;
    if (!offer) {
      upsellEl.replaceChildren();
      return;
    }
    const img = document.createElement('img');
    img.src = offer.image;
    img.alt = '';
    img.width = 64;
    img.height = 64;
    img.className = 'size-16 shrink-0 rounded-lg object-cover';
    const title = document.createElement('p');
    title.className = 'font-bold leading-tight';
    title.textContent = `Neem er ${offer.colour === 'Wit' ? 'wit' : 'rood'} bij: verzending gratis`;
    const price = document.createElement('span');
    renderPrice(price, offer.price, offer.regularPrice);
    const detail = document.createElement('p');
    detail.className = 'mt-1 text-sm';
    detail.append(`${offer.duel}, `, price, `. Je spaart ${formatPrice(SITE.shipping.rate)}.`);
    const text = document.createElement('div');
    text.className = 'min-w-0 flex-1';
    text.append(title, detail);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = `btn min-h-10 shrink-0 px-4 py-2 text-sm ${upsellButton[offer.colour]}`;
    button.textContent = 'Voeg toe';
    button.addEventListener('click', () => addLine(offer));
    const card = document.createElement('div');
    card.className = 'flex items-center gap-3 rounded-xl bg-white p-3';
    card.append(img, text, button);
    upsellEl.replaceChildren(card);
  }

  function render(lines: CartLine[]) {
    const count = lines.reduce((n, l) => n + l.quantity, 0);
    for (const badge of document.querySelectorAll<HTMLElement>('[data-cart-count]')) {
      badge.hidden = count === 0;
      badge.textContent = String(count);
    }
    for (const btn of document.querySelectorAll<HTMLElement>('[data-cart-open]')) {
      btn.setAttribute(
        'aria-label',
        count ? `Winkelmandje openen, ${count} ${count === 1 ? 'box' : 'boxen'}` : 'Winkelmandje openen',
      );
    }

    $('[data-cart-empty]').hidden = count > 0;
    $('[data-cart-footer]').hidden = count === 0;
    linesEl.hidden = count === 0;
    const toGo = SITE.shipping.freeFromBoxes - count;
    // At exactly the threshold, say what one box less costs: people with an old box still in the cart tapped
    // "−" and paid shipping (PostHog, 20-25 Nov 2026).
    const oneLess =
      toGo === 0 && count > 1
        ? ` Met ${count - 1} ${count - 1 === 1 ? 'box' : 'boxen'} betaal je ${formatPrice(SITE.shipping.rate)} verzending.`
        : '';
    $('[data-cart-progress]').textContent =
      count === 0 ? '' : toGo > 0 ? `Nog ${toGo} box en je verzending is gratis!` : `Je verzending is gratis!${oneLess}`;
    $('[data-cart-progress]').hidden = count === 0;
    // Shipping: the real amount, or free once the cart reaches the threshold.
    $('[data-cart-shipping]').textContent = toGo > 0 ? formatPrice(SITE.shipping.rate) : 'Gratis';
    $('[data-cart-subtotal]').textContent = formatPrice(lines.reduce((s, l) => s + l.price * l.quantity, 0));
    renderUpsell(lines, count);
    if (count > 0) renderTrust();

    linesEl.replaceChildren(
      ...lines.map((line) => {
        const node = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const img = $<HTMLImageElement>('[data-line-image]', node);
        img.src = line.image;
        const name = $<HTMLAnchorElement>('[data-line-name]', node);
        name.href = line.url;
        name.textContent = line.name;
        renderPrice($('[data-line-price]', node), line.price, line.regularPrice);
        $('[data-line-qty]', node).textContent = String(line.quantity);
        $('[data-line-dec]', node).addEventListener('click', () => cart.setQuantity(line.handle, line.quantity - 1));
        const inc = $<HTMLButtonElement>('[data-line-inc]', node);
        inc.disabled = line.quantity >= MAX_QTY;
        inc.addEventListener('click', () => cart.setQuantity(line.handle, line.quantity + 1));
        $('[data-line-remove]', node).addEventListener('click', () => cart.setQuantity(line.handle, 0));
        return node;
      }),
    );
  }

  // Analytics properties for the whole cart (no personal data).
  const cartProperties = (lines: CartLine[]) => ({
    value: lines.reduce((s, l) => s + l.price * l.quantity, 0),
    currency: 'EUR',
    boxes: lines.reduce((n, l) => n + l.quantity, 0),
    items: lines.map((l) => ({ id: l.handle, name: l.name, price: l.price, quantity: l.quantity })),
  });

  // The checkout lives on another host: connect to it as soon as the cart opens, so the hand-over is faster.
  let preconnected = false;
  const preconnect = () => {
    if (preconnected || !WOO_URL) return;
    preconnected = true;
    const link = document.createElement('link');
    link.rel = 'preconnect';
    link.href = WOO_URL;
    document.head.append(link);
  };

  // Live prices for the lines in the cart, at most once per page view. A line keeps the price of the moment it
  // was added, so after a price change a returning visitor would see another price here than at checkout.
  // Runs when a page loads with a filled cart (the drawer then usually opens with the right price) and when the
  // cart opens. Same proxy as the product pages; a failed request changes nothing.
  let repriced = false;
  const reprice = () => {
    const ids = [...new Set(cart.lines().flatMap((l) => (l.wooId ? [l.wooId] : [])))];
    if (repriced || ids.length === 0) return;
    repriced = true;
    fetch(`${WOO_API_PROXY}${storeProductsPath(ids)}`)
      .then((res) => (res.ok ? res.json() : []))
      .then((json: unknown) => cart.reprice(parseStoreProducts(json)))
      .catch(() => {});
  };

  // The two Standaard boxes (/cart-upsell.json, built with the WooCommerce prices of the last build). Fetched
  // once per page view, early on pages where a box can be added, so the offer and the duo button need no wait.
  let upsellFile: Promise<Upsell[]> | undefined;
  const upsellItems = () =>
    (upsellFile ??= fetch('/cart-upsell.json')
      .then((res) => (res.ok ? res.json() : []))
      .catch(() => []));

  // The offer for the cart. It shows at once with the prices of the build: waiting for WordPress took 3 to 5
  // seconds, and most buyers tap "Afrekenen" within 5 seconds of adding a box (PostHog, 20-25 Nov 2026).
  // Live price and stock follow in the background, so the cart never keeps a sold-out box or an old price.
  // A failed request just means no offer, or the build prices.
  let upsellsRequested = false;
  const loadUpsells = () => {
    if (upsellsRequested || !upsellEl) return;
    upsellsRequested = true;
    upsellItems()
      .then(async (items: Upsell[]) => {
        upsells = items;
        render(cart.lines());
        const ids = items.flatMap((u) => (u.wooId ? [u.wooId] : []));
        const res = ids.length > 0 ? await fetch(`${WOO_API_PROXY}${storeProductsPath(ids)}`) : undefined;
        const stock = parseStoreProducts(res?.ok ? await res.json() : []);
        for (const item of items) {
          const live = item.wooId ? stock.get(item.wooId) : undefined;
          if (!live) continue;
          item.price = live.price;
          item.regularPrice = live.regularPrice;
          item.buyable = live.buyable;
        }
        render(cart.lines());
      })
      .catch(() => {});
  };

  // Rating, guarantee, delivery time and payment logos under "Afrekenen", once.
  const trustEl = $('[data-cart-trust]');
  function renderTrust() {
    if (trustEl.childElementCount > 0) return;
    const score = String(SITE.rating.value).replace('.', ',');
    const rating = document.createElement('p');
    const stars = document.createElement('span');
    stars.className = 'text-star';
    stars.setAttribute('aria-hidden', 'true');
    stars.textContent = '★★★★★';
    const bold = document.createElement('strong');
    bold.textContent = `${score}/5`;
    rating.append(stars, ' ', bold, ` op ${SITE.rating.source}`);
    const promise = document.createElement('p');
    promise.className = 'mt-1';
    promise.textContent = `${SITE.guarantee} Levering in ${SITE.shipping.minDays} à ${SITE.shipping.maxDays} werkdagen.`;
    const logos = document.createElement('ul');
    logos.className = 'payments mt-2 flex flex-wrap items-center gap-1.5';
    logos.setAttribute('aria-label', 'Betaalmethodes');
    for (const [file, label] of [
      ['bancontact', 'Bancontact'],
      ['ideal', 'iDEAL'],
      ['applepay', 'Apple Pay'],
      ['visa', 'Visa'],
      ['mastercard', 'Mastercard'],
      ['paypal', 'PayPal'],
      ['klarna', 'Klarna'],
    ]) {
      const img = document.createElement('img');
      img.src = `/images/payments/${file}.svg`;
      img.alt = label!;
      img.width = 32;
      img.height = 24;
      img.decoding = 'async';
      const li = document.createElement('li');
      li.append(img);
      logos.append(li);
    }
    trustEl.replaceChildren(rating, promise, logos);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-cart-open]')) {
      preconnect();
      reprice();
      loadUpsells();
      dialog.showModal();
      track('cart_viewed', cartProperties(cart.lines()));
    }
    if (target.closest('[data-cart-close]') || target === dialog) dialog.close();
  });

  // Puts a box in the cart and opens the drawer: used by the add-to-cart forms and by the offer in the cart.
  function addLine(line: Omit<CartLine, 'quantity'>, quantity = 1) {
    cart.add(
      {
        handle: line.handle,
        name: line.name,
        price: line.price,
        regularPrice: line.regularPrice,
        image: line.image,
        url: line.url,
        wooId: line.wooId,
      },
      quantity,
    );
    preconnect();
    reprice();
    loadUpsells();
    if (!dialog.open) dialog.showModal();
    track('product_added_to_cart', {
      id: line.handle,
      name: line.name,
      price: line.price,
      ...cartProperties(cart.lines()),
    });
    window.dataLayer?.push({
      event: 'add_to_cart',
      ecommerce: {
        currency: 'EUR',
        value: line.price,
        items: [{ item_id: line.handle, item_name: line.name, price: line.price }],
      },
    });
  }

  // Add-to-cart forms: <form data-add-to-cart> with hidden inputs (see ProductPage.astro).
  document.addEventListener('submit', (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('form[data-add-to-cart]');
    if (!form) return;
    e.preventDefault();
    const data = new FormData(form);
    addLine(
      {
        handle: String(data.get('handle')),
        name: String(data.get('name')),
        price: Number(data.get('price')),
        regularPrice: Number(data.get('regular_price')) || undefined,
        image: String(data.get('image')),
        url: String(data.get('url')),
        wooId: Number(data.get('woo_id')) || undefined,
      },
      Number(data.get('quantity') ?? 1),
    );
  });

  // Duo button (DuoButton.astro): the red and the white Standaard box together, so shipping is free. Adds only
  // the colours not in the cart yet; with both already there it just opens the cart.
  document.addEventListener('click', (e) => {
    const duo = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-add-duo]');
    if (!duo) return;
    duo.disabled = true;
    upsellItems()
      .then((items: Upsell[]) => {
        const inCart = new Set(cart.lines().map((l) => l.handle.split(':')[0]));
        const missing = items.filter((u) => !inCart.has(u.product));
        track('duo_clicked', { page: location.pathname, added: missing.length });
        for (const item of missing) addLine(item);
        if (missing.length === 0 && !dialog.open) dialog.showModal();
      })
      .finally(() => (duo.disabled = false));
  });

  // Fetch the two boxes early where a box can be added or the cart already holds one.
  if (document.querySelector('form[data-add-to-cart], [data-add-duo]') || cart.count() > 0) {
    const early = () => void upsellItems();
    if ('requestIdleCallback' in window) requestIdleCallback(early, { timeout: 3000 });
    else setTimeout(early, 1500);
  }

  const checkoutButton = $<HTMLButtonElement>('[data-cart-checkout]');
  const wait = $('[data-checkout-wait]');
  checkoutButton.addEventListener('click', () => {
    const lines = cart.lines();
    const url = checkoutProvider === 'none' ? null : createCheckoutUrl(lines);
    if (!url) {
      $('[data-cart-notice]').hidden = false;
      return;
    }
    // Waiting screen until the checkout page has loaded; the button cannot be pressed twice.
    checkoutButton.disabled = true;
    wait.hidden = false;
    window.dataLayer?.push({
      event: 'begin_checkout',
      ecommerce: {
        currency: 'EUR',
        value: lines.reduce((s, l) => s + l.price * l.quantity, 0),
        items: lines.map((l) => ({ item_id: l.handle, item_name: l.name, price: l.price, quantity: l.quantity })),
      },
    });
    track('checkout_started', cartProperties(lines));
    // Hand the anonymous PostHog IDs to WooCommerce, so the paid order joins the same journey.
    const target = new URL(url);
    const ids = analyticsIds();
    if (ids) {
      target.searchParams.set('ph_id', ids.distinctId);
      if (ids.sessionId) target.searchParams.set('ph_sid', ids.sessionId);
    }
    window.location.href = target.toString();
  });

  // Back from the checkout with the page restored from the cache: hide the waiting screen again.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    wait.hidden = true;
    checkoutButton.disabled = false;
  });

  cart.subscribe(render);
  render(cart.lines());
  reprice();
</script>

<!-- Global on purpose: a scoped style adds a data attribute to every element of the drawer, on every page
     (about 1 KB of HTML). The selectors below only match the drawer. -->
<style is:global>
  #cart-drawer[open] {
    animation: slide-in 0.25s ease-out;
  }
  .checkout-wait {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: var(--color-cream);
  }
  .checkout-wait[hidden] {
    display: none;
  }
  .checkout-glass {
    width: 4rem;
    height: 6rem;
    color: var(--color-ink);
  }
  /* The wine rises in the glass, over and over, until the checkout page takes over. */
  .checkout-wine {
    fill: var(--color-brand);
    transform-origin: 32px 56px;
    animation: pour 2.4s ease-in-out infinite;
  }
  @keyframes pour {
    0% {
      transform: translateY(56px);
    }
    70%,
    100% {
      transform: translateY(14px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .checkout-wine {
      animation: none;
      transform: translateY(14px);
    }
  }
  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
  }
</style>
