---
import { SITE, shippingLine } from '@/lib/site';

// Fallback when online checkout is unavailable. Without an e-mail address the link would be empty,
// so we point to the contact page instead.
const contact = SITE.email
  ? { href: `mailto:${SITE.email}`, label: SITE.email }
  : { href: '/contact/', label: 'het contactformulier' };
---

<dialog
  id="cart-drawer"
  aria-labelledby="cart-title"
  class="fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-dvh w-full max-w-md bg-cream p-0 shadow-2xl backdrop:bg-ink/50"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between border-b border-line px-5 py-4">
      <p id="cart-title" class="font-display text-2xl">
        Je winkelmandje
      </p>
      <button
        type="button"
        data-cart-close
        class="flex size-10 items-center justify-center rounded-full hover:bg-blush"
        aria-label="Winkelmandje sluiten"
      >
        <svg class="size-5" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <p data-cart-progress class="bg-blush px-5 py-3 text-sm font-bold" aria-live="polite"></p>

    <ul data-cart-lines class="flex-1 divide-y divide-line overflow-y-auto px-5"></ul>

    <div data-cart-empty hidden class="flex flex-1 flex-col items-center justify-center gap-4 px-5 text-center">
      <p class="font-display text-xl">Je winkelmandje is nog leeg.</p>
      <a href="/shop/" class="btn-primary">
        Ontdek de boxen
      </a>
    </div>

    <div data-cart-footer class="border-t border-line px-5 py-5">
      <div class="flex items-center justify-between text-lg font-bold">
        <span>Subtotaal</span>
        <span data-cart-subtotal></span>
      </div>
      <p class="mt-1 text-xs text-muted">Inclusief btw.</p>
      <p class="mt-2 text-sm" data-cart-shipping>
        {shippingLine()}
      </p>
      <button type="button" data-cart-checkout class="btn-primary mt-4 w-full">
        Afrekenen
      </button>
      <!-- Shown from the click on 'Afrekenen' until the WooCommerce checkout has loaded (that takes seconds). -->
      <div data-checkout-wait hidden class="checkout-wait" role="status" aria-live="polite">
        <svg class="checkout-glass" viewBox="0 0 64 96" aria-hidden="true">
          <defs>
            <clipPath id="checkout-bowl">
              <path d="M12 4h40v26c0 14-8 24-20 26C20 54 12 44 12 30z" />
            </clipPath>
          </defs>
          <rect class="checkout-wine" x="0" y="0" width="64" height="60" clip-path="url(#checkout-bowl)" />
          <path
            d="M12 4h40v26c0 14-8 24-20 26C20 54 12 44 12 30zM32 56v30M18 88h28"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />
        </svg>
        <p class="mt-5 text-lg font-bold">Even geduld</p>
        <p class="mt-1 max-w-xs text-center">We schenken je winkelmandje over naar de betaalpagina.</p>
      </div>
      <p data-cart-notice hidden class="mt-3 rounded-xl bg-white p-3 text-sm" role="status">
        Online afrekenen lukt nog niet voor een box in je winkelmandje. Bestellen kan intussen via{' '}
        <a class="text-brand underline" href={contact.href}>
          {contact.label}
        </a>
        .
      </p>
    </div>
  </div>
</dialog>

<template id="cart-line-template">
  <li class="flex gap-4 py-4">
    <img data-line-image alt="" width="80" height="80" class="size-20 shrink-0 rounded-xl bg-white object-cover" />
    <div class="flex flex-1 flex-col gap-2">
      <a data-line-name class="font-bold leading-tight hover:underline"></a>
      <span data-line-price class="text-sm"></span>
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-line-dec
          class="flex size-8 items-center justify-center rounded-full border border-ink"
          aria-label="Eén minder"
        >
          −
        </button>
        <span data-line-qty class="w-6 text-center font-bold" aria-live="polite"></span>
        <button
          type="button"
          data-line-inc
          class="flex size-8 items-center justify-center rounded-full border border-ink"
          aria-label="Eén meer"
        >
          +
        </button>
        <button type="button" data-line-remove class="ml-auto text-xs underline">
          Verwijderen
        </button>
      </div>
    </div>
  </li>
</template>

<script>
  import { cart, MAX_QTY, type CartLine } from '@/lib/commerce/cart';
  import { checkoutProvider, createCheckoutUrl } from '@/lib/commerce/checkout';
  import { WOO_URL } from '@/lib/commerce/woo';
  import { analyticsIds, track } from '@/lib/analytics';
  import { SITE, formatPrice, shippingLine } from '@/lib/site';

  const dialog = document.getElementById('cart-drawer') as HTMLDialogElement;
  const $ = <T extends HTMLElement>(sel: string, root: ParentNode = dialog) => root.querySelector<T>(sel)!;
  const linesEl = $('[data-cart-lines]');
  const template = document.getElementById('cart-line-template') as HTMLTemplateElement;

  function render(lines: CartLine[]) {
    const count = lines.reduce((n, l) => n + l.quantity, 0);
    for (const badge of document.querySelectorAll<HTMLElement>('[data-cart-count]')) {
      badge.hidden = count === 0;
      badge.textContent = String(count);
    }
    for (const btn of document.querySelectorAll<HTMLElement>('[data-cart-open]')) {
      btn.setAttribute(
        'aria-label',
        count ? `Winkelmandje openen, ${count} ${count === 1 ? 'box' : 'boxen'}` : 'Winkelmandje openen',
      );
    }

    $('[data-cart-empty]').hidden = count > 0;
    $('[data-cart-footer]').hidden = count === 0;
    linesEl.hidden = count === 0;
    const toGo = SITE.shipping.freeFromBoxes - count;
    $('[data-cart-progress]').textContent =
      count === 0 ? '' : toGo > 0 ? `Nog ${toGo} box en je verzending is gratis!` : 'Je verzending is gratis!';
    $('[data-cart-progress]').hidden = count === 0;
    // Shipping: the real amount, or free once the cart reaches the threshold.
    $('[data-cart-shipping]').textContent = toGo > 0 ? shippingLine() : 'Gratis verzending';
    $('[data-cart-subtotal]').textContent = formatPrice(lines.reduce((s, l) => s + l.price * l.quantity, 0));

    linesEl.replaceChildren(
      ...lines.map((line) => {
        const node = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const img = $<HTMLImageElement>('[data-line-image]', node);
        img.src = line.image;
        const name = $<HTMLAnchorElement>('[data-line-name]', node);
        name.href = line.url;
        name.textContent = line.name;
        $('[data-line-price]', node).textContent = formatPrice(line.price);
        $('[data-line-qty]', node).textContent = String(line.quantity);
        $('[data-line-dec]', node).addEventListener('click', () => cart.setQuantity(line.handle, line.quantity - 1));
        const inc = $<HTMLButtonElement>('[data-line-inc]', node);
        inc.disabled = line.quantity >= MAX_QTY;
        inc.addEventListener('click', () => cart.setQuantity(line.handle, line.quantity + 1));
        $('[data-line-remove]', node).addEventListener('click', () => cart.setQuantity(line.handle, 0));
        return node;
      }),
    );
  }

  // Analytics properties for the whole cart (no personal data).
  const cartProperties = (lines: CartLine[]) => ({
    value: lines.reduce((s, l) => s + l.price * l.quantity, 0),
    currency: 'EUR',
    boxes: lines.reduce((n, l) => n + l.quantity, 0),
    items: lines.map((l) => ({ id: l.handle, name: l.name, price: l.price, quantity: l.quantity })),
  });

  // The checkout lives on another host: connect to it as soon as the cart opens, so the hand-over is faster.
  let preconnected = false;
  const preconnect = () => {
    if (preconnected || !WOO_URL) return;
    preconnected = true;
    const link = document.createElement('link');
    link.rel = 'preconnect';
    link.href = WOO_URL;
    document.head.append(link);
  };

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-cart-open]')) {
      preconnect();
      dialog.showModal();
      track('cart_viewed', cartProperties(cart.lines()));
    }
    if (target.closest('[data-cart-close]') || target === dialog) dialog.close();
  });

  // Add-to-cart forms: <form data-add-to-cart> with hidden inputs (see ProductPage.astro).
  document.addEventListener('submit', (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('form[data-add-to-cart]');
    if (!form) return;
    e.preventDefault();
    const data = new FormData(form);
    cart.add(
      {
        handle: String(data.get('handle')),
        name: String(data.get('name')),
        price: Number(data.get('price')),
        image: String(data.get('image')),
        url: String(data.get('url')),
        wooId: Number(data.get('woo_id')) || undefined,
      },
      Number(data.get('quantity') ?? 1),
    );
    preconnect();
    dialog.showModal();
    track('product_added_to_cart', {
      id: String(data.get('handle')),
      name: String(data.get('name')),
      price: Number(data.get('price')),
      ...cartProperties(cart.lines()),
    });
    window.dataLayer?.push({
      event: 'add_to_cart',
      ecommerce: {
        currency: 'EUR',
        value: Number(data.get('price')),
        items: [{ item_id: data.get('handle'), item_name: data.get('name'), price: Number(data.get('price')) }],
      },
    });
  });

  const checkoutButton = $<HTMLButtonElement>('[data-cart-checkout]');
  const wait = $('[data-checkout-wait]');
  checkoutButton.addEventListener('click', () => {
    const lines = cart.lines();
    const url = checkoutProvider === 'none' ? null : createCheckoutUrl(lines);
    if (!url) {
      $('[data-cart-notice]').hidden = false;
      return;
    }
    // Waiting screen until the checkout page has loaded; the button cannot be pressed twice.
    checkoutButton.disabled = true;
    wait.hidden = false;
    window.dataLayer?.push({
      event: 'begin_checkout',
      ecommerce: {
        currency: 'EUR',
        value: lines.reduce((s, l) => s + l.price * l.quantity, 0),
        items: lines.map((l) => ({ item_id: l.handle, item_name: l.name, price: l.price, quantity: l.quantity })),
      },
    });
    track('checkout_started', cartProperties(lines));
    // Hand the anonymous PostHog IDs to WooCommerce, so the paid order joins the same journey.
    const target = new URL(url);
    const ids = analyticsIds();
    if (ids) {
      target.searchParams.set('ph_id', ids.distinctId);
      if (ids.sessionId) target.searchParams.set('ph_sid', ids.sessionId);
    }
    window.location.href = target.toString();
  });

  // Back from the checkout with the page restored from the cache: hide the waiting screen again.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    wait.hidden = true;
    checkoutButton.disabled = false;
  });

  cart.subscribe(render);
  render(cart.lines());
</script>

<style>
  dialog[open] {
    animation: slide-in 0.25s ease-out;
  }
  .checkout-wait {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: var(--color-cream);
  }
  .checkout-wait[hidden] {
    display: none;
  }
  .checkout-glass {
    width: 4rem;
    height: 6rem;
    color: var(--color-ink);
  }
  /* The wine rises in the glass, over and over, until the checkout page takes over. */
  .checkout-wine {
    fill: var(--color-brand);
    transform-origin: 32px 56px;
    animation: pour 2.4s ease-in-out infinite;
  }
  @keyframes pour {
    0% {
      transform: translateY(56px);
    }
    70%,
    100% {
      transform: translateY(14px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .checkout-wine {
      animation: none;
      transform: translateY(14px);
    }
  }
  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
  }
</style>
