---
// The first choice is the colour only: two cards side by side, also on mobile (design artboard
// "5A · Wit of rood: naast elkaar"). The duel is introduced on the product page.
// In this choice the colour follows the wine (docs/design-richtlijnen.md): light blue for white, red for red.
import { Image } from 'astro:assets';
import { clearanceProducts, colourChoices, fromPrice, productPath, type Product } from '@/lib/content';
import { formatPrice } from '@/lib/site';
import { COLOUR_STYLES } from '@/lib/colour-choice';

interface Props {
  /** All products; the cards pick the box per colour that is for sale now. */
  products: Product[];
  heading?: string;
  eager?: boolean;
  class?: string;
}

const { products, heading = 'Kies je box', eager = false, class: className } = Astro.props;

const choices = colourChoices(products).map((choice) => ({ ...choice, style: COLOUR_STYLES[choice.label] }));
// Leftover stock gets its own line, unless a card already leads to it.
const clearance = clearanceProducts(products).filter((p) => !choices.some((c) => c.product.id === p.id));
---

<div class:list={['max-w-3xl', className]}>
  <h2 id="boxen-title" class="h2 text-center">
    {heading}
  </h2>
  <p class="mt-2 text-center">
    Een wijnproeverij voor één avond: het spel en twee heerlijke, blinde wijnen (2 × 75 cl).
  </p>
  <ul class="mt-6 grid grid-cols-2 gap-3">
    {choices.map(({ product, style }) => {
      return (
        <li>
          <a href={productPath(product.id)} class="choice-card">
            <Image
              src={style.image}
              alt={style.alt}
              width={480}
              height={480}
              widths={[240, 360, 720]}
              sizes="(min-width: 768px) 23rem, 45vw"
              class="aspect-square w-full object-cover"
              loading={eager ? 'eager' : 'lazy'}
            />
            <div class="flex flex-1 flex-col px-3 py-3.5 text-center">
              <h3 class="text-[1.5rem] leading-none">{style.title}</h3>
              <p class:list={['mt-2 text-[0.8125rem] leading-[1.35] italic', style.line]}>
                {product.data.choiceLine ?? `${product.data.duel}: proef jij het verschil?`}
              </p>
              <p class="mt-2.5 mb-3.5 text-[0.8125rem] text-muted">
                vanaf <strong class="text-base text-ink">{formatPrice(fromPrice(product))}</strong>
              </p>
              <p class:list={['choice-button', style.button]}>{style.cta}</p>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
  {clearance.map((product) => (
    <p class="mt-4 text-center text-sm">
      Nu te koop, zolang de voorraad strekt:{' '}
      <a href={productPath(product.id)} class="font-bold underline">
        {product.data.name}
      </a>
    </p>
  ))}
  <!-- "Niet lekker?" is the wording for this spot only; the guarantee elsewhere is SITE.guarantee. -->
  <p class="mt-6 text-center text-sm text-muted">
    Goede, eerlijke wijnen, door ons geselecteerd.
    <br />
    Niet lekker? Je krijgt je geld terug.
  </p>
</div>
