---
import { Image } from 'astro:assets';
import type { Product } from '@/lib/content';
import { isAvailable, productPath } from '@/lib/content';
import { formatPrice } from '@/lib/site';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { product, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const { data } = product;
const url = productPath(product.id);
const soldOut = !isAvailable(product);
const cover = data.images[0]!;
// One line per formula, so you see the price and the stock of both before you click.
const options = data.variants.map((v) => ({ formula: v.formula, price: v.price, available: v.available }));
---

<article class="card-link group p-4">
  <div class="relative aspect-square overflow-hidden rounded-xl bg-cream">
    <Image
      src={cover.src}
      alt={cover.alt}
      width={480}
      height={480}
      widths={[360, 720]}
      sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 90vw"
      class="size-full object-cover"
      loading={eager ? 'eager' : 'lazy'}
    />
    <div class="absolute top-2 left-2 flex flex-col items-start gap-1">
      <span class="badge bg-cream text-ink">Met 2 wijnen</span>
      {data.badge && <span class="badge bg-ink text-white">{data.badge}</span>}
      {soldOut && <span class="badge bg-white ring-1 ring-line">Uitverkocht</span>}
    </div>
  </div>
  <div class="mt-4 flex flex-1 flex-col">
    <Heading class="font-display text-xl text-brand">
      <a href={url} class="after:absolute after:inset-0">
        {data.name}
      </a>
    </Heading>
    <p class="mt-2 text-sm text-muted italic">{data.cardTagline}</p>
    <dl class="mt-3 space-y-1 text-sm">
      {options.map((o) => (
        <div class="flex items-baseline justify-between gap-2">
          <dt class="font-bold">{o.formula}</dt>
          <dd class:list={[o.available ? 'font-bold' : 'text-muted']}>
            {o.available ? formatPrice(o.price) : 'Tijdelijk uitverkocht'}
          </dd>
        </div>
      ))}
    </dl>
    <div class="mt-auto pt-4">
      <span
        class:list={[
          'btn relative w-full min-h-10 py-2',
          soldOut ? 'bg-line text-muted' : 'bg-brand text-white group-hover:bg-brand-dark',
        ]}
        aria-hidden="true"
      >
        Bekijk de box
      </span>
    </div>
  </div>
</article>
