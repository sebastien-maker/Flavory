---
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Stars from '@/components/ui/Stars.astro';
import Faq from '@/components/ui/Faq.astro';
import PaymentIcons from './PaymentIcons.astro';
import ProductCard from './ProductCard.astro';
import PostCard from '@/components/blog/PostCard.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Reviews from '@/components/sections/Reviews.astro';
import {
  availableVariants,
  fromPrice,
  getProducts,
  getReviews,
  productPath,
  categoryPath,
  resolvePosts,
  type Product,
} from '@/lib/content';
import { FORMULAS, SITE, absoluteUrl, formatPrice } from '@/lib/site';
import { breadcrumbs, faqPage, product as productSchema, webPage } from '@/components/seo/schema';
import stillImage from '@/assets/images/site/rode-box-still.jpeg';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { data } = product;
const path = productPath(product.id);
const category = await getEntry(data.category);
// Sold-out options are left out completely (not shown as disabled).
const variants = availableVariants(product);
const available = variants.length > 0;
const minPrice = fromPrice(product);
const formulas = [...new Set(variants.map((v) => v.formula))];
const optionLabel = (v: (typeof variants)[number]) => `${v.duel} · ${v.formula} · ${formatPrice(v.price)}`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Shop', path: '/shop/' },
  ...(category ? [{ name: category.data.name, path: categoryPath(category.id) }] : []),
  { name: data.name, path },
];

// Images: first one is the LCP element.
const gallery = await Promise.all(
  data.images.map(async (img) => ({
    alt: img.alt,
    main: await getImage({
      src: img.src,
      width: 720,
      height: 720,
      fit: 'cover',
      widths: [480, 960],
      format: 'webp',
    }),
    thumb: await getImage({ src: img.src, width: 96, height: 96, fit: 'cover', format: 'webp' }),
  })),
);
const gallerySizes = '(min-width: 1024px) 36rem, (min-width: 768px) 50vw, 100vw';
const cover = gallery[0]!;

const descriptions = data.descriptions.map((d) => ({ ...d, html: marked.parse(d.text, { async: false }) }));
const others = (await getProducts()).filter((p) => p.id !== product.id);
const relatedPosts = await resolvePosts(data.relatedPosts);
const reviews = (await getReviews()).map((r) => r.data);

const schemaImages = await Promise.all(
  data.images
    .slice(0, 3)
    .map(async (img) => absoluteUrl((await getImage({ src: img.src, width: 1200, format: 'jpg' })).src)),
);
---

<BaseLayout
  title={data.seoTitle}
  description={data.seoDescription}
  path={path}
  type="product"
  image={data.images[0]!.src}
  imageAlt={cover.alt}
  preloadImage={{ src: cover.main.src, srcset: cover.main.srcSet.attribute, sizes: gallerySizes }}
  schema={[
    webPage({ path, title: data.h1, description: data.seoDescription, type: 'ItemPage' }),
    productSchema({
      path,
      name: data.name,
      description: data.definition,
      offers: data.variants.map((v) => ({
        name: `${v.duel} · ${v.formula}`,
        sku: v.sku,
        price: v.price,
        available: v.available,
      })),
      images: schemaImages,
      category: category?.data.name ?? 'Wijnspel',
      reviews,
    }),
    breadcrumbs(crumbs),
    faqPage(path, data.faq),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="container-site grid gap-6 py-4 md:grid-cols-2 md:gap-8 md:py-10 lg:gap-12">
    <!-- Gallery: CSS scroll-snap; thumbnails on larger screens, swipe on mobile -->
    <div class="min-w-0" data-gallery>
      <ul
        class="flex snap-x snap-mandatory overflow-x-auto rounded-[var(--radius-card)] bg-white [scrollbar-width:none]"
        data-gallery-track
        aria-label="Productfoto's"
      >
        {gallery.map((img, i) => (
          <li class="w-full shrink-0 snap-center" id={`foto-${i + 1}`}>
            <img
              src={img.main.src}
              srcset={img.main.srcSet.attribute}
              sizes={gallerySizes}
              width="720"
              height="720"
              alt={img.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
              class="aspect-square w-full object-cover"
            />
          </li>
        ))}
      </ul>
      {gallery.length > 1 && (
        <p class="mt-2 text-center text-xs text-muted md:hidden" aria-hidden="true">
          Swipe voor {gallery.length - 1} foto's meer
        </p>
      )}
      {gallery.length > 1 && (
        <ul class="mt-3 hidden gap-2 overflow-x-auto pb-1 md:flex" aria-label="Kies een foto">
          {gallery.map((img, i) => (
            <li class="shrink-0">
              <a href={`#foto-${i + 1}`} data-gallery-thumb={i} class="thumb" aria-current={i === 0 ? 'true' : 'false'}>
                <img
                  src={img.thumb.src}
                  width="64"
                  height="64"
                  alt={`Foto ${i + 1}`}
                  loading="lazy"
                  decoding="async"
                  class="size-16 object-cover"
                />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Buy box: name, option list, price and button come first (mobile first) -->
    <div>
      <h1 class="h3 text-brand">{data.h1}</h1>
      <a href="#reviews-title" class="mt-1 inline-flex items-center gap-2 text-sm hover:underline">
        <Stars rating={SITE.rating.value} />
        <span>
          {String(SITE.rating.value).replace('.', ',')}/5 · {SITE.rating.count} reviews
        </span>
      </a>

      <form data-add-to-cart data-variant-form id="bestellen" class="mt-4 scroll-mt-28" method="post" action="#">
        <input type="hidden" name="handle" value="" />
        <input type="hidden" name="name" value="" />
        <input type="hidden" name="price" value="" />
        <input type="hidden" name="image" value={cover.thumb.src} />
        <input type="hidden" name="url" value={path} />
        <input type="hidden" name="quantity" value="1" />

        <label for="variant" class="block text-sm font-bold">
          Kies je box
        </label>
        <select
          id="variant"
          required
          disabled={!available}
          class="mt-1 block min-h-12 w-full rounded-xl border-2 border-ink bg-white px-3 text-base"
          aria-describedby="variant-help"
        >
          <option value="" selected disabled>
            Maak een keuze
          </option>
          {variants.map((v) => (
            <option
              value={v.id}
              data-handle={`${product.id}:${v.id}`}
              data-name={`${data.name} (${v.duel} · ${v.formula})`}
              data-price={v.price}
              data-group={v.group}
            >
              {optionLabel(v)}
            </option>
          ))}
        </select>
        <dl id="variant-help" class="mt-2 space-y-0.5 text-sm">
          {formulas.map((f) => (
            <div class="flex gap-1">
              <dt class="font-bold">{f}:</dt>
              <dd class="text-muted">{FORMULAS[f]}</dd>
            </div>
          ))}
        </dl>

        <p class="mt-3 text-3xl font-bold" data-price-display aria-live="polite">
          {available ? `vanaf ${formatPrice(minPrice)}` : 'Tijdelijk uitverkocht'}
        </p>
        <p class="mt-1 text-sm text-muted">Inclusief btw en twee flessen wijn</p>

        <button type="submit" class="btn-primary mt-4 w-full" data-buy-button disabled>
          {available ? 'Kies eerst je box' : 'Tijdelijk uitverkocht'}
        </button>
        <p class="mt-2 text-center text-xs">{SITE.ageNotice}</p>
      </form>

      <p class="mt-4 text-center text-sm">Voor 12u besteld, vandaag verzonden</p>
      <PaymentIcons class="mt-3 justify-center" />

      <p class="mt-6 border-l-4 border-brand pl-4">{data.definition}</p>

      <ul class="mt-5 space-y-2">
        {data.usps.map((usp) => (
          <li class="flex gap-2">
            <svg class="check" viewBox="0 0 20 20" aria-hidden="true">
              <path
                d="M4 10.5l4 4 8-9"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{usp}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Sticky buy bar on mobile: shows the chosen price; before a choice it jumps to the option list -->
  {available && (
    <div
      class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-cream/95 p-3 backdrop-blur md:hidden"
      data-sticky-buy
      hidden
    >
      <div class="flex items-center gap-3">
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-bold" data-sticky-label>
            {data.name}
          </p>
          <p class="text-sm" data-sticky-price>
            vanaf {formatPrice(minPrice)}
          </p>
        </div>
        <button type="button" class="btn-primary min-h-11 py-2" data-sticky-button>
          In winkelmandje
        </button>
      </div>
    </div>
  )}

  <!-- Details -->
  <section class="section-y bg-white" aria-labelledby="over-title">
    <div class="container-site grid items-start gap-8 md:grid-cols-2">
      <div>
        <h2 id="over-title" class="h3">
          Over dit wijnspel
        </h2>
        {descriptions.map((d, i) => (
          <div data-description={d.group} hidden={i !== 0}>
            {descriptions.length > 1 && <h3 class="h4 mt-4">{d.heading}</h3>}
            <div class="prose-flavory mt-3" set:html={d.html} />
          </div>
        ))}
        {data.highlights.length > 0 && (
          <ul class="mt-6 space-y-3">
            {data.highlights.map((h) => (
              <li class="flex gap-3">
                <span class="mt-2 size-2 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                <span>
                  <strong>{h.title}</strong> {h.text}
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>
      <div class="space-y-6">
        <div class="card p-6">
          <h2 class="h4">Wat zit er in de box?</h2>
          <ul class="mt-3 list-disc space-y-1 pl-5">
            {data.boxContents.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <video
          class="aspect-video w-full rounded-[var(--radius-card)] object-cover"
          width="1280"
          height="720"
          controls
          muted
          playsinline
          preload="none"
          poster={(await getImage({ src: stillImage, width: 960, format: 'webp' })).src}
          aria-label="Sfeervideo: vrienden spelen Flavory"
        >
          <source src="/media/flavory-sfeer.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <HowItWorks heading="Zo speel je Flavory" />

  <section class="section-y bg-white" aria-labelledby="faq-title">
    <div class="container-site">
      <h2 id="faq-title" class="h3">
        Veelgestelde vragen over deze box
      </h2>
      <div class="mt-4">
        <Faq items={data.faq} />
      </div>
      <p class="mt-4 text-sm">
        Nog een vraag? Bekijk alle{' '}
        <a href="/faq/" class="text-brand underline">
          veelgestelde vragen
        </a>{' '}
        of lees{' '}
        <a href="/verzending-en-retour/" class="text-brand underline">
          verzending en retour
        </a>
        .
      </p>
    </div>
  </section>

  <Reviews />

  {others.length > 0 && (
    <section class="section-y container-site" aria-labelledby="andere-title">
      <h2 id="andere-title" class="h3">
        Ontdek ook
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {others.map((p) => (
          <li>
            <ProductCard product={p} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="section-y bg-white" aria-labelledby="lees-title">
      <div class="container-site">
        <h2 id="lees-title" class="h3">
          Lees meer voor je begint
        </h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-3">
          {relatedPosts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { formatPrice } from '@/lib/site';

  // Gallery thumbnails scroll the track instead of jumping the page.
  const root = document.querySelector<HTMLElement>('[data-gallery]');
  const track = root?.querySelector<HTMLElement>('[data-gallery-track]');
  const thumbs = [...(root?.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]') ?? [])];
  if (track) {
    thumbs.forEach((thumb, i) =>
      thumb.addEventListener('click', (e) => {
        e.preventDefault();
        track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
      }),
    );
    track.addEventListener(
      'scroll',
      () => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        thumbs.forEach((t, i) => t.setAttribute('aria-current', String(i === index)));
      },
      { passive: true },
    );
  }

  // Option list: price, button, formula explanation and description follow the choice.
  const form = document.querySelector<HTMLFormElement>('[data-variant-form]');
  const select = form?.querySelector<HTMLSelectElement>('select');
  const button = form?.querySelector<HTMLButtonElement>('[data-buy-button]');
  const priceDisplay = form?.querySelector<HTMLElement>('[data-price-display]');
  const stickyPrice = document.querySelector<HTMLElement>('[data-sticky-price]');
  const stickyLabel = document.querySelector<HTMLElement>('[data-sticky-label]');
  const stickyButton = document.querySelector<HTMLButtonElement>('[data-sticky-button]');

  const setField = (name: string, value: string) => {
    const input = form?.elements.namedItem(name);
    if (input instanceof HTMLInputElement) input.value = value;
  };

  function applyChoice() {
    if (!form || !select || !button) return;
    const option = select.selectedOptions[0];
    if (!option || !option.value) return;
    const price = Number(option.dataset.price);
    setField('handle', option.dataset.handle ?? '');
    setField('name', option.dataset.name ?? '');
    setField('price', String(price));
    if (priceDisplay) priceDisplay.textContent = formatPrice(price);
    button.disabled = false;
    button.textContent = `In winkelmandje · ${formatPrice(price)}`;
    if (stickyPrice) stickyPrice.textContent = formatPrice(price);
    if (stickyLabel) stickyLabel.textContent = option.textContent?.split(' · ').slice(0, 2).join(' · ') ?? '';
    for (const block of document.querySelectorAll<HTMLElement>('[data-description]')) {
      block.hidden = block.dataset.description !== option.dataset.group;
    }
  }

  select?.addEventListener('change', applyChoice);
  // Browsers may restore a previous choice on back/forward navigation.
  applyChoice();

  stickyButton?.addEventListener('click', () => {
    if (select?.value && form) {
      form.requestSubmit();
    } else {
      form?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      select?.focus({ preventScroll: true });
    }
  });

  // Show the sticky bar once the main button scrolls out of view.
  const bar = document.querySelector<HTMLElement>('[data-sticky-buy]');
  if (bar && button) {
    new IntersectionObserver(([entry]) => {
      bar.hidden = !!entry && (entry.isIntersecting || entry.boundingClientRect.top > 0);
    }).observe(button);
  }
</script>
