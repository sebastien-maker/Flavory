---
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ReviewHighlight from '@/components/ui/ReviewHighlight.astro';
import ShippingCutoff from '@/components/ui/ShippingCutoff.astro';
import Faq from '@/components/ui/Faq.astro';
import PaymentIcons from './PaymentIcons.astro';
import ProductCard from './ProductCard.astro';
import PostCard from '@/components/blog/PostCard.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Reviews from '@/components/sections/Reviews.astro';
import {
  availableVariants,
  fromPrice,
  getProducts,
  getReviews,
  productPath,
  categoryPath,
  resolvePosts,
  type Product,
} from '@/lib/content';
import { FORMULAS, SITE, absoluteUrl, formatPrice, pricePerPerson } from '@/lib/site';
import { breadcrumbs, faqPage, product as productSchema, webPage } from '@/components/seo/schema';
import LazyVideo from '@/components/ui/LazyVideo.astro';
import redPoster from '@/assets/images/site/flavory-avond-rood-poster.jpg';
import whitePoster from '@/assets/images/site/flavory-avond-wit-poster.jpg';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { data } = product;
const path = productPath(product.id);
const category = await getEntry(data.category);
// Sold-out options are left out completely (not shown as disabled).
const variants = availableVariants(product);
const available = variants.length > 0;
const minPrice = fromPrice(product);
// The first option is preselected, so the buy button works straight away.
const initial = variants[0];
// Premium tiles show the extra cost over the Regular box of the same duel.
const upcharge = (v: (typeof variants)[number]) => {
  const regular = variants.find((r) => r.duel === v.duel && r.formula === 'Regular');
  return v.formula !== 'Regular' && regular ? v.price - regular.price : 0;
};
const perPersonLabel = (price: number) => `${pricePerPerson(price, data.playersMax)} per persoon met ${data.playersMax} spelers`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Shop', path: '/shop/' },
  ...(category ? [{ name: category.data.name, path: categoryPath(category.id) }] : []),
  { name: data.name, path },
];

// Images: first one is the LCP element.
const gallery = await Promise.all(
  data.images.map(async (img) => ({
    alt: img.alt,
    main: await getImage({
      src: img.src,
      width: 720,
      height: 720,
      fit: 'cover',
      widths: [480, 960],
      format: 'webp',
    }),
    thumb: await getImage({ src: img.src, width: 96, height: 96, fit: 'cover', format: 'webp' }),
  })),
);
const gallerySizes = '(min-width: 1024px) 36rem, (min-width: 768px) 50vw, 100vw';
const cover = gallery[0]!;
// Mood clip of the matching wine colour, shown as the second slide of the gallery.
const clip =
  data.category.id === 'rode-wijn'
    ? { src: '/media/flavory-avond-rood.mp4', poster: redPoster, label: 'Sfeerbeelden: vrienden spelen Flavory met rode wijn bij het haardvuur' }
    : { src: '/media/flavory-avond-wit.mp4', poster: whitePoster, label: 'Sfeerbeelden: vrienden spelen Flavory met witte wijn en klinken aan tafel' };
const clipThumb = await getImage({ src: clip.poster, width: 96, height: 96, fit: 'cover', format: 'webp' });
const slides = [
  { kind: 'image' as const, label: 'Foto 1', ...cover },
  { kind: 'video' as const, label: 'Filmpje', thumb: clipThumb },
  ...gallery.slice(1).map((img, i) => ({ kind: 'image' as const, label: `Foto ${i + 2}`, ...img })),
];

const descriptions = data.descriptions.map((d) => ({ ...d, html: marked.parse(d.text, { async: false }) }));
const others = (await getProducts()).filter((p) => p.id !== product.id);
const relatedPosts = await resolvePosts(data.relatedPosts);
const reviews = (await getReviews()).map((r) => r.data);

const schemaImages = await Promise.all(
  data.images
    .slice(0, 3)
    .map(async (img) => absoluteUrl((await getImage({ src: img.src, width: 1200, format: 'jpg' })).src)),
);
---

<BaseLayout
  title={data.seoTitle}
  description={data.seoDescription}
  path={path}
  type="product"
  image={data.images[0]!.src}
  imageAlt={cover.alt}
  preloadImage={{ src: cover.main.src, srcset: cover.main.srcSet.attribute, sizes: gallerySizes }}
  schema={[
    webPage({ path, title: data.h1, description: data.seoDescription, type: 'ItemPage' }),
    productSchema({
      path,
      name: data.name,
      description: data.definition,
      offers: data.variants.map((v) => ({
        name: `${v.duel} · ${v.formula}`,
        sku: v.sku,
        price: v.price,
        available: v.available,
      })),
      images: schemaImages,
      category: category?.data.name ?? 'Wijnspel',
      reviews,
    }),
    breadcrumbs(crumbs),
    faqPage(path, data.faq),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="container-site grid gap-6 py-4 md:grid-cols-2 md:gap-8 md:py-10 lg:gap-12">
    <!-- Gallery: CSS scroll-snap; thumbnails on larger screens, swipe on mobile -->
    <div class="min-w-0" data-gallery>
      <ul
        class="flex snap-x snap-mandatory overflow-x-auto rounded-[var(--radius-card)] bg-white [scrollbar-width:none]"
        data-gallery-track
        data-lazy-root
        aria-label="Productfoto's"
      >
        {slides.map((slide, i) => (
          <li class="w-full shrink-0 snap-center" id={`foto-${i + 1}`}>
            {slide.kind === 'video' ? (
              <LazyVideo src={clip.src} poster={clip.poster} label={clip.label} class="aspect-square h-auto w-full object-cover" />
            ) : (
              <img
                src={slide.main.src}
                srcset={slide.main.srcSet.attribute}
                sizes={gallerySizes}
                width="720"
                height="720"
                alt={slide.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
                class="aspect-square w-full object-cover"
              />
            )}
          </li>
        ))}
      </ul>
      <p class="mt-2 text-center text-xs text-muted md:hidden" aria-hidden="true">
        Swipe voor een filmpje en {slides.length - 2} foto's
      </p>
      <ul class="mt-3 hidden gap-2 overflow-x-auto pb-1 md:flex" aria-label="Kies een foto of het filmpje">
        {slides.map((slide, i) => (
          <li class="shrink-0">
            <a
              href={`#foto-${i + 1}`}
              data-gallery-thumb={i}
              class="thumb relative"
              aria-current={i === 0 ? 'true' : 'false'}
            >
              <img
                src={slide.thumb.src}
                width="64"
                height="64"
                alt={slide.label}
                loading="lazy"
                decoding="async"
                class="size-16 object-cover"
              />
              {slide.kind === 'video' && (
                <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                  <svg class="size-7 drop-shadow" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="11" fill="white" fill-opacity="0.9" />
                    <path d="M10 8l6 4-6 4z" fill="currentColor" />
                  </svg>
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Buy box: name, option list, price and button come first (mobile first) -->
    <div>
      <h1 class="h3 text-brand">{data.h1}</h1>
      <ReviewHighlight href="#reviews-title" class="mt-1" />

      <form data-add-to-cart data-variant-form id="bestellen" class="mt-4 scroll-mt-28" method="post" action="#">
        <input type="hidden" name="handle" value={initial ? `${product.id}:${initial.id}` : ''} />
        <input type="hidden" name="name" value={initial ? `${data.name} (${initial.duel} · ${initial.formula})` : ''} />
        <input type="hidden" name="price" value={initial?.price ?? ''} />
        <input type="hidden" name="image" value={cover.thumb.src} />
        <input type="hidden" name="url" value={path} />
        <input type="hidden" name="quantity" value="1" />

        <fieldset disabled={!available}>
          <legend class="text-sm font-bold">Kies je box</legend>
          <div class="mt-2 grid gap-2">
            {variants.map((v, i) => (
              <label class="variant-tile">
                <input
                  type="radio"
                  name="variant"
                  value={v.id}
                  checked={i === 0}
                  required
                  class="sr-only"
                  data-handle={`${product.id}:${v.id}`}
                  data-name={`${data.name} (${v.duel} · ${v.formula})`}
                  data-label={`${v.duel} · ${v.formula}`}
                  data-price={v.price}
                  data-group={v.group}
                />
                <span class="min-w-0 flex-1">
                  <span class="block font-bold leading-tight">{v.duel}</span>
                  <span class="block text-sm text-muted">
                    <strong class="text-ink">{v.formula}:</strong> {FORMULAS[v.formula]}
                  </span>
                </span>
                <span class="shrink-0 text-right">
                  <span class="block font-bold">{formatPrice(v.price)}</span>
                  {upcharge(v) > 0 && (
                    <span class="block text-xs font-bold text-brand">+ {formatPrice(upcharge(v))} voor betere wijn</span>
                  )}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <p class="mt-4 text-3xl font-bold" data-price-display aria-live="polite">
          {initial ? formatPrice(initial.price) : 'Tijdelijk uitverkocht'}
        </p>
        <p class="mt-1 text-sm text-muted">
          Inclusief btw en twee flessen wijn
          {initial && (
            <>
              {' · '}
              <span data-per-person data-players={data.playersMax}>{perPersonLabel(initial.price)}</span>
            </>
          )}
        </p>

        <button type="submit" class="btn-primary mt-4 w-full" data-buy-button disabled={!available}>
          {initial ? `In winkelmandje · ${formatPrice(initial.price)}` : 'Tijdelijk uitverkocht'}
        </button>
        <ShippingCutoff class="mt-2 text-center text-sm" />

        <ul class="checklist mt-4 space-y-1.5 text-sm" aria-label="Goed om te weten">
          {[
            'Geen wijnkennis nodig',
            `Al vanaf ${data.playersMin} spelers`,
            'Niet lekker? Geld terug, geopende flessen hoeven niet terug',
          ].map((reason) => (
            <li>{reason}</li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-muted">{SITE.ageNotice}</p>
      </form>

      <PaymentIcons class="mt-3 justify-center" />

      <p class="mt-6 border-l-4 border-brand pl-4">{data.definition}</p>

      <ul class="checklist mt-5 space-y-2">
        {data.usps.map((usp) => (
          <li>{usp}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Sticky buy bar on mobile: adds the chosen box straight away -->
  {available && (
    <div
      class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-cream/95 p-3 backdrop-blur md:hidden"
      data-sticky-buy
      hidden
    >
      <div class="flex items-center gap-3">
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-bold" data-sticky-label>
            {initial ? `${initial.duel} · ${initial.formula}` : data.name}
          </p>
          <p class="text-sm" data-sticky-price>
            {formatPrice(initial?.price ?? minPrice)}
          </p>
        </div>
        <button type="button" class="btn-primary min-h-11 py-2" data-sticky-button>
          In winkelmandje
        </button>
      </div>
    </div>
  )}

  <!-- Details -->
  <section class="section-y bg-white" aria-labelledby="over-title">
    <div class="container-site grid items-start gap-8 md:grid-cols-2">
      <div>
        <h2 id="over-title" class="h3">
          Over dit wijnspel
        </h2>
        {descriptions.map((d, i) => (
          <div data-description={d.group} hidden={initial ? d.group !== initial.group : i !== 0}>
            {descriptions.length > 1 && <h3 class="h4 mt-4">{d.heading}</h3>}
            <div class="prose-flavory mt-3" set:html={d.html} />
          </div>
        ))}
        {data.highlights.length > 0 && (
          <ul class="mt-6 space-y-3">
            {data.highlights.map((h) => (
              <li class="flex gap-3">
                <span class="mt-2 size-2 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                <span>
                  <strong>{h.title}</strong> {h.text}
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>
      <div class="space-y-6">
        <div class="card p-6">
          <h2 class="h4">Wat zit er in de box?</h2>
          <ul class="mt-3 list-disc space-y-1 pl-5">
            {data.boxContents.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <HowItWorks heading="Zo speel je Flavory" />

  <section class="section-y bg-white" aria-labelledby="faq-title">
    <div class="container-site">
      <h2 id="faq-title" class="h3">
        Veelgestelde vragen over deze box
      </h2>
      <div class="mt-4">
        <Faq items={data.faq} />
      </div>
      <p class="mt-4 text-sm">
        Nog een vraag? Bekijk alle{' '}
        <a href="/faq/" class="text-brand underline">
          veelgestelde vragen
        </a>{' '}
        of lees{' '}
        <a href="/verzending-en-retour/" class="text-brand underline">
          verzending en retour
        </a>
        .
      </p>
    </div>
  </section>

  <Reviews />

  {others.length > 0 && (
    <section class="section-y container-site" aria-labelledby="andere-title">
      <h2 id="andere-title" class="h3">
        Ontdek ook
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {others.map((p) => (
          <li>
            <ProductCard product={p} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="section-y bg-white" aria-labelledby="lees-title">
      <div class="container-site">
        <h2 id="lees-title" class="h3">
          Lees meer voor je begint
        </h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-3">
          {relatedPosts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { formatPrice, pricePerPerson } from '@/lib/site';

  // Gallery thumbnails scroll the track instead of jumping the page.
  const root = document.querySelector<HTMLElement>('[data-gallery]');
  const track = root?.querySelector<HTMLElement>('[data-gallery-track]');
  const thumbs = [...(root?.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]') ?? [])];
  if (track) {
    thumbs.forEach((thumb, i) =>
      thumb.addEventListener('click', (e) => {
        e.preventDefault();
        track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
      }),
    );
    track.addEventListener(
      'scroll',
      () => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        thumbs.forEach((t, i) => t.setAttribute('aria-current', String(i === index)));
      },
      { passive: true },
    );
  }

  // Option tiles: price, button, sticky bar and description follow the choice.
  const form = document.querySelector<HTMLFormElement>('[data-variant-form]');
  const radios = [...(form?.querySelectorAll<HTMLInputElement>('input[name="variant"]') ?? [])];
  const button = form?.querySelector<HTMLButtonElement>('[data-buy-button]');
  const priceDisplay = form?.querySelector<HTMLElement>('[data-price-display]');
  const perPerson = form?.querySelector<HTMLElement>('[data-per-person]');
  const stickyPrice = document.querySelector<HTMLElement>('[data-sticky-price]');
  const stickyLabel = document.querySelector<HTMLElement>('[data-sticky-label]');
  const stickyButton = document.querySelector<HTMLButtonElement>('[data-sticky-button]');
  const players = Number(perPerson?.dataset.players ?? 0);

  const setField = (name: string, value: string) => {
    const input = form?.elements.namedItem(name);
    if (input instanceof HTMLInputElement) input.value = value;
  };

  function applyChoice() {
    const option = radios.find((r) => r.checked);
    if (!form || !button || !option) return;
    const price = Number(option.dataset.price);
    setField('handle', option.dataset.handle ?? '');
    setField('name', option.dataset.name ?? '');
    setField('price', String(price));
    if (priceDisplay) priceDisplay.textContent = formatPrice(price);
    if (perPerson && players) perPerson.textContent = `${pricePerPerson(price, players)} per persoon met ${players} spelers`;
    button.textContent = `In winkelmandje · ${formatPrice(price)}`;
    if (stickyPrice) stickyPrice.textContent = formatPrice(price);
    if (stickyLabel) stickyLabel.textContent = option.dataset.label ?? '';
    for (const block of document.querySelectorAll<HTMLElement>('[data-description]')) {
      block.hidden = block.dataset.description !== option.dataset.group;
    }
  }

  form?.addEventListener('change', applyChoice);
  // Browsers may restore a previous choice on back/forward navigation.
  applyChoice();

  stickyButton?.addEventListener('click', () => form?.requestSubmit());

  // Show the sticky bar once the main button scrolls out of view.
  const bar = document.querySelector<HTMLElement>('[data-sticky-buy]');
  if (bar && button) {
    new IntersectionObserver(([entry]) => {
      bar.hidden = !!entry && (entry.isIntersecting || entry.boundingClientRect.top > 0);
    }).observe(button);
  }
</script>
