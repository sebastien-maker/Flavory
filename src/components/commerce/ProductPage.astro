---
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ReviewHighlight from '@/components/ui/ReviewHighlight.astro';
import Faq from '@/components/ui/Faq.astro';
import PaymentIcons from './PaymentIcons.astro';
import ProductCard from './ProductCard.astro';
import { SHORT_STEPS } from '@/lib/steps';
import Reviews from '@/components/sections/Reviews.astro';
import {
  availableVariants,
  fromPrice,
  getProducts,
  getReviews,
  postPath,
  productPath,
  categoryPath,
  realSku,
  type Product,
} from '@/lib/content';
import { SITE, absoluteUrl, formatPrice, shippingLine } from '@/lib/site';
import { breadcrumbs, faqPage, product as productSchema, webPage } from '@/components/seo/schema';
import LazyVideo from '@/components/ui/LazyVideo.astro';
import redPoster from '@/assets/images/site/flavory-avond-rood-poster.jpg';
import whitePoster from '@/assets/images/site/flavory-avond-wit-poster.jpg';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { data } = product;
const path = productPath(product.id);
const category = await getEntry(data.category);
// Every option stays visible; a sold-out one is shown as such and cannot be picked, so the box
// never silently switches to another duel.
const variants = data.variants;
const buyable = variants.filter((v) => v.available);
const available = buyable.length > 0;
const minPrice = fromPrice(product);
// The first option that can be bought is preselected, so the buy button works straight away.
const initial = buyable[0];
// Options grouped per duel, so Standaard and Premium sit side by side.
const duels = [...new Set(variants.map((v) => v.duel))].map((name) => ({
  name,
  variants: variants.filter((v) => v.duel === name),
}));
// When the standard box is sold out, point to the box that is still in stock (leftover stock).
const standardSoldOut = variants.some((v) => v.formula === 'Standaard' && !v.available);
const alternative = standardSoldOut
  ? (await getProducts()).find(
      (p) => p.id !== product.id && p.data.category.id === data.category.id && availableVariants(p).length > 0,
    )
  : undefined;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Shop', path: '/shop/' },
  ...(category ? [{ name: category.data.name, path: categoryPath(category.id) }] : []),
  { name: data.name, path },
];

// Images: first one is the LCP element.
const gallery = await Promise.all(
  data.images.map(async (img) => ({
    alt: img.alt,
    main: await getImage({
      src: img.src,
      width: 720,
      height: 720,
      fit: 'cover',
      widths: [480, 960],
      format: 'webp',
    }),
    thumb: await getImage({ src: img.src, width: 96, height: 96, fit: 'cover', format: 'webp' }),
  })),
);
const gallerySizes = '(min-width: 1024px) 36rem, (min-width: 768px) 50vw, 100vw';
const cover = gallery[0]!;
// Mood clip of the matching wine colour, shown as the second slide of the gallery.
const clip =
  data.category.id === 'rode-wijn'
    ? {
        src: '/media/flavory-avond-rood.mp4',
        poster: redPoster,
        label: 'Sfeerbeelden: vrienden spelen Flavory met rode wijn bij het haardvuur',
      }
    : {
        src: '/media/flavory-avond-wit.mp4',
        poster: whitePoster,
        label: 'Sfeerbeelden: vrienden spelen Flavory met witte wijn en klinken aan tafel',
      };
const clipThumb = await getImage({ src: clip.poster, width: 96, height: 96, fit: 'cover', format: 'webp' });
const slides = [
  { kind: 'image' as const, label: cover.alt, ...cover },
  { kind: 'video' as const, label: clip.label, thumb: clipThumb },
  ...gallery.slice(1).map((img) => ({ kind: 'image' as const, label: img.alt, ...img })),
];

// First paragraph stays visible; the rest sits behind "Lees meer" (still in the HTML for search engines).
const descriptions = data.descriptions.map((d) => {
  const [intro = '', ...rest] = d.text.trim().split(/\n\s*\n/);
  return {
    ...d,
    intro: marked.parse(intro, { async: false }),
    more: marked.parse(rest.join('\n\n'), { async: false }),
  };
});
const others = (await getProducts()).filter((p) => p.id !== product.id);
// Comparison article about the two wines in this box, when there is one.
const comparison = data.comparisonPost ? await getEntry(data.comparisonPost) : undefined;
const reviews = (await getReviews()).map((r) => r.data);

const schemaImages = await Promise.all(
  data.images
    .slice(0, 3)
    .map(async (img) => absoluteUrl((await getImage({ src: img.src, width: 1200, format: 'jpg' })).src)),
);
---

<BaseLayout
  title={data.seoTitle}
  description={data.seoDescription}
  path={path}
  type="product"
  image={data.images[0]!.src}
  imageAlt={cover.alt}
  preloadImage={{ src: cover.main.src, srcset: cover.main.srcSet.attribute, sizes: gallerySizes }}
  schema={[
    webPage({ path, title: data.h1, description: data.seoDescription, type: 'ItemPage' }),
    productSchema({
      path,
      name: data.name,
      description: data.definition,
      offers: data.variants.map((v) => ({
        name: `${data.name} (${v.formula})`,
        sku: realSku(v.sku),
        gtin13: v.gtin13,
        price: v.price,
        available: v.available,
      })),
      images: schemaImages,
      category: category?.data.name ?? 'Wijnspel',
      reviews,
    }),
    breadcrumbs(crumbs),
    faqPage(path, data.faq),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="container-site grid gap-6 py-4 md:grid-cols-2 md:gap-8 md:py-10 lg:gap-12">
    <!-- Gallery: CSS scroll-snap; thumbnails on larger screens, swipe on mobile -->
    <div class="min-w-0" data-gallery>
      <ul
        class="flex snap-x snap-mandatory overflow-x-auto rounded-[var(--radius-card)] bg-white [scrollbar-width:none]"
        data-gallery-track
        data-lazy-root
        aria-label="Productfoto's"
      >
        {slides.map((slide, i) => (
          <li class="w-full shrink-0 snap-center" id={`foto-${i + 1}`}>
            {slide.kind === 'video' ? (
              <LazyVideo
                src={clip.src}
                poster={clip.poster}
                label={clip.label}
                class="aspect-square h-auto w-full object-cover"
              />
            ) : (
              <img
                src={slide.main.src}
                srcset={slide.main.srcSet.attribute}
                sizes={gallerySizes}
                width="720"
                height="720"
                alt={slide.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
                class="aspect-square w-full object-cover"
              />
            )}
          </li>
        ))}
      </ul>
      <p class="mt-2 text-center text-xs text-muted md:hidden" aria-hidden="true">
        Swipe voor een filmpje en {slides.length - 2} foto's
      </p>
      <ul class="mt-3 hidden gap-2 overflow-x-auto pb-1 md:flex" aria-label="Kies een foto of het filmpje">
        {slides.map((slide, i) => (
          <li class="shrink-0">
            <a
              href={`#foto-${i + 1}`}
              data-gallery-thumb={i}
              class="thumb relative"
              aria-current={i === 0 ? 'true' : 'false'}
            >
              <img
                src={slide.thumb.src}
                width="64"
                height="64"
                alt={slide.label}
                loading="lazy"
                decoding="async"
                class="size-16 object-cover"
              />
              {slide.kind === 'video' && (
                <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                  <svg class="size-7 drop-shadow" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="11" fill="white" fill-opacity="0.9" />
                    <path d="M10 8l6 4-6 4z" fill="currentColor" />
                  </svg>
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Buy box: name, option list, price and button come first (mobile first) -->
    <div>
      {data.badge && <p class="badge inline-block bg-ink text-white">{data.badge}</p>}
      <h1 class="h3 mt-1 text-brand">{data.h1}</h1>
      {data.intro && <p class="mt-2">{data.intro}</p>}
      <ReviewHighlight href="#reviews-title" class="mt-1" />

      <form data-add-to-cart data-variant-form id="bestellen" class="mt-4 scroll-mt-28" method="post" action="#">
        <input type="hidden" name="handle" value={initial ? `${product.id}:${initial.id}` : ''} />
        <input type="hidden" name="name" value={initial ? `${data.name} (${initial.formula})` : ''} />
        <input type="hidden" name="price" value={initial?.price ?? ''} />
        <input type="hidden" name="image" value={cover.thumb.src} />
        <input type="hidden" name="url" value={path} />
        <input type="hidden" name="quantity" value="1" />
        <input type="hidden" name="woo_id" value={initial?.wooId ?? ''} />

        <fieldset disabled={!available}>
          <legend class="text-sm font-bold">Kies je box</legend>
          {duels.map((duel) => (
            <div class="mt-3">
              <p class="mb-3 font-bold">{duel.name}</p>
              <div class="grid grid-cols-2 gap-2">
                {duel.variants.map((v) => (
                  <label class:list={['variant-tile', !v.available && 'is-sold-out']}>
                    <input
                      type="radio"
                      name="variant"
                      value={v.id}
                      checked={v.id === initial?.id}
                      disabled={!v.available}
                      required
                      class="sr-only"
                      data-handle={`${product.id}:${v.id}`}
                      data-name={`${data.name} (${v.formula})`}
                      data-label={v.formula}
                      data-price={v.price}
                      data-group={v.group}
                      data-woo-id={v.wooId}
                    />
                    {v.available && v.formula === 'Premium' && <span class="tile-badge">Meest populair</span>}
                    <span class="flex items-center justify-between gap-2">
                      <span class="font-bold">{v.formula}</span>
                      {v.available && <span class="tile-dot" aria-hidden="true" />}
                    </span>
                    {v.available ? (
                      <span class="font-bold" data-tile-price>
                        {formatPrice(v.price)}
                      </span>
                    ) : (
                      <span class="font-bold">Tijdelijk uitverkocht</span>
                    )}
                  </label>
                ))}
              </div>
            </div>
          ))}
          {variants.length > 1 && (
            <p class="mt-3 text-sm text-muted">
              Het spel is hetzelfde; Premium heeft twee duurdere flessen met meer diepgang.
            </p>
          )}
        </fieldset>
        {alternative && (
          <p class="mt-3 rounded-xl bg-blush p-3 text-sm">
            Standaard is tijdelijk uitverkocht. Wel beschikbaar:{' '}
            <a class="font-bold underline" href={productPath(alternative.id)}>
              {alternative.data.name}
            </a>
            .
          </p>
        )}
        {data.stockNote && <p class="mt-3 text-sm text-muted">{data.stockNote}</p>}

        <p class="mt-4 text-3xl font-bold" data-price-display aria-live="polite">
          {initial ? formatPrice(initial.price) : 'Tijdelijk uitverkocht'}
        </p>
        <p class="mt-1 text-sm">
          Spel + 2 flessen van 75 cl · {data.playersMin} tot {data.playersMax} spelers · 60 tot 90 minuten
        </p>

        <button type="submit" class="btn-primary mt-4 w-full" data-buy-button disabled={!available}>
          {initial ? `In winkelmandje · ${formatPrice(initial.price)}` : 'Tijdelijk uitverkocht'}
        </button>
        <p class="mt-2 text-sm text-muted">
          {shippingLine()} {SITE.guarantee}
        </p>
        <PaymentIcons class="mt-3 justify-center" />
        <p class="mt-3 text-xs text-muted">{SITE.ageNotice}</p>
      </form>
    </div>
  </section>

  <!-- Sticky buy bar on mobile: adds the chosen box straight away -->
  {available && (
    <div
      class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-cream/95 p-3 backdrop-blur md:hidden"
      data-sticky-buy
      hidden
    >
      <div class="flex items-center gap-3">
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-bold" data-sticky-label>
            {initial ? `${data.name} · ${initial.formula}` : data.name}
          </p>
          <p class="text-sm" data-sticky-price>
            {formatPrice(initial?.price ?? minPrice)}
          </p>
        </div>
        <button type="button" class="btn-primary min-h-11 py-2" data-sticky-button>
          In winkelmandje
        </button>
      </div>
    </div>
  )}

  <!-- 2. Wat je proeft -->
  <section class="section-y bg-white" aria-labelledby="proeven-title">
    <div class="container-site max-w-3xl">
      <h2 id="proeven-title" class="h2">
        Wat je proeft
      </h2>
      <p class="mt-3 border-l-4 border-brand pl-4">{data.definition}</p>
      {descriptions.map((d, i) => (
        <div data-description={d.group} hidden={initial ? d.group !== initial.group : i !== 0}>
          <div class="prose-flavory mt-4" set:html={d.intro} />
          <details class="group mt-2">
            <summary class="cursor-pointer list-none font-bold text-brand underline group-open:hidden">
              Lees meer
            </summary>
            <div class="prose-flavory" set:html={d.more} />
          </details>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. Wat zit erin -->
  <section class="section-y" aria-labelledby="inhoud-title">
    <div class="container-site max-w-3xl">
      <h2 id="inhoud-title" class="h2">
        Wat zit erin
      </h2>
      <ul class="checklist mt-4 space-y-1.5">
        {data.boxContents.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Zo speel je -->
  <section class="section-y bg-white" aria-labelledby="spelen-title">
    <div class="container-site max-w-3xl">
      <h2 id="spelen-title" class="h2">
        Zo speel je
      </h2>
      <ol class="mt-4 divide-y divide-line">
        {SHORT_STEPS.map((step, i) => (
          <li class="flex items-center gap-4 py-3">
            <span class="step-number" aria-hidden="true">
              {i + 1}
            </span>
            <div class="min-w-0">
              <p class="font-bold">
                <span class="sr-only">Stap {i + 1}: </span>
                {step.title}
              </p>
              <p class="mt-1 text-sm text-muted">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-4">
        <a href="/hoe-werkt-het/" class="font-bold text-brand underline">
          De spelregels in 6 stappen
        </a>
      </p>
    </div>
  </section>

  <!-- 5. Reviews -->
  <Reviews limit={3} />

  <!-- 6. Vragen, andere duels en het vergelijkingsartikel -->
  <section class="section-y bg-white" aria-labelledby="faq-title">
    <div class="container-site max-w-3xl">
      <h2 id="faq-title" class="h2">
        Veelgestelde vragen
      </h2>
      <div class="mt-4">
        <Faq items={data.faq.slice(0, 5)} />
      </div>
      <p class="mt-4 text-sm">
        Nog een vraag? Bekijk alle{' '}
        <a href="/faq/" class="text-brand underline">
          veelgestelde vragen
        </a>{' '}
        of lees{' '}
        <a href="/verzending-en-retour/" class="text-brand underline">
          verzending en retour
        </a>
        .
      </p>
      <p class="mt-4 text-sm">
        Cadeau geven?{' '}
        <a href="/cadeau/" class="text-brand underline">
          Zo geef je het wijnspel cadeau
        </a>
        .
      </p>
      {comparison && (
        <p class="mt-4">
          <a href={postPath(comparison.id)} class="font-bold text-brand underline">
            {comparison.data.title}
          </a>
        </p>
      )}
      {others.length > 0 && (
        <>
          <h3 class="h3 mt-10">Andere duels</h3>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {others.map((p) => (
              <li>
                <ProductCard product={p} />
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  import { formatPrice } from '@/lib/site';
  import { WOO_API_PROXY, parseStoreProducts, storeProductsPath } from '@/lib/commerce/woo';
  import { track as trackEvent } from '@/lib/analytics';

  // Gallery thumbnails scroll the track instead of jumping the page.
  const root = document.querySelector<HTMLElement>('[data-gallery]');
  const track = root?.querySelector<HTMLElement>('[data-gallery-track]');
  const thumbs = [...(root?.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]') ?? [])];
  if (track) {
    thumbs.forEach((thumb, i) =>
      thumb.addEventListener('click', (e) => {
        e.preventDefault();
        track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
      }),
    );
    track.addEventListener(
      'scroll',
      () => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        thumbs.forEach((t, i) => t.setAttribute('aria-current', String(i === index)));
      },
      { passive: true },
    );
  }

  // Option tiles: price, button, sticky bar and description follow the choice.
  const form = document.querySelector<HTMLFormElement>('[data-variant-form]');
  const radios = [...(form?.querySelectorAll<HTMLInputElement>('input[name="variant"]') ?? [])];
  const button = form?.querySelector<HTMLButtonElement>('[data-buy-button]');
  const priceDisplay = form?.querySelector<HTMLElement>('[data-price-display]');
  const stickyPrice = document.querySelector<HTMLElement>('[data-sticky-price]');
  const stickyLabel = document.querySelector<HTMLElement>('[data-sticky-label]');
  const stickyButton = document.querySelector<HTMLButtonElement>('[data-sticky-button]');

  const setField = (name: string, value: string) => {
    const input = form?.elements.namedItem(name);
    if (input instanceof HTMLInputElement) input.value = value;
  };

  function applyChoice() {
    const option = radios.find((r) => r.checked);
    if (!form || !button || !option) return;
    const price = Number(option.dataset.price);
    setField('handle', option.dataset.handle ?? '');
    setField('name', option.dataset.name ?? '');
    setField('price', String(price));
    setField('woo_id', option.dataset.wooId ?? '');
    if (priceDisplay) priceDisplay.textContent = formatPrice(price);
    button.textContent = `In winkelmandje · ${formatPrice(price)}`;
    if (stickyPrice) stickyPrice.textContent = formatPrice(price);
    if (stickyLabel) stickyLabel.textContent = option.dataset.label ?? '';
    for (const block of document.querySelectorAll<HTMLElement>('[data-description]')) {
      block.hidden = block.dataset.description !== option.dataset.group;
    }
  }

  // Merchant Center links to ?box=<option id>, so the landing page shows that option and its price.
  const requested = new URLSearchParams(location.search).get('box');
  const requestedRadio = radios.find((r) => r.value === requested);
  if (requestedRadio) requestedRadio.checked = true;

  form?.addEventListener('change', applyChoice);

  // Analytics: which box people look at and which option they pick.
  const optionProperties = (radio: HTMLInputElement | undefined) => ({
    product_id: radio?.dataset.handle?.split(':')[0],
    variant_id: radio?.value,
    variant: radio?.dataset.label,
    price: Number(radio?.dataset.price),
    currency: 'EUR',
  });
  trackEvent('product_viewed', { ...optionProperties(radios.find((r) => r.checked)), options: radios.length });
  form?.addEventListener('change', (e) => {
    const radio = e.target instanceof HTMLInputElement && e.target.name === 'variant' ? e.target : undefined;
    if (radio) trackEvent('variant_selected', optionProperties(radio));
  });

  // Live price and stock from WooCommerce (via the same-origin proxy). The HTML already has the build-time
  // values, so a failed request changes nothing.
  const wooIds = radios.map((r) => Number(r.dataset.wooId)).filter(Boolean);
  if (wooIds.length > 0) {
    fetch(`${WOO_API_PROXY}${storeProductsPath(wooIds)}`)
      .then((res) => (res.ok ? res.json() : []))
      .then((json: unknown) => {
        const stock = parseStoreProducts(json);
        for (const radio of radios) {
          const live = stock.get(Number(radio.dataset.wooId));
          if (!live) continue;
          radio.dataset.price = String(live.price);
          const tile = radio.closest('label');
          const price = tile?.querySelector('[data-tile-price]');
          if (price) price.textContent = formatPrice(live.price);
          radio.disabled = !live.buyable;
          tile?.classList.toggle('is-sold-out', !live.buyable);
        }
        const selected = radios.find((r) => r.checked);
        if (selected?.disabled) {
          const next = radios.find((r) => !r.disabled);
          if (next) next.checked = true;
        }
        applyChoice();
      })
      .catch(() => {});
  }
  // Browsers may restore a previous choice on back/forward navigation.
  applyChoice();

  stickyButton?.addEventListener('click', () => form?.requestSubmit());

  // Show the sticky bar once the main button scrolls out of view.
  const bar = document.querySelector<HTMLElement>('[data-sticky-buy]');
  if (bar && button) {
    new IntersectionObserver(([entry]) => {
      bar.hidden = !!entry && (entry.isIntersecting || entry.boundingClientRect.top > 0);
    }).observe(button);
  }
</script>
