---
import { SITE } from '@/lib/site';
import Countdown from '@/components/ui/Countdown.astro';

// A dark bar with white, bold text, so the message cannot be missed. Free shipping always comes first.
// During a campaign the promotion stands next to it (below it on a phone), with the time left from md up,
// and links to its page.
const notice = SITE.checkoutNotice;
const campaign = !notice && SITE.campaign === 'blackfriday' && SITE.blackFriday.offer;
const { endDate, endsAt } = SITE.blackFriday;
const path = Astro.url.pathname;
// On a phone the home page and /black-friday/ leave the promotion to the band under their header, so the bar
// stays one line there.
const promoClass = path === '/' || path === '/black-friday/' ? 'hidden md:inline-flex' : 'inline-flex';
// The restock message only shows on the homepage and the shop pages.
const restock = !notice && !campaign && (path === '/' || path.startsWith('/shop/')) && SITE.restock;
---

{notice ? (
  <div class="bg-[#f28c28] text-ink">
    <p
      role="status"
      class="container-site flex items-center justify-center gap-2.5 py-3 text-center text-sm leading-snug font-bold"
    >
      <span aria-hidden="true" class="text-lg leading-none">⚠</span>
      <span>{notice}</span>
    </p>
  </div>
) : (
  <div class="bg-ink text-white">
    <p class="container-site flex min-h-10 flex-wrap items-center justify-center gap-x-6 py-2 text-center text-sm leading-snug font-bold">
      {restock ? (
        <a href="/shop/" class="underline underline-offset-2">
          {restock}
        </a>
      ) : (
        <span>{SITE.announcement}</span>
      )}
      {campaign && (
        <a
          href="/black-friday/"
          class:list={['flex-wrap items-center justify-center gap-x-2 font-normal underline underline-offset-2', promoClass]}
        >
          <span>{campaign}</span>
          {endDate && endsAt && (
            <span class="hidden md:inline">
              <Countdown endsAt={endsAt} fallback={`tot en met ${endDate}`} />
            </span>
          )}
        </a>
      )}
    </p>
  </div>
)}
