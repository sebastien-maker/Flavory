---
import { SITE } from '@/lib/site';
import Countdown from '@/components/ui/Countdown.astro';

// During a campaign the bar carries the promotion in one sentence, with the time left, and links to its page.
const notice = SITE.checkoutNotice;
const campaign = !notice && SITE.campaign === 'blackfriday' && SITE.blackFriday.offer;
const { endDate, endsAt } = SITE.blackFriday;
// The restock message only shows on the homepage and the shop pages.
const path = Astro.url.pathname;
const restock = !notice && !campaign && (path === '/' || path.startsWith('/shop/')) && SITE.restock;
---

{notice ? (
  <div class="bg-[#f28c28] text-ink">
    <p
      role="status"
      class="container-site flex items-center justify-center gap-2.5 py-3 text-center text-sm leading-snug font-bold"
    >
      <span aria-hidden="true" class="text-lg leading-none">⚠</span>
      <span>{notice}</span>
    </p>
  </div>
) : campaign ? (
  <div class="bg-ink text-white">
    <p class="container-site py-2 text-center text-sm leading-snug font-bold">
      <a href="/black-friday/" class="inline-flex flex-wrap items-center justify-center gap-x-2 hover:underline">
        <span>{campaign}</span>
        {endDate && (
          <span class="font-normal">
            {endsAt ? <Countdown endsAt={endsAt} fallback={`tot en met ${endDate}`} /> : `tot en met ${endDate}`}
          </span>
        )}
      </a>
    </p>
  </div>
) : restock ? (
  <div class="bg-ink text-white">
    <p class="container-site flex min-h-9 items-center justify-center py-2 text-center text-xs leading-tight font-bold">
      <a href="/shop/" class="underline underline-offset-2">
        {restock}
      </a>
    </p>
  </div>
) : (
  <div class="border-b border-line bg-cream text-ink">
    <p class="container-site flex min-h-9 items-center justify-center py-2 text-center text-xs leading-tight font-bold whitespace-nowrap">
      {SITE.announcement}
    </p>
  </div>
)}
