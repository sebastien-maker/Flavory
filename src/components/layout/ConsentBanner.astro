---
// Cookie consent (rule 8): GTM and everything behind it load only after explicit consent.
// Google Consent Mode v2 defaults are set to "denied" before GTM loads.
import { SITE } from '@/lib/site';
---

<div
  id="consent-banner"
  hidden
  role="dialog"
  aria-labelledby="consent-title"
  aria-live="polite"
  class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-xl rounded-2xl bg-white p-5 shadow-2xl ring-1 ring-line"
>
  <p id="consent-title" class="font-display text-lg">
    Cookies, maar dan met mate
  </p>
  <p class="mt-2 text-sm">
    We gebruiken noodzakelijke cookies om de site te laten werken. Met jouw toestemming gebruiken we ook analytische en
    marketingcookies om de site te verbeteren en relevante advertenties te tonen. Meer info in ons{' '}
    <a href="/privacybeleid/" class="text-brand underline">
      privacybeleid
    </a>
    .
  </p>
  <form class="mt-3 space-y-2 text-sm" data-consent-form>
    <label class="flex items-center gap-2 text-muted">
      <input type="checkbox" checked disabled class="size-4 accent-brand" /> Noodzakelijk (altijd aan)
    </label>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="analytics" class="size-4 accent-brand" /> Analytisch
    </label>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="marketing" class="size-4 accent-brand" /> Marketing
    </label>
    <div class="flex flex-wrap gap-2 pt-2">
      <button type="button" data-consent="all" class="btn-primary min-h-10 flex-1 py-2">
        Alles accepteren
      </button>
      <button type="submit" class="btn-outline min-h-10 flex-1 py-2">
        Keuze opslaan
      </button>
      <button type="button" data-consent="none" class="btn min-h-10 flex-1 py-2 underline">
        Weigeren
      </button>
    </div>
  </form>
</div>

<script is:inline define:vars={{ gtmId: SITE.gtmId }}>
  (() => {
    const KEY = 'flavory-consent-v1';
    window.dataLayer = window.dataLayer || [];
    // GTM requires the real Arguments object for consent commands.
    function gtag() {
      // eslint-disable-next-line prefer-rest-params
      window.dataLayer.push(arguments);
    }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });

    let loaded = false;
    const loadGtm = () => {
      if (loaded || !gtmId) return;
      loaded = true;
      window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
      document.head.appendChild(s);
    };

    const apply = (c) => {
      gtag('consent', 'update', {
        analytics_storage: c.analytics ? 'granted' : 'denied',
        ad_storage: c.marketing ? 'granted' : 'denied',
        ad_user_data: c.marketing ? 'granted' : 'denied',
        ad_personalization: c.marketing ? 'granted' : 'denied',
      });
      // Load after the page is idle so GTM never competes with LCP.
      if (c.analytics || c.marketing) ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(loadGtm);
    };

    let stored = null;
    try {
      stored = JSON.parse(localStorage.getItem(KEY) || 'null');
    } catch {
      stored = null;
    }
    if (stored) apply(stored);

    const save = (c) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(c));
      } catch {
        // Storage blocked: consent applies to this page view only.
      }
      apply(c);
      document.getElementById('consent-banner').hidden = true;
    };

    document.addEventListener('DOMContentLoaded', () => {
      const banner = document.getElementById('consent-banner');
      const form = banner.querySelector('[data-consent-form]');
      if (stored) {
        form.analytics.checked = !!stored.analytics;
        form.marketing.checked = !!stored.marketing;
      } else {
        banner.hidden = false;
      }
      banner.addEventListener('click', (e) => {
        const choice = e.target.closest('[data-consent]');
        if (!choice) return;
        const all = choice.getAttribute('data-consent') === 'all';
        save({ analytics: all, marketing: all, ts: Date.now() });
      });
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        save({ analytics: form.analytics.checked, marketing: form.marketing.checked, ts: Date.now() });
      });
      document.addEventListener('click', (e) => {
        if (e.target.closest('[data-consent-open]')) banner.hidden = false;
      });
    });
  })();
</script>
