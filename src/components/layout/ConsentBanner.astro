---
// Cookie consent (rule 8): GTM, Converge and everything behind them load only after explicit consent.
// Google Consent Mode v2 defaults are set to "denied" before GTM loads.
//
// Notes on the inline script below. They live here because an is:inline script ships as written on
// every page and counts towards the 60 KB HTML budget (rule 8).
// - GTM requires the real Arguments object for consent commands, hence gtag() pushes `arguments`.
// - PostHog (EU cloud) loads through the same-origin proxy /ingest (netlify.toml), so blockers miss less.
//   Recordings mask every input; nothing loads before analytics consent. A visitor who withdrew consent
//   earlier and now gives it again is opted back in.
// - Converge pixel (marketing attribution): the official snippet, but only after marketing consent.
//   Converge wants the choice before the first track call, on every page load and again when it changes
//   (docs.runconverge.com/sources/consent). The stub queues calls until the pixel script has loaded,
//   then hands them to cvg.process.
// - GTM, PostHog and Converge load when the page is idle, so they never compete with LCP.
// - When localStorage is blocked, the choice applies to the current page view only.
// - On a phone the banner stays low (about a quarter of the screen), so the page and the buy button stay usable.
//   The title is for screen readers only, the categories open on "kies zelf", and refusing is one tap,
//   just like accepting. On a product page it sits above the sticky buy bar.
import { SITE } from '@/lib/site';
---

<div
  id="consent-banner"
  hidden
  role="dialog"
  aria-labelledby="consent-title"
  aria-live="polite"
  class="fixed inset-x-2 bottom-2 z-50 mx-auto max-w-xl rounded-2xl bg-white p-3 shadow-2xl ring-1 ring-line sm:inset-x-3 sm:bottom-3 sm:p-5"
>
  <p id="consent-title" class="font-display text-lg max-sm:sr-only">
    Cookies, maar dan met mate
  </p>
  <p class="text-sm sm:mt-2">
    <span class="max-sm:hidden">We gebruiken noodzakelijke cookies om de site te laten werken.</span> Met jouw
    toestemming gebruiken we <span class="max-sm:hidden">ook</span> analytische en marketingcookies<span class="max-sm:hidden"
      >{' '}om de site te verbeteren en relevante advertenties te tonen</span
    >. Meer info in ons{' '}
    <a href="/privacybeleid/" class="text-brand underline">
      privacybeleid
    </a><span class="sm:hidden"
      >{' '}of <button type="button" data-consent-more class="underline">kies zelf</button></span
    >.
  </p>
  <form class="mt-2 space-y-2 text-sm sm:mt-3" data-consent-form>
    <div class="space-y-2 max-sm:hidden" data-consent-extra>
      <label class="flex items-center gap-2 text-muted">
        <input type="checkbox" checked disabled class="size-4 accent-brand" /> Noodzakelijk (altijd aan)
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="analytics" class="size-4 accent-brand" /> Analytisch
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="marketing" class="size-4 accent-brand" /> Marketing
      </label>
    </div>
    <div class="flex flex-wrap gap-2 sm:pt-2">
      <button type="button" data-consent="all" class="btn-primary min-h-10 flex-1 py-2 max-sm:px-3 max-sm:text-sm">
        Alles accepteren
      </button>
      <button type="submit" class="btn-outline min-h-10 flex-1 py-2 max-sm:hidden" data-consent-extra>
        Keuze opslaan
      </button>
      <button type="button" data-consent="none" class="btn-outline min-h-10 flex-1 py-2 max-sm:px-3 max-sm:text-sm">
        Weigeren
      </button>
    </div>
  </form>
</div>

<style is:global>
  /* The sticky buy bar on a product page (ProductPage.astro, below md) stays visible above the banner. */
  @media (width < 48rem) {
    body:has([data-sticky-buy]:not([hidden])) #consent-banner {
      bottom: 5rem;
    }
  }
</style>

<script is:inline define:vars={{ gtmId: SITE.gtmId, posthogKey: SITE.posthogKey, convergePixelId: SITE.convergePixelId }}>
  (() => {
    const KEY = 'flavory-consent-v1';
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      // eslint-disable-next-line prefer-rest-params
      window.dataLayer.push(arguments);
    }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });

    let loaded = false;
    const loadGtm = () => {
      if (loaded || !gtmId) return;
      loaded = true;
      window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
      document.head.appendChild(s);
    };

    let posthogLoaded = false;
    const loadPosthog = () => {
      if (posthogLoaded || !posthogKey) return;
      posthogLoaded = true;
      const s = document.createElement('script');
      s.async = true;
      s.src = '/ingest/static/array.js';
      s.onload = () => {
        if (!window.posthog) return;
        window.posthog.init(posthogKey, {
          api_host: '/ingest',
          ui_host: 'https://eu.posthog.com',
          person_profiles: 'identified_only',
          capture_pageview: true,
          capture_pageleave: true,
          autocapture: true,
          enable_heatmaps: true,
          capture_dead_clicks: true,
          capture_performance: { web_vitals: true },
          capture_exceptions: true,
          session_recording: { maskAllInputs: true, maskTextSelector: '[data-ph-mask]' },
          loaded: (ph) => {
            if (ph.has_opted_out_capturing()) ph.opt_in_capturing();
            for (const [event, props] of window.flavoryAnalyticsQueue || []) ph.capture(event, props);
            window.flavoryAnalyticsQueue = [];
          },
        });
      };
      document.head.appendChild(s);
    };

    let convergeLoaded = false;
    const convergeConsent = (c) => {
      window.cvg({
        method: 'consent',
        analytics: c.analytics ? 'granted' : 'denied',
        marketing: c.marketing ? 'granted' : 'denied',
      });
    };
    const loadConverge = (c) => {
      if (convergeLoaded || !convergePixelId) return;
      convergeLoaded = true;
      if (!window.cvg) {
        const cvg = (...args) => {
          if (cvg.process) cvg.process(...args);
          else cvg.queue.push(args);
        };
        cvg.queue = [];
        window.cvg = cvg;
      }
      convergeConsent(c);
      window.cvg({ method: 'track', eventName: '$page_load' });
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://static.runconverge.com/pixels/' + convergePixelId + '.js';
      document.head.appendChild(s);
    };

    const apply = (c) => {
      window.flavoryConsent = { analytics: !!c.analytics, marketing: !!c.marketing };
      if (c.analytics) {
        ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(loadPosthog);
      } else {
        window.flavoryAnalyticsQueue = [];
        if (window.posthog && window.posthog.__loaded) window.posthog.opt_out_capturing();
      }
      gtag('consent', 'update', {
        analytics_storage: c.analytics ? 'granted' : 'denied',
        ad_storage: c.marketing ? 'granted' : 'denied',
        ad_user_data: c.marketing ? 'granted' : 'denied',
        ad_personalization: c.marketing ? 'granted' : 'denied',
      });
      if (c.analytics || c.marketing) ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(loadGtm);
      if (convergeLoaded) convergeConsent(c);
      else if (c.marketing) ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(() => loadConverge(c));
    };

    let stored = null;
    try {
      stored = JSON.parse(localStorage.getItem(KEY) || 'null');
    } catch {
      stored = null;
    }
    if (stored) apply(stored);

    const save = (c) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(c));
      } catch {
        /* storage blocked */
      }
      apply(c);
      document.getElementById('consent-banner').hidden = true;
    };

    document.addEventListener('DOMContentLoaded', () => {
      const banner = document.getElementById('consent-banner');
      const form = banner.querySelector('[data-consent-form]');
      if (stored) {
        form.analytics.checked = !!stored.analytics;
        form.marketing.checked = !!stored.marketing;
      } else {
        banner.hidden = false;
      }
      const showChoices = () => {
        for (const el of banner.querySelectorAll('[data-consent-extra]')) el.classList.remove('max-sm:hidden');
      };
      banner.addEventListener('click', (e) => {
        if (e.target.closest('[data-consent-more]')) showChoices();
        const choice = e.target.closest('[data-consent]');
        if (!choice) return;
        const all = choice.getAttribute('data-consent') === 'all';
        save({ analytics: all, marketing: all, ts: Date.now() });
      });
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        save({ analytics: form.analytics.checked, marketing: form.marketing.checked, ts: Date.now() });
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest('[data-consent-open]')) return;
        showChoices();
        banner.hidden = false;
      });
    });
  })();
</script>
