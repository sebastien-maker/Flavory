---
import { NAV } from '@/lib/site';
import CartIcon from '@/assets/icons/cart.svg';

interface Props {
  /** The page opens with a dark zone (running promotion): the header is black too, with the white logo. */
  dark?: boolean;
}

const { dark = false } = Astro.props;
const current = Astro.url.pathname;
// Round buttons (cart, menu): black line on cream, white line on black.
const ring = dark ? 'border-white text-white hover:bg-white hover:text-ink' : 'border-ink text-ink hover:bg-ink hover:text-white';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header
  class:list={[
    'relative sticky top-0 z-40 border-b backdrop-blur',
    dark ? 'header-dark' : 'border-transparent bg-cream/95 supports-[backdrop-filter]:bg-cream/80',
  ]}
>
  <div class="container-site flex h-14 items-center justify-between gap-4 md:h-24">
    <a href="/" class="shrink-0">
      <img
        src={dark ? '/images/logo-white.svg' : '/images/logo.svg'}
        alt="Flavory, naar de homepage"
        width="182"
        height="56"
        class="h-[25px] w-auto md:h-14"
      />
    </a>

    <nav aria-label="Hoofdmenu" class="hidden md:block">
      <ul class="flex items-center gap-3 lg:gap-4">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-pill', item.href === '/shop/' ? 'nav-pill-shop' : dark && 'nav-pill-dark']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-cart-open
        class:list={['relative flex size-11 items-center justify-center rounded-full border-2 transition-colors md:size-12', ring]}
        aria-label="Winkelmandje openen"
      >
        <CartIcon class="size-6 fill-current md:size-7" aria-hidden="true" />
        <span
          data-cart-count
          hidden
          class="absolute -top-1 -right-1 flex size-5 items-center justify-center rounded-full bg-brand text-xs font-bold text-white"
        ></span>
      </button>

      <details class="group md:hidden">
        <summary
          class:list={[
            'flex size-11 cursor-pointer list-none items-center justify-center rounded-full border-2 [&::-webkit-details-marker]:hidden',
            dark ? 'border-white' : 'border-ink',
          ]}
          aria-label="Menu"
        >
          <svg class="size-5 group-open:hidden" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <svg class="hidden size-5 group-open:block" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </summary>
        <nav
          aria-label="Mobiel menu"
          class="absolute inset-x-0 top-full border-t border-line bg-cream px-4 pt-4 pb-8 text-ink shadow-lg"
        >
          <ul class="flex flex-col gap-3">
            {NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-pill w-full', item.href === '/shop/' && 'nav-pill-shop']}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
