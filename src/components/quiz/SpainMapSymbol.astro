---
// The outline of Spain, defined once per page and drawn by every SpainMap through <use>.
import { MAP_HEIGHT, MAP_WIDTH, PORTUGAL_PATH, SPAIN_PATH } from '@/lib/quiz/iberia';
---

<svg class="absolute size-0 overflow-hidden" aria-hidden="true" focusable="false">
  <symbol id="map-iberia" viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}>
    <path d={PORTUGAL_PATH} fill="#ede4da" stroke="#4a4a4a" stroke-width="1" vector-effect="non-scaling-stroke"></path>
    <path
      d={SPAIN_PATH}
      fill="#ffffff"
      stroke="#000000"
      stroke-width="1.5"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    ></path>
  </symbol>
</svg>
