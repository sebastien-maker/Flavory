---
// The wine game next to the two gifts people weigh it against (after the "real vs fake" table on realmadhoney.eu).
// Every row must stay true for each column: the same comparison as the text list on /cadeau/.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const COLUMNS = ['Flavory', 'Fles wijn', 'Wijncursus'];
const ROWS: [string, ...boolean[]][] = [
  ['Je speelt samen, met 2 tot 6 mensen', true, false, true],
  ['Thuis, op de avond die jou past', true, true, false],
  ['Je leert proeven, zonder voorkennis', true, false, true],
  ['Een spel met een winnaar', true, false, false],
];
---

<section class:list={['section-y bg-white', className]} aria-labelledby="vergelijk-title">
  <div class="container-site max-w-3xl text-center">
    <p class="eyebrow">Waarom het wijnspel</p>
    <h2 id="vergelijk-title" class="h2 mt-2">Wijnspel, fles wijn of wijncursus?</h2>
    <table class="compare">
      <thead>
        <tr>
          <td></td>
          {COLUMNS.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map(([label, ...cells]) => (
            <tr>
              <th scope="row">{label}</th>
              {cells.map((yes) => (
                <td class={yes ? 'yes' : 'no'}>
                  <span class="sr-only">{yes ? 'Ja' : 'Nee'}</span>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="mt-6">Geen fles die in de kast belandt, maar een avond waar iedereen aan meedoet.</p>
  </div>
</section>
