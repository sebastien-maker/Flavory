---
interface Props {
  class?: string;
}

const { class: className = 'section-y' } = Astro.props;
const items = ['Gratis verzending vanaf 2 boxen', 'Voor 12u besteld, vandaag verzonden', 'Niet tevreden? Geld terug'];
---

<section class={className} aria-labelledby="garanties-title">
  <div class="container-site">
    <h2 id="garanties-title" class="sr-only">
      Onze garanties
    </h2>
    <ul class="grid gap-2 md:grid-cols-3 md:gap-3">
      {items.map((item) => (
        <li class="card flex items-center gap-3 px-4 py-3 font-bold">
          <svg class="check size-6" viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M4 10.5l4 4 8-9"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
