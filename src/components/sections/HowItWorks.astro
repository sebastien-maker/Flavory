---
import { STEPS } from '@/lib/steps';

interface Props {
  heading?: string;
  headingLevel?: 'h2' | 'h3';
  id?: string;
  showCta?: boolean;
  detailed?: boolean;
}

const {
  heading = 'Hoe werkt het?',
  headingLevel: Heading = 'h2',
  id = 'hoe-werkt-het',
  showCta = true,
  detailed = false,
} = Astro.props;
---

<section id={id} class="container-site scroll-mt-28 py-12 md:py-20" aria-labelledby={`${id}-title`}>
  <Heading id={`${id}-title`} class="h2 text-center">
    {heading}
  </Heading>
  <ol class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
    {STEPS.map((step, i) => (
      <li class="step-card">
        <img src={step.img} alt="" width="400" height="344" class="h-auto w-full" loading="lazy" decoding="async" />
        <p class="mt-2 font-bold">
          <span class="sr-only">Stap {i + 1}: </span>
          {step.title}
        </p>
        {detailed && <p class="mt-1 text-sm text-white/90">{step.text}</p>}
      </li>
    ))}
  </ol>
  {showCta && (
    <p class="mt-8 text-center">
      <a href="/hoe-werkt-het/" class="btn-outline">
        Lees hoe het spel werkt
      </a>
    </p>
  )}
</section>
