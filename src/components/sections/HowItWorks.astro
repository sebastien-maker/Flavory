---
import { STEPS } from '@/lib/steps';

interface Props {
  heading?: string;
  headingLevel?: 'h2' | 'h3';
  id?: string;
  detailed?: boolean;
  /** Optional link under the steps, e.g. to the full game rules. */
  link?: { href: string; label: string };
}

const {
  heading = 'Hoe werkt het?',
  headingLevel: Heading = 'h2',
  id = 'hoe-werkt-het',
  detailed = false,
  link,
} = Astro.props;
---

<section id={id} class="section-y container-site scroll-mt-28" aria-labelledby={`${id}-title`}>
  <Heading id={`${id}-title`} class="h2 text-center">
    {heading}
  </Heading>
  <!-- One numbered list, each step under the other, with a small drawing. -->
  <ol class="mx-auto mt-6 max-w-2xl divide-y divide-line">
    {STEPS.map((step, i) => (
      <li class="flex items-center gap-4 py-3">
        <span class="step-number" aria-hidden="true">{i + 1}</span>
        <img src={step.img} alt="" width="400" height="344" class="h-12 w-14 shrink-0 object-contain" loading="lazy" decoding="async" />
        <div class="min-w-0">
          <p class="font-bold">
            <span class="sr-only">Stap {i + 1}: </span>
            {step.title}
          </p>
          {detailed && <p class="mt-1 text-sm text-muted">{step.text}</p>}
        </div>
      </li>
    ))}
  </ol>
  {link && (
    <p class="mt-4 text-center">
      <a href={link.href} class="font-bold text-brand underline">
        {link.label}
      </a>
    </p>
  )}
</section>
