---
// Netlify Forms: submissions appear under Forms > nieuwsbrief. Connect to the mailing tool later.
---

<section class="section-y container-site" aria-labelledby="newsletter-title">
  <div class="rounded-[var(--radius-card)] bg-white p-6 shadow-sm ring-1 ring-line md:p-10">
    <div class="grid gap-6 md:grid-cols-2 md:items-center">
      <div>
        <h2 id="newsletter-title" class="h3">
          Schrijf je in voor de nieuwsbrief
        </h2>
      </div>
      <form
        name="nieuwsbrief"
        method="POST"
        action="/bedankt/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-3"
      >
        <input type="hidden" name="form-name" value="nieuwsbrief" />
        <p hidden>
          <label>
            Niet invullen: <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>
        <div class="flex flex-col gap-2 sm:flex-row">
          <label class="sr-only" for="newsletter-email">
            E-mailadres
          </label>
          <input
            id="newsletter-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="jouw@email.be"
            class="min-h-12 flex-1 rounded-full border-2 border-ink bg-white px-5"
          />
          <button type="submit" class="btn-primary">
            Inschrijven
          </button>
        </div>
        <label class="flex items-start gap-2 text-xs">
          <input type="checkbox" name="toestemming" required class="mt-0.5 size-4 accent-brand" />
          <span>
            Ik wil de nieuwsbrief ontvangen en ga akkoord met het{' '}
            <a href="/privacybeleid/" class="underline">
              privacybeleid
            </a>
            . Uitschrijven kan altijd.
          </span>
        </label>
      </form>
    </div>
  </div>
</section>
