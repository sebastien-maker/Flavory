---
import { getReviews } from '@/lib/content';
import Stars from '@/components/ui/Stars.astro';
import RatingBadge from '@/components/ui/RatingBadge.astro';

interface Props {
  heading?: string;
  limit?: number;
  /** Pick specific reviews by file name, in this order. */
  authors?: string[];
  /** One line under the reviews, e.g. the guarantee. */
  note?: string;
  class?: string;
}

const {
  heading = 'Wat spelers zeggen',
  limit = 3,
  authors,
  note,
  class: className = 'section-y bg-blush',
} = Astro.props;
const all = await getReviews();
const reviews = authors
  ? authors.flatMap((id) => all.filter((r) => r.id === id))
  : all.slice(0, limit);
---

<section class={className} aria-labelledby="reviews-title">
  <div class="container-site">
    <h2 id="reviews-title" class="h2 text-center">
      {heading}
    </h2>
    <div class="mt-3 flex justify-center">
      <RatingBadge />
    </div>
    <ul class="mt-6 grid items-start gap-3 md:grid-cols-3 md:gap-4">
      {reviews.map(({ data }) => (
        <li>
          <figure class="card p-4 md:p-5">
            <div class="flex items-center gap-2">
              <Stars rating={data.rating} />
              <span class="text-sm font-bold">{data.rating}/5</span>
            </div>
            <blockquote class="mt-2 text-sm">
              {data.title && <p class="font-bold">{data.title}</p>}
              <p class="mt-1 line-clamp-4">{data.body}</p>
            </blockquote>
            <figcaption class="mt-2 text-sm font-bold">{data.author}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    {note && <p class="mt-4 text-center font-bold">{note}</p>}
    <p class="mt-4 text-center">
      <a href="/reviews/" class="btn-outline">
        Alle reviews
      </a>
    </p>
  </div>
</section>
