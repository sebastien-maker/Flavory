---
import { getReviews } from '@/lib/content';
import Stars from '@/components/ui/Stars.astro';
import TrustpilotBadge from '@/components/ui/TrustpilotBadge.astro';

interface Props {
  heading?: string;
  limit?: number;
}

const { heading = 'Wat spelers zeggen', limit = 6 } = Astro.props;
const reviews = (await getReviews()).slice(0, limit);
---

<section class="bg-blush py-12 md:py-20" aria-labelledby="reviews-title">
  <div class="container-site">
    <h2 id="reviews-title" class="h2 text-center">
      {heading}
    </h2>
    <div class="mt-4 flex justify-center">
      <TrustpilotBadge />
    </div>
    <ul class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 md:grid md:grid-cols-3 md:overflow-visible">
      {reviews.map(({ data }) => (
        <li class="review-slide">
          <figure class="card flex h-full flex-col p-6">
            <div class="flex items-center gap-2">
              <Stars rating={data.rating} />
              <span class="text-sm font-bold">{data.rating}/5</span>
            </div>
            <blockquote class="mt-3 flex-1 text-sm">
              {data.title && <p class="font-bold">{data.title}</p>}
              <p class="mt-1">{data.body}</p>
            </blockquote>
            <figcaption class="mt-4 font-bold">{data.author}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-center">
      <a href="/reviews/" class="btn-outline">
        Alle reviews
      </a>
    </p>
  </div>
</section>
