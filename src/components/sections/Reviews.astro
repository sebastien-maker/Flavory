---
import { getReviews } from '@/lib/content';
import Stars from '@/components/ui/Stars.astro';
import TrustpilotBadge from '@/components/ui/TrustpilotBadge.astro';

interface Props {
  heading?: string;
  limit?: number;
  class?: string;
}

const { heading = 'Wat spelers zeggen', limit = 6, class: className = 'section-y bg-blush' } = Astro.props;
const reviews = (await getReviews()).slice(0, limit);
---

<section class={className} aria-labelledby="reviews-title">
  <div class="container-site">
    <h2 id="reviews-title" class="h2 text-center">
      {heading}
    </h2>
    <div class="mt-3 flex justify-center">
      <TrustpilotBadge />
    </div>
    <ul class="mt-6 flex snap-x snap-mandatory items-start gap-3 overflow-x-auto pb-3 md:grid md:grid-cols-3 md:gap-4 md:overflow-visible">
      {reviews.map(({ data }) => (
        <li class="review-slide">
          <figure class="card p-4 md:p-5">
            <div class="flex items-center gap-2">
              <Stars rating={data.rating} />
              <span class="text-sm font-bold">{data.rating}/5</span>
            </div>
            <blockquote class="mt-2 text-sm">
              {data.title && <p class="font-bold">{data.title}</p>}
              <p class="mt-1 line-clamp-4">{data.body}</p>
            </blockquote>
            <figcaption class="mt-2 text-sm font-bold">{data.author}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-center">
      <a href="/reviews/" class="btn-outline">
        Alle reviews
      </a>
    </p>
  </div>
</section>
