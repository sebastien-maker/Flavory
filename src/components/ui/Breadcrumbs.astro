---
// Visible breadcrumb trail; pair with breadcrumbs() schema using the same items.
interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Kruimelpad" class="container-site pt-4 text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-muted">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1 ? (
          <span aria-current="page" class="text-ink">
            {item.name}
          </span>
        ) : (
          <a href={item.path} class="hover:text-brand hover:underline">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
