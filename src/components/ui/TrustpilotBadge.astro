---
import { SITE } from '@/lib/site';
import Stars from './Stars.astro';

interface Props {
  tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;
const score = String(SITE.rating.value).replace('.', ',');
---

<a
  href={SITE.social.trustpilot}
  rel="noopener"
  class:list={[
    'inline-flex flex-wrap items-center gap-2 text-sm hover:underline',
    tone === 'light' ? 'text-white' : 'text-ink',
  ]}
>
  <Stars rating={SITE.rating.value} class="text-lg" />
  <span>
    <strong>{score}/5</strong> op basis van {SITE.rating.count} reviews op
  </span>
  <img
    src={tone === 'light' ? '/images/trustpilot-white.svg' : '/images/trustpilot-dark.svg'}
    alt="Trustpilot"
    width="67"
    height="30"
    loading="lazy"
    decoding="async"
    class="h-6 w-auto"
  />
</a>
