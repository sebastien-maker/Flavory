---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import { SITE } from '@/lib/site';
import { breadcrumbs, webPage } from '@/components/seo/schema';

const path = '/contact/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path },
];
const title = 'Contact: vragen over je wijnbox of samenwerken';
const description =
  'Een vraag over je wijnbox of wil je Flavory verkopen in je winkel? Neem contact op via het formulier of info@flavory.wine. We antwoorden snel.';
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={[webPage({ path, title, description, type: 'ContactPage' }), breadcrumbs(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <section class="container-site grid gap-10 py-8 md:grid-cols-[2fr_1fr] md:py-12">
    <div>
      <h1 class="h1">Vragen over de wijnboxen of zin in een samenwerking?</h1>
      <p class="lead mt-4">Vul het contactformulier in of mail naar {SITE.email}. We helpen je snel verder.</p>
      <div class="mt-8 rounded-[var(--radius-card)] bg-white p-6 ring-1 ring-line md:p-8">
        <ContactForm name="contact" />
      </div>
    </div>
    <aside class="space-y-6">
      <div class="rounded-[var(--radius-card)] bg-blush p-6">
        <h2 class="h4">Flavory BV</h2>
        <address class="mt-3 not-italic">
          {SITE.address.street}
          <br />
          {SITE.address.postalCode}
          {SITE.address.city}
          <br />
          België
        </address>
        <p class="mt-3">
          <a href={`mailto:${SITE.email}`} class="font-bold text-brand underline">
            {SITE.email}
          </a>
        </p>
        <p class="mt-3 text-sm">BTW BE 0757.810.421</p>
      </div>
      <div class="rounded-[var(--radius-card)] bg-white p-6 ring-1 ring-line">
        <h2 class="h4">Snel een antwoord?</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href="/faq/" class="text-brand underline">
              Veelgestelde vragen
            </a>
          </li>
          <li>
            <a href="/verzending-en-retour/" class="text-brand underline">
              Verzending en retour
            </a>
          </li>
          <li>
            <a href="/wijnkiezer/" class="text-brand underline">
              Welke wijn koop ik bij mijn spel?
            </a>
          </li>
          <li>
            <a href="/zakelijk/" class="text-brand underline">
              Offerte voor bedrijven
            </a>
          </li>
        </ul>
      </div>
      <div class="rounded-[var(--radius-card)] bg-white p-6 ring-1 ring-line">
        <h2 class="h4">Wijnhandelaar?</h2>
        <p class="mt-3 text-sm">
          We werken samen met wijnhandelaars, drankenhandels en bedrijven, met onze wijnen of met jouw eigen selectie.
          Laat het ons weten via het formulier. Bekijk ook onze{' '}
          <a href="/verkooppunten/" class="text-brand underline">
            verkooppunten
          </a>
          .
        </p>
      </div>
    </aside>
  </section>
</BaseLayout>
