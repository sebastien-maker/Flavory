---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BoxShelf from '@/components/commerce/BoxShelf.astro';
import Reviews from '@/components/sections/Reviews.astro';
import PostCard from '@/components/blog/PostCard.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import LazyVideo from '@/components/ui/LazyVideo.astro';
import RatingBadge from '@/components/ui/RatingBadge.astro';
import ShippingCutoff from '@/components/ui/ShippingCutoff.astro';
import Price from '@/components/commerce/Price.astro';
import { fromPrice, getProducts, getPosts, mainProducts, productPath } from '@/lib/content';
import { SITE } from '@/lib/site';
import { itemList, webPage } from '@/components/seo/schema';
// The first screen shows what you buy: the box with the two bottles in their bags.
import heroPhoto from '@/assets/images/products/packshot-rood-zakjes.jpg';
import clipPoster from '@/assets/images/site/flavory-avond-vrienden-poster.jpg';
import giftPhoto from '@/assets/images/site/cadeau-uitpakken.jpg';
// Drawing under the steps; it also sits on the box sleeve.
import sleeveIllustration from '@/assets/images/site/sleeve-illustratie.webp';

const allProducts = await getProducts();
const products = mainProducts(allProducts);
const lowestPrice = Math.min(...products.map(fromPrice));
// Only set while WooCommerce has a sale price: the price before the discount, shown struck through.
const lowestRegular = products.flatMap((p) => p.data.variants).find((v) => v.price === lowestPrice)?.regularPrice;
// Running promotion (SITE.campaign): the offer sits right under the headline and the button names it.
const promo = SITE.campaign === 'blackfriday' && SITE.blackFriday.offer;
// Pillar-first: the three strongest evergreen articles (SITE-STRUCTURE §5).
const featuredIds = ['blind-wijn-proeven', 'wijnproeverij-thuis-flavory', 'welke-wijn-bij-welk-gerecht-spiekbriefje'];
const posts = (await getPosts()).filter((p) => featuredIds.includes(p.id));

const title = 'Wijnspel: proef twee wijnen blind met vrienden | Flavory';
const description =
  'Flavory is het wijnspel met twee flessen wijn erbij: proef ze blind, beantwoord de quizvragen en ontdek wie het verschil proeft. Voor 2 tot 6 spelers.';

const hero = await getImage({ src: heroPhoto, width: 900, widths: [360, 540, 720, 900], format: 'webp' });
const heroSizes = '(min-width: 1024px) 34rem, (min-width: 768px) 46vw, calc(100vw - 2rem)';
// Three steps, with the drawings that also sit on the box.
const steps = [
  {
    img: '/images/steps/stap-2.svg',
    title: 'Schenk blind in',
    text: 'De twee flessen zitten in stoffen zakjes. Niemand weet welke wijn in fles A of B zit.',
  },
  {
    img: '/images/steps/stap-3.svg',
    title: 'Proef en speel',
    text: 'Kijk, ruik en proef, en verzamel tips met de quizvragen.',
  },
  {
    img: '/images/steps/stap-5.svg',
    title: 'Ontmasker de wijnen',
    text: 'Noteer je gok, onthul de flessen en kroon de winnaar.',
  },
];
// What a gift buyer wants to know before ordering. The facts come from SITE; the last order day for the
// season only shows once SITE.giftDeadline is filled in.
const { minDays, maxDays } = SITE.shipping;
const gifting = [
  {
    title: 'Rechtstreeks naar de ontvanger',
    text: 'Vul bij het afrekenen het adres van de ontvanger in. Jij krijgt de bevestiging en het trackingnummer.',
  },
  {
    title: 'Op tijd',
    text: `Bestel je op een werkdag voor ${SITE.shippingCutoffHour}u, dan vertrekt je pakket dezelfde dag. Levering duurt meestal ${minDays} tot ${maxDays} werkdagen in België en Nederland.${
      SITE.giftSeason && SITE.giftDeadline ? ` Laatste besteldag voor ${SITE.giftSeason}: ${SITE.giftDeadline}.` : ''
    }`,
  },
  {
    title: 'Zonder risico',
    text: SITE.guarantee,
  },
];
---

<BaseLayout
  title={title}
  isHome
  description={description}
  path="/"
  preloadImage={{ src: hero.src, srcset: hero.srcSet.attribute, sizes: heroSizes }}
  schema={[
    webPage({ path: '/', title, description }),
    itemList(
      '/',
      products.map((p) => ({ name: p.data.name, path: productPath(p.id) })),
    ),
  ]}
>
  <!-- Block 1: what it is, the offer, the box, the price and one button. On a phone the box comes right
       after the headline, so it is in the first screen; from md up it stands next to the text. -->
  <section class="container-site grid gap-x-10 gap-y-4 pt-4 pb-8 md:grid-cols-2 md:py-12">
    <h1 class="h1-hero md:col-start-1 md:row-start-1 md:self-end">
      Het wijnspel: twee wijnen blind proeven, thuis aan tafel
    </h1>
    <img
      src={hero.src}
      srcset={hero.srcSet.attribute}
      sizes={heroSizes}
      width={hero.attributes.width}
      height={hero.attributes.height}
      alt="Rood wijnspel: de doos met twee flessen wijn in stoffen zakjes A en B"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="hero-box md:col-start-2 md:row-span-2 md:row-start-1 md:self-center"
    />
    <div class="flex flex-col md:col-start-1 md:row-start-2 md:self-start">
      <p class="order-4 mt-5 text-lg leading-snug md:order-1 md:mt-0 md:text-xl">
        Het leukste cadeau voor iedereen die van wijn houdt. Met twee flessen wijn (75 cl) erbij, voor een avond met 2
        tot 6 spelers.
      </p>
      {
        promo && (
          <p class="order-1 text-xl leading-tight font-bold text-brand md:order-2 md:mt-5">
            {promo}
            {SITE.blackFriday.endDate && (
              <span class="mt-1 block text-base text-ink">Tot en met {SITE.blackFriday.endDate}.</span>
            )}
          </p>
        )
      }
      <p class="order-2 mt-3 text-sm md:order-3">
        Vanaf{' '}
        <strong class="text-xl">
          <Price price={lowestPrice} regularPrice={lowestRegular} />
        </strong>
      </p>
      <div class="order-3 mt-3 md:order-4">
        <a href="#kies-je-box" class="btn-primary">
          {promo ? 'Bestel met korting' : 'Kies je box'}
        </a>
      </div>
      <div class="order-5 mt-4 grid gap-1 text-sm">
        <ShippingCutoff class="font-bold" />
        <p>Gratis verzending vanaf {SITE.shipping.freeFromBoxes} boxen</p>
        <RatingBadge class="mt-1" />
      </div>
    </div>
  </section>

  <!-- Block 2: what Flavory is, in five plain sentences, next to the drawing that is also on the box. -->
  <section id="wat-is-flavory" class="section-y scroll-mt-24 bg-white" aria-labelledby="wat-title">
    <div class="container-site grid items-center gap-8 md:grid-cols-2 md:gap-12">
      <div>
        <h2 id="wat-title" class="h2">
          Wat is Flavory?
        </h2>
        <div class="mt-4 grid max-w-xl gap-3 text-lg leading-snug">
          <p>Flavory is een Belgisch wijnspel: een wijnproeverij thuis, in spelvorm.</p>
          <p>
            In het pakket zitten het spel en twee flessen wijn (75 cl), elk in een stoffen zakje met een A of een B.
          </p>
          <p>Je schenkt ze blind uit, proeft samen en raadt met de quizvragen welke wijn welke is.</p>
          <p>Je hebt alleen glazen, een kurkentrekker en 2 tot 6 spelers nodig. Voorkennis van wijn hoeft niet.</p>
          <p>Goed voor een avond van 60 tot 90 minuten, of als cadeau voor iemand die van wijn houdt.</p>
        </div>
      </div>
      <Image
        src={sleeveIllustration}
        alt="Tekening van vier vrienden die samen wijn proeven"
        widths={[320, 480, 640, 960]}
        sizes="(min-width: 768px) 34rem, calc(100vw - 2rem)"
        class="mx-auto h-auto w-full max-w-[34rem]"
      />
    </div>
  </section>

  <!-- Block 3: the boxes, each with its price and a button that puts it straight into the cart. -->
  <section id="kies-je-box" class="section-y scroll-mt-24 bg-blush" aria-labelledby="boxen-title">
    <div class="container-site">
      <BoxShelf products={allProducts} />
    </div>
  </section>

  <!-- Block 4: how it works. The clip of an evening next to three steps, each with its drawing from the box. -->
  <section id="hoe-werkt-het" class="section-y scroll-mt-24" aria-labelledby="spelen-title">
    <div class="container-site">
      <h2 id="spelen-title" class="h2 text-center">
        Een wijnproeverij thuis, in drie stappen
      </h2>
      <div class="mt-6 grid items-center gap-6 md:grid-cols-2 md:gap-10">
        <!-- Mood clip, only loaded once it scrolls into view. -->
        <LazyVideo
          src="/media/flavory-avond-vrienden.mp4"
          poster={clipPoster}
          label="Sfeerbeelden: vrienden proeven samen wijn aan een tafel met kaarsen"
          class="aspect-video w-full rounded-[var(--radius-card)] object-cover"
        />
        <ol class="divide-y divide-line">
          {steps.map((step, i) => (
            <li class="flex items-center gap-4 py-4">
              {/* The drawings carry their own white step number (of the six-step set); on a white tile,
                  cropped from the right, only the drawing shows. */}
              <img
                src={step.img}
                alt=""
                width="400"
                height="344"
                loading="lazy"
                decoding="async"
                class="size-24 shrink-0 rounded-2xl bg-white object-cover object-right p-2 md:size-28"
              />
              <div class="min-w-0">
                <p class="flex items-center gap-2 text-lg font-bold">
                  <span class="step-number" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span class="sr-only">Stap {i + 1}: </span>
                  {step.title}
                </p>
                <p class="mt-1 text-muted">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <p class="mt-6 text-center font-bold">2 tot 6 spelers · 60 tot 90 minuten · geen wijnkennis nodig</p>
      <p class="mt-4 text-center">
        <a href="/hoe-werkt-het/" class="btn-outline">
          De spelregels in 6 stappen
        </a>
      </p>
    </div>
  </section>

  <!-- Block 5: giving it as a present. The gift buyer is the main buyer: what they worry about, answered. -->
  <section id="cadeau" class="scroll-mt-24 bg-white" aria-labelledby="cadeau-title">
    <div class="section-y container-site">
      <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
        <div>
          <h2 id="cadeau-title" class="h2">
            Zo geef je het wijnspel cadeau
          </h2>
          <ul class="mt-4 divide-y divide-line">
            {gifting.map((item) => (
              <li class="py-4">
                <h3 class="font-sans text-lg font-bold">{item.title}</h3>
                <p class="mt-1">{item.text}</p>
              </li>
            ))}
          </ul>
          <p class="mt-4">
            <a href="/cadeau/" class="btn-outline">
              Alles over cadeau geven
            </a>
          </p>
          <p class="mt-4 text-sm">
            Voor je team of je klanten?{' '}
            <a href="/zakelijk/" class="font-bold underline">
              Zakelijk bestellen
            </a>
          </p>
        </div>
        <Image
          src={giftPhoto}
          alt="Iemand pakt een Flavory-wijnspel uit het cadeaupapier"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 45vw, calc(100vw - 2rem)"
          class="aspect-[4/3] w-full rounded-[var(--radius-card)] object-cover md:aspect-[5/4]"
        />
      </div>
    </div>
  </section>

  <Reviews heading="Spelers aan het woord" authors={['ingrid', 'nele', 'charlotte']} note={SITE.guarantee} />

  <!-- Blog -->
  <section class="section-y bg-white" aria-labelledby="blog-title">
    <div class="container-site">
      <h2 id="blog-title" class="h2 text-center">
        Meer weten over wijn?
      </h2>
      <p class="mx-auto mt-2 max-w-2xl text-center">Lees onze blogs over proeven, druiven en wijn aan tafel.</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {posts.map((post) => (
          <li>
            <PostCard post={post} compact />
          </li>
        ))}
      </ul>
      <p class="mt-6 text-center">
        <a href="/blog/" class="btn-outline">
          Alle blogberichten
        </a>
      </p>
    </div>
  </section>

  <Newsletter heading="Proeftips en nieuwe duels in je mailbox" />
</BaseLayout>
