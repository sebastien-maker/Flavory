---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/commerce/ProductCard.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Guarantees from '@/components/sections/Guarantees.astro';
import Reviews from '@/components/sections/Reviews.astro';
import PostCard from '@/components/blog/PostCard.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import Stars from '@/components/ui/Stars.astro';
import { fromPrice, getProducts, getPosts, productPath } from '@/lib/content';
import { SITE, formatPrice } from '@/lib/site';
import { itemList, webPage } from '@/components/seo/schema';
// Hero image: replace this one file (keep the name) to swap the illustration for a photo.
import heroImage from '@/assets/images/site/hero.webp';
import friendsImage from '@/assets/images/site/vriendinnen-openen-box.jpg';
import loopPoster from '@/assets/images/site/flavory-loop-poster.webp';

const products = await getProducts();
const red = products.find((p) => p.data.category.id === 'rode-wijn');
const white = products.find((p) => p.data.category.id === 'witte-wijn');
const minPrice = Math.min(...products.map(fromPrice));
// Pillar-first: the three strongest evergreen articles (SITE-STRUCTURE §5).
const featuredIds = ['blind-wijn-proeven', 'wijnproeverij-thuis-flavory', 'welke-wijn-bij-welk-gerecht-spiekbriefje'];
const posts = (await getPosts()).filter((p) => featuredIds.includes(p.id));

const title = 'Wijnproeverij thuis: het wijnspel voor vrienden | Flavory';
const description =
  'Flavory is het wijnspel voor een wijnproeverij thuis: proef blind twee wijnen, beantwoord quizvragen en ontdek wie de wijnkenner is. Voor 2 tot 6 spelers.';

const hero = await getImage({ src: heroImage, width: 640, widths: [320, 480, 640, 960], format: 'webp' });
const heroSizes = '(min-width: 1024px) 32rem, (min-width: 768px) 45vw, 18rem';
const poster = await getImage({ src: loopPoster, width: 720, format: 'webp' });
---

<BaseLayout
  title={title}
  isHome
  description={description}
  path="/"
  preloadImage={{ src: hero.src, srcset: hero.srcSet.attribute, sizes: heroSizes }}
  schema={[
    webPage({ path: '/', title, description }),
    itemList(
      '/',
      products.map((p) => ({ name: p.data.name, path: productPath(p.id) })),
    ),
  ]}
>
  <!-- Hero -->
  <section class="container-site grid items-center gap-6 py-8 md:grid-cols-2 md:gap-8 md:py-20">
    <div>
      <h1 class="h1">Wijnproeverij thuis: speel het wijnspel met vrienden</h1>
      <p class="lead mt-4 font-display text-brand">Ontdek je eigen smaak en word de kenner aan tafel!</p>
      <p class="mt-4 max-w-prose">
        Flavory is een blinde wijnproeverij in spelvorm. Je proeft twee wijnen tegen elkaar, beantwoordt quizvragen en
        ontmaskert samen welke fles welke is. Voor 2 tot 6 spelers, zonder voorkennis, vanaf {formatPrice(minPrice)},
        wijn inbegrepen.
      </p>
      <a href="/reviews/" class="mt-4 inline-flex items-center gap-2 text-sm hover:underline">
        <Stars rating={SITE.rating.value} class="text-xl" />
        <span>
          <strong>{String(SITE.rating.value).replace('.', ',')}/5</strong> uit {SITE.rating.count} reviews
        </span>
      </a>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:flex">
        {red && (
          <a href={productPath(red.id)} class="btn-primary">
            Kies rood
          </a>
        )}
        {white && (
          <a href={productPath(white.id)} class="btn-outline">
            Kies wit
          </a>
        )}
      </div>
    </div>
    <figure class="hero-media">
      <img
        src={hero.src}
        srcset={hero.srcSet.attribute}
        sizes={heroSizes}
        width={hero.attributes.width}
        height={hero.attributes.height}
        alt="Illustratie van vier vrienden die klinken met rode wijn aan een tafel met twee anonieme flessen"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="mx-auto h-auto w-full max-w-72 md:max-w-lg"
      />
    </figure>
  </section>

  <!-- Wat is Flavory -->
  <section
    id="wat-is-flavory"
    class="container-site grid scroll-mt-28 items-center gap-8 py-12 md:grid-cols-2 md:py-20"
    aria-labelledby="wat-title"
  >
    <Image
      src={friendsImage}
      alt="Twee vriendinnen lachen terwijl ze een Flavory-wijnspel openen"
      widths={[400, 640, 960]}
      sizes="(min-width: 768px) 50vw, 90vw"
      class="aspect-[3/2] w-full rounded-[var(--radius-card)] object-cover"
    />
    <div>
      <h2 id="wat-title" class="h2">
        Wat is Flavory?
      </h2>
      <p class="mt-4">
        Flavory brengt de leukste wijnproeverij bij je thuis. Je proeft blind twee wijnen tegen elkaar, en voorkennis
        van wijn heb je niet nodig.
      </p>
      <a href="/over-flavory/" class="btn-outline mt-6">
        Het verhaal achter Flavory
      </a>
    </div>
  </section>

  <!-- Producten -->
  <section class="container-site py-12 md:py-20" aria-labelledby="boxen-title">
    <h2 id="boxen-title" class="h2 text-center">
      Kies je box
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center">
      Rood of wit: in elke box zitten het volledige spel en twee flessen wijn.
    </p>
    <ul class="mx-auto mt-8 grid max-w-3xl gap-4 sm:grid-cols-2">
      {products.map((product) => (
        <li>
          <ProductCard product={product} />
        </li>
      ))}
    </ul>
  </section>

  <HowItWorks />

  <!-- Voor wie -->
  <section class="bg-brand text-white" aria-labelledby="voorwie-title">
    <div class="container-site grid items-center gap-8 py-12 md:grid-cols-2 md:py-20">
      <div>
        <h2 id="voorwie-title" class="h2">
          Voor wie is Flavory?
        </h2>
        <p class="mt-4">
          Flavory is voor 2 tot 6 vrienden of familieleden die liever herinneringen maken dan tv kijken.
        </p>
        <p class="mt-4">
          Het is ook voor iedereen die zich minder verloren wil voelen in de wijnrayon, en zich afvraagt of wijn écht
          naar paprika kan ruiken.
        </p>
        <p class="mt-4">Of je nu speelt voor de winst of voor de gezelligheid: Flavory brengt iedereen samen.</p>
        <p class="mt-4 font-bold">Perfect als cadeau of origineel relatiegeschenk.</p>
        <div class="mt-6">
          <a href="/shop/" class="btn-white">
            Met wie speel jij?
          </a>
        </div>
      </div>
      <video
        class="aspect-square w-full rounded-[var(--radius-card)] object-cover"
        width="720"
        height="720"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster={poster.src}
        aria-label="Sfeerbeelden van vrienden die Flavory spelen"
      >
        <source src="/media/flavory-loop.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <Guarantees />

  <Reviews />

  <!-- Blog -->
  <section class="container-site py-12 md:py-20" aria-labelledby="blog-title">
    <h2 id="blog-title" class="h2 text-center">
      Meer weten over wijn?
    </h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))}
    </ul>
    <p class="mt-8 text-center">
      <a href="/blog/" class="btn-outline">
        Alle blogberichten
      </a>
    </p>
  </section>

  <Newsletter />
</BaseLayout>
