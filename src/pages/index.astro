---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/commerce/ProductCard.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Guarantees from '@/components/sections/Guarantees.astro';
import Reviews from '@/components/sections/Reviews.astro';
import PostCard from '@/components/blog/PostCard.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import Stars from '@/components/ui/Stars.astro';
import { fromPrice, getProducts, getPosts, productPath } from '@/lib/content';
import { SITE, formatPrice } from '@/lib/site';
import { itemList, webPage } from '@/components/seo/schema';
// Hero photo: replace this one file (keep the name) to swap it. Landscape, at least 1600px wide.
import heroImage from '@/assets/images/site/hero-proeverij.jpg';
import friendsIllustration from '@/assets/images/site/illustratie-vrienden-klinken.webp';
import WineGlassIcon from '@/assets/icons/wine-glass.svg';
import TrophyIcon from '@/assets/icons/trophy.svg';
import CheersIcon from '@/assets/icons/glasses-cheers.svg';
import loopPoster from '@/assets/images/site/flavory-loop-poster.webp';

const products = await getProducts();
const red = products.find((p) => p.data.category.id === 'rode-wijn');
const white = products.find((p) => p.data.category.id === 'witte-wijn');
const minPrice = Math.min(...products.map(fromPrice));
// Pillar-first: the three strongest evergreen articles (SITE-STRUCTURE §5).
const featuredIds = ['blind-wijn-proeven', 'wijnproeverij-thuis-flavory', 'welke-wijn-bij-welk-gerecht-spiekbriefje'];
const posts = (await getPosts()).filter((p) => featuredIds.includes(p.id));

const title = 'Wijnproeverij thuis: het wijnspel voor vrienden | Flavory';
const description =
  'Flavory is het wijnspel voor een wijnproeverij thuis: proef blind twee wijnen, beantwoord quizvragen en ontdek wie de wijnkenner is. Voor 2 tot 6 spelers.';

const hero = await getImage({ src: heroImage, width: 1200, widths: [480, 720, 1200, 1600], format: 'webp' });
const heroSizes = '(min-width: 1200px) 36rem, (min-width: 768px) 48vw, calc(100vw - 2rem)';
const pillars = [
  {
    Icon: WineGlassIcon,
    title: 'Leer proeven',
    text: 'Kijk, ruik en proef zoals een sommelier. Geen voorkennis nodig.',
  },
  { Icon: TrophyIcon, title: 'Speel om te winnen', text: 'Quizvragen, punten en één winnaar.' },
  { Icon: CheersIcon, title: 'Samen aan tafel', text: 'Voor 2 tot 6 spelers, 60 à 90 minuten plezier.' },
];
const poster = await getImage({ src: loopPoster, width: 720, format: 'webp' });
---

<BaseLayout
  title={title}
  isHome
  description={description}
  path="/"
  preloadImage={{ src: hero.src, srcset: hero.srcSet.attribute, sizes: heroSizes }}
  schema={[
    webPage({ path: '/', title, description }),
    itemList(
      '/',
      products.map((p) => ({ name: p.data.name, path: productPath(p.id) })),
    ),
  ]}
>
  <!-- Hero -->
  <section class="container-site grid items-center gap-5 pt-4 pb-8 md:grid-cols-2 md:gap-10 md:py-16">
    <div>
      <p class="text-lg leading-snug font-semibold md:text-xl">Blind wijnproeven met het wijnspel van Flavory</p>
      <h1 class="h1 mt-2">Proef jij het verschil?</h1>
      <p class="mt-3 max-w-prose text-muted md:text-lg">
        <strong class="font-bold text-ink">Hét cadeau voor iedereen die graag een glas wijn drinkt.</strong>
        {` Vanaf ${formatPrice(minPrice)}, wijn inbegrepen.`}
      </p>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:max-w-md">
        {red && (
          <a href={productPath(red.id)} class="btn-primary px-4">
            Kies rood
          </a>
        )}
        {white && (
          <a href={productPath(white.id)} class="btn-wine-white px-4">
            Kies wit
          </a>
        )}
      </div>
      <a href="/reviews/" class="mt-4 inline-flex items-center gap-2 text-sm hover:underline">
        <Stars rating={SITE.rating.value} class="text-xl" />
        <span>
          <strong>{String(SITE.rating.value).replace('.', ',')}/5</strong> uit {SITE.rating.count} reviews
        </span>
      </a>
    </div>
    <img
      src={hero.src}
      srcset={hero.srcSet.attribute}
      sizes={heroSizes}
      width={hero.attributes.width}
      height={hero.attributes.height}
      alt="Twee glazen rode wijn naast elkaar tijdens een blinde proeverij met Flavory"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="h-[230px] w-full rounded-[var(--radius-card)] object-cover sm:h-72 md:aspect-[4/3] md:h-auto"
    />
  </section>

  <!-- Wat is Flavory -->
  <section
    id="wat-is-flavory"
    class="container-site grid scroll-mt-28 gap-6 py-8 md:grid-cols-[14rem_1fr] md:items-center md:gap-12 md:py-12"
    aria-label="Wat is Flavory"
  >
    <p class="mx-auto max-w-[600px] text-center text-lg leading-snug md:order-2 md:mx-0 md:text-left md:text-xl">
      Iedereen houdt van wijn, maar geen twee wijnen zijn hetzelfde. Leer spelenderwijs proeven met vrienden. Word jij
      de winnaar van de avond?
    </p>
    <Image
      src={friendsIllustration}
      alt="Vrienden klinken aan tafel tijdens een wijnproeverij thuis"
      widths={[240, 480]}
      sizes="(min-width: 768px) 14rem, 180px"
      class="mx-auto h-auto w-[180px] md:order-1 md:row-span-2 md:w-full"
    />
    <div class="md:order-3">
      <ul class="mx-auto grid max-w-md gap-4 md:mx-0 md:max-w-none md:grid-cols-3 md:gap-6">
        {pillars.map(({ Icon, title, text }) => (
          <li class="flex gap-4 md:flex-col md:gap-2">
            <Icon class="size-10 shrink-0 text-brand" aria-hidden="true" />
            <div>
              <h2 class="font-sans text-lg font-bold">{title}</h2>
              <p class="text-muted">{text}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-center md:text-left">
        <a href="/over-flavory/" class="font-bold underline underline-offset-4 hover:text-brand">
          Het verhaal achter Flavory
        </a>
      </p>
    </div>
  </section>

  <!-- Producten -->
  <section class="container-site py-12 md:py-20" aria-labelledby="boxen-title">
    <h2 id="boxen-title" class="h2 text-center">
      Kies je box
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center">
      Rood of wit: in elke box zitten het volledige spel en twee flessen wijn.
    </p>
    <ul class="mx-auto mt-8 grid max-w-3xl gap-4 sm:grid-cols-2">
      {products.map((product) => (
        <li>
          <ProductCard product={product} />
        </li>
      ))}
    </ul>
  </section>

  <HowItWorks />

  <!-- Voor wie -->
  <section class="bg-brand text-white" aria-labelledby="voorwie-title">
    <div class="container-site grid items-center gap-8 py-12 md:grid-cols-2 md:py-20">
      <div>
        <h2 id="voorwie-title" class="h2">
          Voor wie is Flavory?
        </h2>
        <p class="mt-4">
          Flavory is voor 2 tot 6 vrienden of familieleden die liever herinneringen maken dan tv kijken.
        </p>
        <p class="mt-4">
          Het is ook voor iedereen die zich minder verloren wil voelen in de wijnrayon, en zich afvraagt of wijn écht
          naar paprika kan ruiken.
        </p>
        <p class="mt-4">Of je nu speelt voor de winst of voor de gezelligheid: Flavory brengt iedereen samen.</p>
        <p class="mt-4 font-bold">Perfect als cadeau of origineel relatiegeschenk.</p>
        <div class="mt-6">
          <a href="/shop/" class="btn-white">
            Met wie speel jij?
          </a>
        </div>
      </div>
      <video
        class="aspect-square w-full rounded-[var(--radius-card)] object-cover"
        width="720"
        height="720"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster={poster.src}
        aria-label="Sfeerbeelden van vrienden die Flavory spelen"
      >
        <source src="/media/flavory-loop.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <Guarantees />

  <Reviews />

  <!-- Blog -->
  <section class="container-site py-12 md:py-20" aria-labelledby="blog-title">
    <h2 id="blog-title" class="h2 text-center">
      Meer weten over wijn?
    </h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))}
    </ul>
    <p class="mt-8 text-center">
      <a href="/blog/" class="btn-outline">
        Alle blogberichten
      </a>
    </p>
  </section>

  <Newsletter />
</BaseLayout>
