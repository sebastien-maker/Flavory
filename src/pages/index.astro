---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ColorChoice from '@/components/commerce/ColorChoice.astro';
import Reviews from '@/components/sections/Reviews.astro';
import PostCard from '@/components/blog/PostCard.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import LazyVideo from '@/components/ui/LazyVideo.astro';
import Stars from '@/components/ui/Stars.astro';
import UspList from '@/components/ui/UspList.astro';
import Price from '@/components/commerce/Price.astro';
import { colourChoices, fromPrice, getProducts, getPosts, mainProducts, productPath } from '@/lib/content';
import { COLOUR_STYLES } from '@/lib/colour-choice';
import { SITE } from '@/lib/site';
import { itemList, webPage } from '@/components/seo/schema';
import heroPhoto from '@/assets/images/site/aan-tafel.jpg';
import clipPoster from '@/assets/images/site/flavory-avond-vrienden-poster.jpg';
import pouringPhoto from '@/assets/images/site/inschenken.jpg';
import tablePhoto from '@/assets/images/site/aan-tafel.jpg';
// Drawing under the steps; it also sits on the box sleeve.
import sleeveIllustration from '@/assets/images/site/sleeve-illustratie.webp';

const allProducts = await getProducts();
const products = mainProducts(allProducts);
const lowestPrice = Math.min(...products.map(fromPrice));
// The two buttons in the hero: white and red, each straight to its product page.
const boxes = colourChoices(allProducts).map((choice) => ({ ...choice, style: COLOUR_STYLES[choice.label] }));
// Only set while WooCommerce has a sale price: the price before the discount, shown struck through.
const lowestRegular = products.flatMap((p) => p.data.variants).find((v) => v.price === lowestPrice)?.regularPrice;
// Running promotion (SITE.campaign): a small pill with the discount above the headline.
const promo = SITE.campaign === 'blackfriday' && SITE.blackFriday.offer;
// Pillar-first: the three strongest evergreen articles (SITE-STRUCTURE §5).
const featuredIds = ['blind-wijn-proeven', 'wijnproeverij-thuis-flavory', 'welke-wijn-bij-welk-gerecht-spiekbriefje'];
const posts = (await getPosts()).filter((p) => featuredIds.includes(p.id));

const title = 'Wijnspel: proef twee wijnen blind met vrienden | Flavory';
const description =
  'Flavory is het wijnspel met twee flessen wijn erbij: proef ze blind, beantwoord de quizvragen en ontdek wie het verschil proeft. Voor 2 tot 6 spelers.';

const hero = await getImage({ src: heroPhoto, width: 1600, widths: [480, 720, 960, 1280, 1600], format: 'webp' });
// Full width on a phone, the right 60% of the screen from a tablet on.
const heroSizes = '(min-width: 768px) 60vw, 100vw';
const score = String(SITE.rating.value).replace('.', ',');
const playersMin = Math.min(...products.map((p) => p.data.playersMin));
const playersMax = Math.max(...products.map((p) => p.data.playersMax));
// Three steps, with the drawings that also sit on the box.
const steps = [
  {
    img: '/images/steps/stap-2.svg',
    title: 'Schenk blind in',
    text: 'De twee flessen zitten in stoffen zakjes. Niemand weet welke wijn in fles A of B zit.',
  },
  {
    img: '/images/steps/stap-3.svg',
    title: 'Proef en speel',
    text: 'Kijk, ruik en proef, en verzamel tips met de quizvragen.',
  },
  {
    img: '/images/steps/stap-5.svg',
    title: 'Ontmasker de wijnen',
    text: 'Noteer je gok, onthul de flessen en kroon de winnaar.',
  },
];
const audiences = [
  {
    title: 'Een avond met vrienden',
    text: 'Zet twee glazen per persoon klaar, de rest doet het spel.',
    href: '/hoe-werkt-het/',
    label: 'Zo werkt het',
  },
  {
    title: 'Als cadeau',
    text: 'Een spel plus twee flessen wijn, leuker dan de zoveelste fles alleen.',
    href: '/cadeau/',
    label: 'Zo geef je het cadeau',
  },
  {
    title: 'Voor je team of je klanten',
    text: 'Als relatiegeschenk of teamactiviteit, met een offerte op maat.',
    href: '/zakelijk/',
    label: 'Zakelijk bestellen',
  },
];
---

<BaseLayout
  title={title}
  isHome
  darkHeader
  description={description}
  path="/"
  preloadImage={{ src: hero.src, srcset: hero.srcSet.attribute, sizes: heroSizes }}
  schema={[
    webPage({ path: '/', title, description }),
    itemList(
      '/',
      products.map((p) => ({ name: p.data.name, path: productPath(p.id) })),
    ),
  ]}
>
  <!-- Hero, after the premium look of realmadhoney.eu (preview, 25 Nov 2026): a dark, warm photo of the game at
       the table, the rating above the headline, one button with the price next to it and three promises under it.
       During a promotion a small pill with the discount stands above the headline. -->
  <section class="hero-dark" aria-labelledby="hero-title">
    <div class="hero-photo">
      <img
        src={hero.src}
        srcset={hero.srcSet.attribute}
        sizes={heroSizes}
        width={hero.attributes.width}
        height={hero.attributes.height}
        alt="Aan tafel houdt een vrouw fles A in zijn stoffen zakje omhoog, de anderen raden welke wijn erin zit"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="container-site hero-copy">
      <a href="#reviews-title" class="hero-rating">
        <Stars rating={SITE.rating.value} />
        <span><strong>{score}/5</strong> uit {SITE.rating.count} reviews op Google</span>
      </a>
      {
        promo && (
          <a href="/black-friday/" class="hero-promo">
            {SITE.blackFriday.badge && <strong class="bf-pct">{SITE.blackFriday.badge}</strong>}
            <span>Black Friday · {SITE.blackFriday.hurry || SITE.blackFriday.offer}</span>
          </a>
        )
      }
      <h1 id="hero-title" class="hero-title">Het spel dat je wijn leert proeven</h1>
      <p class="hero-lead">
        Twee flessen wijn zonder etiket, een spel en je vrienden aan tafel. Proef blind en raad welke wijn welke is.
      </p>
      <!-- Two buttons, white and red, straight to the product page (Sébastien, 25 Nov 2026). The colour of a button
           follows the wine, the one exception to "one primary button" in docs/design-richtlijnen.md. -->
      <div class="hero-buy">
        {
          boxes.map(({ product, style }) => (
            <a href={productPath(product.id)} class:list={['btn', style.button]}>
              {style.cta}
            </a>
          ))
        }
      </div>
      <p class="mt-3 text-sm">
        vanaf{' '}
        <strong>
          <Price price={lowestPrice} regularPrice={lowestRegular} />
        </strong>{' '}
        met twee flessen wijn erbij
      </p>
      <UspList playersMin={playersMin} playersMax={playersMax} class="mt-6" />
    </div>
  </section>

  <!-- Zo speel je Flavory -->
  <section class="section-y bg-white" aria-labelledby="spelen-title">
    <div class="container-site">
      <h2 id="spelen-title" class="h2 text-center">
        Zo speel je Flavory
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center">
        Flavory is een Belgisch wijnspel voor 2 tot 6 spelers. Je proeft blind twee meegeleverde wijnen en ontdekt met
        quizvragen welke welke is. Een spel duurt 60 tot 90 minuten en je hebt geen wijnkennis nodig.
      </p>
      <div class="mt-6 grid items-center gap-6 md:grid-cols-2 md:gap-10">
        <Image
          src={pouringPhoto}
          alt="Wijn wordt blind ingeschonken uit een fles in een stoffen zakje"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 45vw, calc(100vw - 2rem)"
          class="aspect-[16/10] w-full rounded-[var(--radius-card)] object-cover"
        />
        <div>
          <ol class="divide-y divide-line">
            {steps.map((step, i) => (
              <li class="flex items-center gap-4 py-3">
                <span class="step-number" aria-hidden="true">
                  {i + 1}
                </span>
                <div class="min-w-0">
                  <p class="font-bold">
                    <span class="sr-only">Stap {i + 1}: </span>
                    {step.title}
                  </p>
                  <p class="mt-1 text-sm text-muted">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <Image
            src={sleeveIllustration}
            alt="Tekening van vier vrienden die samen wijn proeven"
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 768px) 30rem, calc(100vw - 2rem)"
            class="mx-auto mt-4 h-auto w-full max-w-[30rem]"
          />
        </div>
      </div>
      <p class="mt-6 text-center font-bold">2 tot 6 spelers · 60 tot 90 minuten · geen wijnkennis nodig</p>
      <p class="mt-4 text-center">
        <a href="/hoe-werkt-het/" class="btn-outline">
          De spelregels in 6 stappen
        </a>
      </p>
    </div>
  </section>

  <!-- Kies je box -->
  <section id="kies-je-box" class="section-y scroll-mt-24 bg-blush" aria-labelledby="boxen-title">
    <div class="container-site">
      <ColorChoice products={allProducts} class="mx-auto" />
    </div>
  </section>

  <!-- Voor wie -->
  <section class="bg-white" aria-labelledby="voorwie-title">
    <div class="section-y container-site">
      <div class="grid items-center gap-8 md:grid-cols-2">
        <div>
          <h2 id="voorwie-title" class="h2">
            Voor wie is Flavory?
          </h2>
          <ul class="mt-5 grid gap-4">
            {audiences.map((a) => (
              <li class="rounded-xl bg-blush px-4 py-3">
                <h3 class="font-sans text-lg font-bold">{a.title}</h3>
                <p class="mt-1 text-sm">{a.text}</p>
                <a href={a.href} class="mt-2 inline-block text-sm font-bold underline">
                  {a.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <Image
          src={tablePhoto}
          alt="Vrienden aan tafel terwijl iemand een fles in een stoffen zakje omhooghoudt"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 45vw, calc(100vw - 2rem)"
          class="aspect-[16/10] w-full rounded-[var(--radius-card)] object-cover"
        />
      </div>
      <!-- Mood clip, only loaded once it scrolls into view. -->
      <LazyVideo
        src="/media/flavory-avond-vrienden.mp4"
        poster={clipPoster}
        label="Sfeerbeelden: vrienden proeven samen wijn aan een tafel met kaarsen"
        class="mt-8 aspect-video w-full rounded-[var(--radius-card)] object-cover"
      />
    </div>
  </section>

  <Reviews heading="Spelers aan het woord" authors={['ingrid', 'nele', 'charlotte']} note={SITE.guarantee} />

  <!-- Blog -->
  <section class="section-y bg-white" aria-labelledby="blog-title">
    <div class="container-site">
      <h2 id="blog-title" class="h2 text-center">
        Meer weten over wijn?
      </h2>
      <p class="mx-auto mt-2 max-w-2xl text-center">Lees onze blogs over proeven, druiven en wijn aan tafel.</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {posts.map((post) => (
          <li>
            <PostCard post={post} compact />
          </li>
        ))}
      </ul>
      <p class="mt-6 text-center">
        <a href="/blog/" class="btn-outline">
          Alle blogberichten
        </a>
      </p>
    </div>
  </section>

  <Newsletter heading="Proeftips en nieuwe duels in je mailbox" />
</BaseLayout>
