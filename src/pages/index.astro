---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ColorChoice from '@/components/commerce/ColorChoice.astro';
import BoxPick from '@/components/commerce/BoxPick.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import LazyVideo from '@/components/ui/LazyVideo.astro';
import RatingBadge from '@/components/ui/RatingBadge.astro';
import Countdown from '@/components/ui/Countdown.astro';
import { getProducts, getPosts, mainProducts, postPath, productPath } from '@/lib/content';
import { SITE } from '@/lib/site';
import { itemList, webPage } from '@/components/seo/schema';
import heroPhoto from '@/assets/images/site/hero-proeven.jpg';
// During a promotion the hero is dark: a photo by candlelight fits it better than the daylight one.
import darkHeroPhoto from '@/assets/images/site/hero-zakjes.jpg';
import clipPoster from '@/assets/images/site/flavory-avond-vrienden-poster.jpg';
import pouringPhoto from '@/assets/images/site/inschenken.jpg';
// Drawing under the steps; it also sits on the box sleeve.
import sleeveIllustration from '@/assets/images/site/sleeve-illustratie.webp';

const allProducts = await getProducts();
const products = mainProducts(allProducts);
// Running promotion (SITE.campaign): the hero turns dark, with one line above the headline that names the
// discount and how long it lasts. Without a promotion the hero is the light one, with the same two box cards.
const promo = SITE.campaign === 'blackfriday' && !!SITE.blackFriday.offer;
const { badge, endDate, endsAt } = SITE.blackFriday;
// Pillar-first: the three strongest evergreen articles (SITE-STRUCTURE §5).
const featuredIds = ['blind-wijn-proeven', 'wijnproeverij-thuis-flavory', 'welke-wijn-bij-welk-gerecht-spiekbriefje'];
const posts = (await getPosts()).filter((p) => featuredIds.includes(p.id));

const title = 'Wijnspel: proef twee wijnen blind met vrienden | Flavory';
const description =
  'Flavory is het wijnspel met twee flessen wijn erbij: proef ze blind, beantwoord de quizvragen en ontdek wie het verschil proeft. Voor 2 tot 6 spelers.';

const hero = await getImage({
  src: promo ? darkHeroPhoto : heroPhoto,
  width: 900,
  widths: [360, 540, 720, 900],
  format: 'webp',
});
const heroAlt = promo
  ? 'Een man houdt lachend twee flessen wijn in stoffen zakjes A en B omhoog, bij kaarslicht'
  : 'Twee vrouwen proeven witte wijn aan tafel, met een fles in een stoffen zakje ervoor';
const heroSizes = '(min-width: 768px) 28rem, calc(100vw - 2rem)';
// Three steps, with the drawings that also sit on the box.
const steps = [
  {
    img: '/images/steps/stap-2.svg',
    title: 'Schenk blind in',
    text: 'De twee flessen zitten in stoffen zakjes. Niemand weet welke wijn in fles A of B zit.',
  },
  {
    img: '/images/steps/stap-3.svg',
    title: 'Proef en speel',
    text: 'Kijk, ruik en proef, en verzamel tips met de quizvragen.',
  },
  {
    img: '/images/steps/stap-5.svg',
    title: 'Ontmasker de wijnen',
    text: 'Noteer je gok, onthul de flessen en kroon de winnaar.',
  },
];
const audiences = [
  {
    title: 'Een avond met vrienden',
    text: 'Zet twee glazen per persoon klaar, de rest doet het spel.',
    href: '/hoe-werkt-het/',
    label: 'Zo werkt het',
  },
  {
    title: 'Als cadeau',
    text: 'Een spel plus twee flessen wijn, leuker dan de zoveelste fles alleen.',
    href: '/cadeau/',
    label: 'Zo geef je het cadeau',
  },
  {
    title: 'Voor je team of je klanten',
    text: 'Als relatiegeschenk of teamactiviteit, met een offerte op maat.',
    href: '/zakelijk/',
    label: 'Zakelijk bestellen',
  },
];
---

<BaseLayout
  title={title}
  isHome
  description={description}
  path="/"
  darkHeader={promo}
  preloadImage={{ src: hero.src, srcset: hero.srcSet.attribute, sizes: heroSizes, media: '(min-width: 48rem)' }}
  schema={[
    webPage({ path: '/', title, description }),
    itemList(
      '/',
      products.map((p) => ({ name: p.data.name, path: productPath(p.id) })),
    ),
  ]}
>
  <!-- Hero. The two box cards stand in the hero itself: one tap from here to a box. During a promotion
       (SITE.campaign) the zone is dark and one line above the headline names the discount and the time left.
       On a phone the photo comes after the cards (the headline is the LCP there); from md up it stands beside
       them and is preloaded. -->
  <section class:list={[promo && 'bf-dark']}>
    <div class="container-site grid items-center gap-6 pt-4 pb-10 md:grid-cols-2 md:gap-10 md:py-12">
      <div>
        {promo && (
          <a href="/black-friday/" class="bf-eyebrow mb-3">
            {badge && <strong class="bf-pct">{badge}</strong>}
            <span>Black Friday</span>
            {endDate && (
              <span class="bf-soft font-normal">
                <Countdown endsAt={endsAt} fallback={`tot en met ${endDate}`} />
              </span>
            )}
          </a>
        )}
        <h1 class="h1">Het spel dat je wijn leert proeven</h1>
        <p class="mt-3 md:text-lg">
          Twee flessen wijn zonder etiket en een wijnspel. Proef blind en raad welke wijn welke is.
        </p>
        <h2 class="sr-only">Kies rood of wit</h2>
        <BoxPick products={allProducts} class="mt-5" />
        <p class="mt-4 text-sm">
          Je wijnproeverij thuis in één pakket, voor 2 tot 6 spelers. {SITE.announcement}.
        </p>
        <RatingBadge class="mt-2" />
      </div>
      <img
        src={hero.src}
        srcset={hero.srcSet.attribute}
        sizes={heroSizes}
        width={hero.attributes.width}
        height={hero.attributes.height}
        alt={heroAlt}
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full rounded-[var(--radius-card)] object-cover object-[center_25%] md:aspect-[4/5]"
      />
    </div>
  </section>

  <!-- Zo speel je Flavory -->
  <section class="section-y bg-white" aria-labelledby="spelen-title">
    <div class="container-site">
      <h2 id="spelen-title" class="h2 text-center">
        Zo speel je Flavory
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center">
        Flavory is een Belgisch wijnspel voor 2 tot 6 spelers. Je proeft blind twee meegeleverde wijnen en ontdekt met
        quizvragen welke welke is. Een spel duurt 60 tot 90 minuten en je hebt geen wijnkennis nodig.
      </p>
      <div class="mt-6 grid items-center gap-6 md:grid-cols-2 md:gap-10">
        <Image
          src={pouringPhoto}
          alt="Wijn wordt blind ingeschonken uit een fles in een stoffen zakje"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 45vw, calc(100vw - 2rem)"
          class="aspect-[16/10] w-full rounded-[var(--radius-card)] object-cover"
        />
        <div>
          <ol class="divide-y divide-line">
            {steps.map((step, i) => (
              <li class="flex items-center gap-4 py-3">
                <span class="step-number" aria-hidden="true">
                  {i + 1}
                </span>
                <div class="min-w-0">
                  <p class="font-bold">
                    <span class="sr-only">Stap {i + 1}: </span>
                    {step.title}
                  </p>
                  <p class="mt-1 text-sm text-muted">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <Image
            src={sleeveIllustration}
            alt="Tekening van vier vrienden die samen wijn proeven"
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 768px) 30rem, calc(100vw - 2rem)"
            class="mx-auto mt-4 hidden h-auto w-full max-w-[30rem] md:block"
          />
        </div>
      </div>
      <p class="mt-6 text-center font-bold">2 tot 6 spelers · 60 tot 90 minuten · geen wijnkennis nodig</p>
      <p class="mt-4 text-center">
        <a href="/hoe-werkt-het/" class="btn-outline">
          De spelregels in 6 stappen
        </a>
      </p>
    </div>
  </section>

  <Reviews heading="Spelers aan het woord" authors={['ingrid', 'nele', 'charlotte']} note={SITE.guarantee} />

  <!-- Voor wie -->
  <section class="section-y bg-white" aria-labelledby="voorwie-title">
    <div class="container-site">
      <h2 id="voorwie-title" class="h2 text-center">
        Voor wie is Flavory?
      </h2>
      <ul class="mt-6 grid gap-3 md:grid-cols-3">
        {audiences.map((a) => (
          <li class="rounded-[var(--radius-card)] bg-cream p-5">
            <h3 class="font-sans text-lg font-bold">{a.title}</h3>
            <p class="mt-1 text-sm">{a.text}</p>
            <a href={a.href} class="mt-2 inline-flex min-h-11 items-center text-sm font-bold underline">
              {a.label}
            </a>
          </li>
        ))}
      </ul>
      <!-- Mood clip, only loaded once it scrolls into view. -->
      <LazyVideo
        src="/media/flavory-avond-vrienden.mp4"
        poster={clipPoster}
        label="Sfeerbeelden: vrienden proeven samen wijn aan een tafel met kaarsen"
        class="mt-6 aspect-video w-full rounded-[var(--radius-card)] object-cover"
      />
    </div>
  </section>

  <!-- Kies je box: the same choice once more, for who read the whole page first -->
  <section id="kies-je-box" class="section-y scroll-mt-24 bg-blush" aria-labelledby="boxen-title">
    <div class="container-site">
      <ColorChoice products={allProducts} class="mx-auto" />
    </div>
  </section>

  <!-- Blog: three text links to the strongest articles, no cards -->
  <div class="container-site pt-10 md:pt-16">
    <p class="font-bold">Meer weten over wijn?</p>
    <ul class="mt-2 divide-y divide-line">
      {posts.map((post) => (
        <li>
          <a href={postPath(post.id)} class="flex min-h-12 items-center py-2 underline">
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-3">
      <a href="/blog/" class="text-sm font-bold underline">
        Alle blogberichten
      </a>
    </p>
  </div>

  <Newsletter heading="Proeftips en nieuwe duels in je mailbox" />
</BaseLayout>
