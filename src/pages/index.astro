---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/commerce/ProductCard.astro';
import Reviews from '@/components/sections/Reviews.astro';
import PostCard from '@/components/blog/PostCard.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import LazyVideo from '@/components/ui/LazyVideo.astro';
import { clearanceProducts, fromPrice, getProducts, getPosts, mainProducts, productPath } from '@/lib/content';
import { SITE, formatPrice } from '@/lib/site';
import { itemList, webPage } from '@/components/seo/schema';
import heroPhoto from '@/assets/images/site/hero-zakjes.jpg';
import loopPoster from '@/assets/images/site/flavory-loop-poster.webp';
import pouringPhoto from '@/assets/images/site/inschenken.jpg';
import tablePhoto from '@/assets/images/site/aan-tafel.jpg';
// Small accent next to the steps; the drawing also sits on the box sleeve.
import sleeveIllustration from '@/assets/images/site/sleeve-illustratie.webp';

const allProducts = await getProducts();
const products = mainProducts(allProducts);
const clearance = clearanceProducts(allProducts);
const lowestPrice = Math.min(...products.map(fromPrice));
// Pillar-first: the three strongest evergreen articles (SITE-STRUCTURE §5).
const featuredIds = ['blind-wijn-proeven', 'wijnproeverij-thuis-flavory', 'welke-wijn-bij-welk-gerecht-spiekbriefje'];
const posts = (await getPosts()).filter((p) => featuredIds.includes(p.id));

const title = 'Wijnproeverij thuis: het wijnspel voor vrienden | Flavory';
const description =
  'Flavory is het wijnspel voor een wijnproeverij thuis: 2 tot 6 spelers proeven blind twee meegeleverde wijnen. Wie raadt welke wijn welke is?';

const hero = await getImage({ src: heroPhoto, width: 900, widths: [360, 540, 720, 900], format: 'webp' });
const heroSizes = '(min-width: 768px) 28rem, calc(100vw - 2rem)';
const rating = `${String(SITE.rating.value).replace('.', ',')}/5 op ${SITE.rating.source} (${SITE.rating.count} reviews)`;
// Three steps, with the drawings that also sit on the box.
const steps = [
  {
    img: '/images/steps/stap-2.svg',
    title: 'Schenk blind in',
    text: 'De twee flessen zitten in stoffen zakjes. Niemand weet welke wijn in fles A of B zit.',
  },
  {
    img: '/images/steps/stap-3.svg',
    title: 'Proef en speel',
    text: 'Kijk, ruik en proef, en verzamel tips met de quizvragen.',
  },
  {
    img: '/images/steps/stap-5.svg',
    title: 'Ontmasker de wijnen',
    text: 'Noteer je gok, onthul de flessen en kroon de winnaar.',
  },
];
const audiences = [
  {
    title: 'Een avond met vrienden',
    text: 'Zet twee glazen per persoon klaar, de rest doet het spel.',
    href: '/hoe-werkt-het/',
    label: 'Zo werkt het',
  },
  {
    title: 'Als cadeau',
    text: 'Een spel plus twee flessen wijn, leuker dan de zoveelste fles alleen.',
    href: '/shop/',
    label: 'Bekijk de boxen',
  },
  {
    title: 'Voor je team of je klanten',
    text: 'Als relatiegeschenk of teamactiviteit, met een offerte op maat.',
    href: '/zakelijk/',
    label: 'Zakelijk bestellen',
  },
];
---

<BaseLayout
  title={title}
  isHome
  description={description}
  path="/"
  preloadImage={{ src: hero.src, srcset: hero.srcSet.attribute, sizes: heroSizes }}
  schema={[
    webPage({ path: '/', title, description }),
    itemList(
      '/',
      products.map((p) => ({ name: p.data.name, path: productPath(p.id) })),
    ),
  ]}
>
  <!-- Hero -->
  <section class="container-site grid items-center gap-5 pt-4 pb-8 md:grid-cols-2 md:gap-10 md:py-12">
    <div>
      <h1 class="h1">Het wijnspel voor een avond met vrienden</h1>
      <p class="mt-3 text-lg leading-snug md:text-xl">
        2 tot 6 spelers proeven blind twee wijnen en raden welke welke is. De twee flessen zitten in de doos.
      </p>
      <div class="mt-5">
        <a href="#kies-je-box" class="btn-primary">
          Kies je box
        </a>
      </div>
      <p class="mt-3 text-sm">
        Vanaf <strong>{formatPrice(lowestPrice)}</strong> · {rating}
      </p>
    </div>
    <img
      src={hero.src}
      srcset={hero.srcSet.attribute}
      sizes={heroSizes}
      width={hero.attributes.width}
      height={hero.attributes.height}
      alt="Speler houdt twee flessen in stoffen zakjes met de letters A en B omhoog aan tafel"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="aspect-[4/5] w-full rounded-[var(--radius-card)] object-cover"
    />
  </section>

  <!-- Zo speel je Flavory -->
  <section class="section-y bg-white" aria-labelledby="spelen-title">
    <div class="container-site">
      <h2 id="spelen-title" class="h2 text-center">
        Zo speel je Flavory
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center">
        Flavory is een Belgisch wijnspel voor 2 tot 6 spelers. Je proeft blind twee meegeleverde wijnen en ontdekt met
        quizvragen welke welke is. Een spel duurt 60 tot 90 minuten en je hebt geen wijnkennis nodig.
      </p>
      <div class="mt-6 grid items-center gap-6 md:grid-cols-2 md:gap-10">
        <Image
          src={pouringPhoto}
          alt="Wijn wordt blind ingeschonken uit een fles in een stoffen zakje"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 45vw, calc(100vw - 2rem)"
          class="aspect-[16/10] w-full rounded-[var(--radius-card)] object-cover"
        />
        <div>
          <ol class="divide-y divide-line">
            {steps.map((step, i) => (
              <li class="flex items-center gap-4 py-3">
                <span class="step-number" aria-hidden="true">
                  {i + 1}
                </span>
                <div class="min-w-0">
                  <p class="font-bold">
                    <span class="sr-only">Stap {i + 1}: </span>
                    {step.title}
                  </p>
                  <p class="mt-1 text-sm text-muted">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <Image
            src={sleeveIllustration}
            alt="Tekening van vier vrienden die samen wijn proeven"
            widths={[160, 320]}
            sizes="10rem"
            class="mt-4 h-auto w-40"
          />
        </div>
      </div>
      <p class="mt-6 text-center font-bold">
        2 tot 6 spelers · 60 tot 90 minuten · geen wijnkennis nodig · alleen glazen nodig
      </p>
      <p class="mt-4 text-center">
        <a href="/hoe-werkt-het/" class="btn-outline">
          De spelregels in 6 stappen
        </a>
      </p>
    </div>
  </section>

  <!-- Kies je box -->
  <section id="kies-je-box" class="section-y scroll-mt-24 bg-blush" aria-labelledby="boxen-title">
    <div class="container-site">
      <h2 id="boxen-title" class="h2 text-center">
        Kies je box
      </h2>
      <p class="mx-auto mt-2 max-w-2xl text-center">
        Kies wit of rood, en daarna standaard of premium. Elke box bevat het volledige spel en twee flessen wijn van 75
        cl.
      </p>
      <ul class="mx-auto mt-6 grid max-w-3xl gap-4 sm:grid-cols-2">
        {products.map((product) => (
          <li>
            <ProductCard product={product} />
          </li>
        ))}
      </ul>
      {clearance.map((product) => (
        <p class="mt-4 text-center text-sm">
          Zolang de voorraad strekt:{' '}
          <a href={productPath(product.id)} class="font-bold underline">
            {product.data.name}
          </a>
        </p>
      ))}
    </div>
  </section>

  <!-- Voor wie -->
  <section class="bg-white" aria-labelledby="voorwie-title">
    <div class="section-y container-site">
      <div class="grid items-center gap-8 md:grid-cols-2">
        <div>
          <h2 id="voorwie-title" class="h2">
            Voor wie is Flavory?
          </h2>
          <ul class="mt-5 grid gap-4">
            {audiences.map((a) => (
              <li class="rounded-xl bg-blush px-4 py-3">
                <h3 class="font-sans text-lg font-bold">{a.title}</h3>
                <p class="mt-1 text-sm">{a.text}</p>
                <a href={a.href} class="mt-2 inline-block text-sm font-bold underline">
                  {a.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <Image
          src={tablePhoto}
          alt="Vrienden aan tafel terwijl iemand een fles in een stoffen zakje omhooghoudt"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 45vw, calc(100vw - 2rem)"
          class="aspect-[16/10] w-full rounded-[var(--radius-card)] object-cover"
        />
      </div>
      <!-- Mood clip, only loaded once it scrolls into view. -->
      <LazyVideo
        src="/media/flavory-loop.mp4"
        poster={loopPoster}
        label="Sfeerbeelden van vrienden die Flavory spelen"
        class="mt-8 aspect-video w-full rounded-[var(--radius-card)] object-cover"
      />
    </div>
  </section>

  <Reviews heading="Spelers aan het woord" authors={['ingrid', 'nele', 'charlotte']} note={SITE.guarantee} />

  <!-- Blog -->
  <section class="section-y bg-white" aria-labelledby="blog-title">
    <div class="container-site">
      <h2 id="blog-title" class="h2 text-center">
        Meer weten over wijn?
      </h2>
      <p class="mx-auto mt-2 max-w-2xl text-center">Lees onze blogs over proeven, druiven en wijn aan tafel.</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {posts.map((post) => (
          <li>
            <PostCard post={post} compact />
          </li>
        ))}
      </ul>
      <p class="mt-6 text-center">
        <a href="/blog/" class="btn-outline">
          Alle blogberichten
        </a>
      </p>
    </div>
  </section>

  <Newsletter heading="Proeftips en nieuwe duels in je mailbox" />
</BaseLayout>
