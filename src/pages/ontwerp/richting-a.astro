---
// Design direction A, "De twee dozen": light, product first. Prototype for Bart's choice, never shipped.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RatingBadge from '@/components/ui/RatingBadge.astro';
import ShippingCutoff from '@/components/ui/ShippingCutoff.astro';
import Price from '@/components/commerce/Price.astro';
import { colourChoices, fromPrice, getProducts, productPath } from '@/lib/content';
import { COLOUR_STYLES } from '@/lib/colour-choice';
import { SITE } from '@/lib/site';
import evening from '@/assets/images/site/hero-zakjes.jpg';
import poster from '@/assets/images/site/flavory-avond-vrienden-poster.jpg';
import contents from '@/assets/images/products/wijnproeverij-thuis-rood/02.webp';

const products = await getProducts();
const choices = colourChoices(products).map((c) => ({ ...c, style: COLOUR_STYLES[c.label] }));
const names = { Wit: 'Wit wijnspel', Rood: 'Rood wijnspel' } as const;
const buttons = { Wit: 'Bekijk wit', Rood: 'Bekijk rood' } as const;
const steps = [
  {
    title: 'Schenk blind in',
    text: 'De twee flessen zitten in stoffen zakjes. Niemand weet welke wijn in fles A of B zit.',
  },
  { title: 'Proef en speel', text: 'Kijk, ruik en proef, en verzamel tips met de quizvragen.' },
  { title: 'Ontmasker de wijnen', text: 'Noteer je gok, onthul de flessen en kroon de winnaar.' },
];
---

<BaseLayout
  title="Richting A"
  description="Voorbeeld van ontwerprichting A voor de homepage van Flavory. Deze pagina is een proef en wordt niet gepubliceerd of geïndexeerd."
  path="/ontwerp/richting-a/"
  noindex
>
  <section class="a-wrap a-hero">
    <div class="a-copy">
      <h1 class="a-h1">Het wijnspel: twee wijnen blind proeven, thuis aan tafel</h1>
      <p class="a-lead">
        Het leukste cadeau voor iedereen die van wijn houdt. Met twee flessen wijn (75 cl) erbij, voor een avond met 2
        tot 6 spelers.
      </p>
    </div>

    <ul class="a-shelf">
      {
        choices.map(({ label, product, style }) => (
          <li>
            <a href={productPath(product.id)} class="a-box">
              <Image
                src={style.image}
                alt={style.alt}
                width={520}
                height={520}
                widths={[260, 520, 780]}
                sizes="(min-width: 1024px) 20rem, 45vw"
                loading="eager"
                class="a-box-img"
              />
              <span class="a-box-text">
                <strong class="a-box-name">{names[label]}</strong>
                <em class:list={['a-box-duel', style.line]}>{product.data.duel}</em>
                <span class="a-box-price">
                  vanaf{' '}
                  <b>
                    <Price price={fromPrice(product)} />
                  </b>
                </span>
                <span class:list={['a-box-btn', style.button]}>{buttons[label]}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <figure class="a-photo">
      <Image
        src={evening}
        alt="Een man houdt lachend twee flessen in stoffen zakjes A en B omhoog"
        widths={[420, 640, 840]}
        sizes="(min-width: 1024px) 26rem, 100vw"
        loading="eager"
        class="a-photo-img"
      />
      <figcaption class="a-photo-cap">Welke wijn zit in zakje A, en welke in B?</figcaption>
    </figure>

    <div class="a-trust">
      <ShippingCutoff class="a-trust-item" />
      <p class="a-trust-item">Gratis verzending vanaf {SITE.shipping.freeFromBoxes} boxen</p>
      <p class="a-trust-item">{SITE.guarantee}</p>
      <RatingBadge class="a-trust-rating" />
    </div>
  </section>

  <section class="a-steps" aria-labelledby="a-steps-title">
    <div class="a-wrap a-steps-grid">
      <div class="a-film">
        <Image
          src={poster}
          alt="Vrienden proeven samen wijn aan een tafel met kaarsen"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 46rem, 100vw"
          class="a-film-img"
        />
        <span class="a-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-7"><path d="M9 6l10 6-10 6z" fill="currentColor"></path></svg>
        </span>
        <span class="a-film-cap">Bekijk een avond Flavory · 40 seconden</span>
      </div>
      <div>
        <h2 id="a-steps-title" class="a-h2">Een wijnproeverij thuis, in drie stappen</h2>
        <ol class="a-steplist">
          {
            steps.map((step, i) => (
              <li>
                <span class="a-num" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <p class="a-step-title">{step.title}</p>
                  <p class="a-step-text">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="a-facts">2 tot 6 spelers · 60 tot 90 minuten · geen wijnkennis nodig</p>
      </div>
    </div>
    <div class="a-wrap a-pack">
      <Image
        src={contents}
        alt="De inhoud van het pakket: de speldoos, proefformulieren, infobrochures, kaarten en twee stoffen zakjes"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 30rem, 100vw"
        class="a-pack-img"
      />
      <div>
        <h3 class="a-h3">In het pakket</h3>
        <p class="a-pack-text">
          De speldoos, twee flessen wijn (75 cl) in stoffen zakjes A en B, proefformulieren, rolkaarten en tipkaartjes.
          Zelf zet je glazen en een kurkentrekker klaar.
        </p>
        <a href="/hoe-werkt-het/" class="a-link">De spelregels in 6 stappen</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Prototype only: keep the consent banner out of the design screenshots. */
  #consent-banner,
  [data-consent-form] {
    display: none !important;
  }
</style>

<style>
  .a-wrap {
    margin-inline: auto;
    width: 100%;
    max-width: 82rem;
    padding-inline: 1rem;
  }
  .a-hero {
    display: grid;
    gap: 1.5rem;
    padding-block: 1.5rem 2.5rem;
  }
  .a-h1 {
    font-size: clamp(2.25rem, 1rem + 3.3vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    max-width: 16em;
  }
  .a-lead {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    line-height: 1.45;
  }
  .a-shelf {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .a-box {
    display: flex;
    height: 100%;
    flex-direction: column;
    border-radius: 1.25rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .a-box-img {
    aspect-ratio: 5 / 4;
    width: 100%;
    object-fit: cover;
    border-radius: 1.25rem;
  }
  @media (hover: hover) {
    .a-box:hover .a-box-img {
      transform: translateY(-4px);
    }
    .a-box-img {
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
  .a-box-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 0.25rem 0;
  }
  .a-box-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
  }
  .a-box-duel {
    font-size: 1rem;
  }
  .a-box-price {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .a-box-price b {
    font-size: 1.375rem;
    color: var(--color-ink);
  }
  .a-box-btn {
    margin-top: 0.75rem;
    display: flex;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-weight: 700;
  }
  .a-photo {
    position: relative;
  }
  .a-photo-img {
    aspect-ratio: 4 / 5;
    width: 100%;
    border-radius: 1.25rem;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .a-photo-cap {
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.75rem;
    border-radius: 0.875rem;
    background: var(--color-cream);
    padding: 0.625rem 0.875rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .a-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .a-steps {
    background: white;
    padding-block: 3rem;
  }
  .a-steps-grid {
    display: grid;
    gap: 2rem;
  }
  .a-film {
    position: relative;
  }
  .a-film-img {
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: 1.25rem;
    object-fit: cover;
  }
  .a-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    width: 4.5rem;
    height: 4.5rem;
    translate: -50% -50%;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-brand);
    color: white;
  }
  .a-film-cap {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    border-radius: 999px;
    background: var(--color-cream);
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .a-h2 {
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .a-steplist {
    margin-top: 1.5rem;
  }
  .a-steplist li {
    display: flex;
    gap: 1rem;
    border-top: 1px solid var(--color-line);
    padding-block: 1rem;
  }
  .a-num {
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-ink);
    font-weight: 700;
    color: white;
  }
  .a-step-title {
    font-size: 1.125rem;
    font-weight: 700;
  }
  .a-step-text {
    margin-top: 0.125rem;
    color: var(--color-muted);
  }
  .a-facts {
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
    font-weight: 700;
  }
  .a-pack {
    margin-top: 3rem;
    display: grid;
    align-items: center;
    gap: 1.5rem;
  }
  .a-pack-img {
    aspect-ratio: 3 / 2;
    width: 100%;
    border-radius: 1.25rem;
    object-fit: cover;
    object-position: 50% 78%;
  }
  .a-h3 {
    font-family: var(--font-display);
    font-size: 1.75rem;
  }
  .a-pack-text {
    margin-top: 0.5rem;
    max-width: 34rem;
    font-size: 1.125rem;
  }
  .a-link {
    margin-top: 0.75rem;
    display: inline-block;
    font-weight: 700;
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .a-wrap {
      padding-inline: 2rem;
    }
    .a-hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr auto;
      column-gap: 2rem;
      row-gap: 1.5rem;
      padding-block: 2rem 3rem;
    }
    .a-copy {
      grid-column: 1 / span 8;
    }
    .a-shelf {
      grid-column: 1 / span 8;
      gap: 1.5rem;
    }
    .a-photo {
      grid-column: 9 / span 4;
      grid-row: 1 / span 2;
    }
    .a-photo-img {
      height: 100%;
      aspect-ratio: auto;
    }
    .a-trust {
      grid-column: 1 / -1;
    }
    .a-box {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
    .a-box-img {
      width: 52%;
      aspect-ratio: 1;
    }
    .a-box-text {
      padding: 0;
    }
    .a-steps {
      padding-block: 5rem;
    }
    .a-steps-grid {
      grid-template-columns: 7fr 5fr;
      align-items: center;
      gap: 3.5rem;
    }
    .a-pack {
      grid-template-columns: 5fr 7fr;
      gap: 3.5rem;
    }
  }
</style>
