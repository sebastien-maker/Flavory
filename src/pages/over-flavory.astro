---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { absoluteUrl, PRESS, SITE } from '@/lib/site';
import { breadcrumbs, organizationExtra, person, webPage } from '@/components/seo/schema';

const path = '/over-flavory/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Over Flavory', path },
];
const title = 'Over Flavory: het verhaal achter het wijnspel';
const description =
  'Maak kennis met Flavory, het wijnspel uit Bazel: ontstaan uit liefde voor wijn en beleving, door oprichters Bart en Thomas. Proeven wordt leuker dan ooit.';

const team = (await getCollection('authors')).filter((a) => a.data.image);
const people = await Promise.all(
  team.map(async (a) =>
    person({
      id: a.id,
      name: a.data.name,
      description: a.data.role,
      image: a.data.image
        ? absoluteUrl((await getImage({ src: a.data.image, width: 600, format: 'jpg' })).src)
        : undefined,
      sameAs: a.data.sameAs,
    }),
  ),
);
const stores = (await getCollection('stores')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={[
    webPage({ path, title, description, type: 'AboutPage' }),
    organizationExtra({
      subjectOf: PRESS.map((item) => ({
        '@type': 'Article',
        headline: item.title,
        url: item.url,
        datePublished: item.date,
        publisher: { '@type': 'Organization', name: item.source },
      })),
    }),
    ...people,
    breadcrumbs(crumbs),
  ]}
>
  <Breadcrumbs items={crumbs} />
  <article class="container-site max-w-3xl py-8 md:py-12">
    <h1 class="h1">Over Flavory</h1>
    <p class="lead mt-4">
      Wij zijn Bart en Thomas, de makers van Flavory, het Belgische wijnspel uit Bazel. We maakten het omdat we wijn
      wilden leren proeven zonder cursus of dikke boeken: gewoon met vrienden aan tafel.
    </p>
    <div class="prose-flavory mt-6">
      <h2>Hoe het begon</h2>
      <p>
        Je staat in de supermarkt voor een rek vol flessen. Kijk je naar de kleur, de druif of het land? Of kies je,
        zoals altijd, de fles met het mooiste etiket? Bart stond daar ook, en vond nergens een eenvoudige manier om meer
        over wijn te leren. Dus maakte hij er zelf een: een spel waarbij je twee wijnen blind proeft en al spelend
        ontdekt wat je lekker vindt. Het{' '}
        <a href="/blog/het-prille-begin-van-flavory-anno-2017/">prille begin van Flavory</a> lees je op onze blog.
      </p>
    </div>
  </article>

  <section class="container-site py-8" aria-labelledby="team-title">
    <h2 id="team-title" class="h2 text-center">
      De mensen achter Flavory
    </h2>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <div id="bart" class="scroll-mt-28 rounded-[var(--radius-card)] bg-white p-6 ring-1 ring-line">
        {team.find((a) => a.id === 'bart')?.data.image && (
          <Image
            src={team.find((a) => a.id === 'bart')!.data.image!}
            alt="Portret van Bart Claessens"
            widths={[320, 480]}
            sizes="(min-width: 768px) 20rem, 80vw"
            class="mx-auto aspect-square w-full max-w-60 rounded-full object-cover"
          />
        )}
        <h3 class="h4 mt-4 text-center">Bart, het creatieve brein</h3>
        <p class="mt-3">
          "Interesse voor wijn heb ik altijd gehad, maar ik miste een laagdrempelige manier om er meer over te leren.
          Liefst van al bleef het nog een beetje leuk ook. En wie weet zat er wel een competitief element in? Toen ik
          dat nergens vond, heb ik het maar zelf ontwikkeld."
        </p>
        <p class="mt-3">
          <a href="/over-flavory/bart/" class="font-bold text-brand underline">
            Meer over Bart
          </a>
        </p>
      </div>
      <div id="thomas" class="scroll-mt-28 rounded-[var(--radius-card)] bg-white p-6 ring-1 ring-line">
        {team.find((a) => a.id === 'thomas')?.data.image && (
          <Image
            src={team.find((a) => a.id === 'thomas')!.data.image!}
            alt="Portret van Thomas, medeoprichter van Flavory"
            widths={[320, 480]}
            sizes="(min-width: 768px) 20rem, 80vw"
            class="mx-auto aspect-square w-full max-w-60 rounded-full object-cover"
          />
        )}
        <h3 class="h4 mt-4 text-center">Thomas, het businessbrein</h3>
        <p class="mt-3">
          "Mijn passie voor ondernemen combineren met mijn liefde voor wijn: die kans grijp ik met beide handen."
        </p>
      </div>
    </div>
  </section>

  <section class="container-site max-w-3xl py-8" aria-labelledby="feiten-title">
    <div class="rounded-[var(--radius-card)] bg-blush p-6">
      <h2 id="feiten-title" class="h4">
        Flavory in het kort
      </h2>
      <dl class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-[auto_1fr]">
        <dt class="font-bold">Opgericht</dt>
        <dd>{SITE.foundingDate}</dd>
        <dt class="font-bold">Bedrijf</dt>
        <dd>{SITE.legalName}</dd>
        <dt class="font-bold">Adres</dt>
        <dd>
          {SITE.address.street}, {SITE.address.postalCode} {SITE.address.city}
        </dd>
        <dt class="font-bold">Btw-nummer</dt>
        <dd>BE 0757.810.421</dd>
        {SITE.customers && (
          <>
            <dt class="font-bold">Klanten</dt>
            <dd>{SITE.customers}</dd>
          </>
        )}
        {stores.length > 0 && (
          <>
            <dt class="font-bold">Verkooppunten</dt>
            <dd>
              {stores.length} winkels: {stores.map((s) => `${s.data.name} (${s.data.city})`).join(', ')}
            </dd>
          </>
        )}
        <dt class="font-bold">Contact</dt>
        <dd>
          <a href={`mailto:${SITE.email}`} class="text-brand underline">
            {SITE.email}
          </a>
        </dd>
      </dl>
      <p class="mt-4">
        Bekijk ook{' '}
        <a href={SITE.social.youtube} class="text-brand underline" rel="noopener">
          onze video's op YouTube
        </a>
        .
      </p>
    </div>
  </section>

  <section class="container-site max-w-3xl py-8" aria-labelledby="pers-title">
    <h2 id="pers-title" class="h2">
      Over ons geschreven
    </h2>
    <ul class="mt-4 space-y-4">
      {PRESS.map((item) => (
        <li class="rounded-[var(--radius-card)] bg-white p-6 ring-1 ring-line">
          <p class="text-sm text-muted">
            {item.source} · {item.dateLabel}
          </p>
          <h3 class="h4 mt-1">{item.title}</h3>
          {item.quote && <blockquote class="mt-3 border-l-4 border-brand pl-4 italic">"{item.quote}"</blockquote>}
          <p class="mt-3">
            <a href={item.url} class="font-bold text-brand underline">
              Lees het artikel bij {item.source}
            </a>
          </p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
