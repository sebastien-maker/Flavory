---
// Campaign landing (newsletter contest). Linked from ads and socials; not indexed.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import winnerImage from '@/assets/images/site/winnares-wijnkelder.webp';
---

<BaseLayout
  title="Win een wijnkelder van €500"
  description="Schrijf je in voor de nieuwsbrief van Flavory en maak elk seizoen kans op een wijnpakket ter waarde van €500 om eindelijk je wijnkelder aan te leggen."
  path="/win/"
  image={winnerImage}
  imageAlt="Winnares van een wijnkelder van Flavory"
  noindex
>
  <section class="container-site grid items-center gap-8 py-10 md:grid-cols-2 md:py-16">
    <div>
      <h1 class="h1">Schrijf je in voor de nieuwsbrief en win een wijnkelder van €500</h1>
      <p class="lead mt-4">
        Klaar om jezelf onder te dompelen in de wereld van wijn? Voor een slokje inspiratie en het laatste nieuws over
        onze boxen. Elk seizoen verloten we onder de abonnees een wijnpakket ter waarde van €500, om eindelijk die
        wijnkelder aan te leggen.
      </p>
    </div>
    <Image
      src={winnerImage}
      alt="Winnares van een Flavory-wijnkelder met haar wijnpakket"
      widths={[320, 480, 768]}
      sizes="(min-width: 768px) 40vw, 90vw"
      class="mx-auto w-full max-w-md rounded-[var(--radius-card)]"
      loading="eager"
    />
  </section>
  <Newsletter />
</BaseLayout>
