---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import { breadcrumbs, webPage } from '@/components/seo/schema';
import { SITE } from '@/lib/site';
import bartImage from '@/assets/images/team/bart.jpg';
import stillImage from '@/assets/images/site/proeverij-still.webp';

const path = '/zakelijk/teambuilding-wijnproeverij/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Zakelijk', path: '/zakelijk/' },
  { name: 'Teambuilding wijnproeverij', path },
];
const title = 'Teambuilding wijnproeverij op locatie';
const description =
  'Flavory komt naar je toe: een begeleide wijnproeverij als teambuilding of thema-avond, voor 6 tot 99 personen, vanaf €30 per persoon, inclusief 7 wijnen.';

const service = {
  '@type': 'Service',
  '@id': `${SITE.url}${path}#service`,
  name: 'Flavory wijnproeverij op locatie',
  serviceType: 'Begeleide wijnproeverij',
  description,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'België' },
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '30.00',
      priceCurrency: 'EUR',
      unitText: 'per persoon',
      minPrice: '30.00',
    },
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  image={stillImage}
  schema={[webPage({ path, title, description }), service, breadcrumbs(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <section class="container-site grid items-center gap-8 py-8 md:grid-cols-2 md:py-12">
    <div>
      <p class="text-sm font-bold tracking-wide text-brand uppercase">The Flavory Real Experience</p>
      <h1 class="h1 mt-2">Teambuilding wijnproeverij op jouw locatie</h1>
      <p class="lead mt-4">
        Geen handleiding nodig: Flavory regisseert het wijnspel op jouw locatie. Jij kiest de datum en het publiek, wij
        zorgen voor een boeiende en leerrijke avond.
      </p>
      <ul class="mt-6 grid gap-2 sm:grid-cols-2">
        {[
          'Van 6 tot 99 personen',
          'Vanaf €30 per persoon',
          'Inclusief 7 wijnen',
          'Geen voorkennis nodig',
          'Ideaal als teambuilding of thema-avond',
        ].map((item) => (
          <li class="flex gap-2 rounded-xl bg-white p-3 font-bold ring-1 ring-line">
            <span class="text-brand" aria-hidden="true">
              ✓
            </span>
            {item}
          </li>
        ))}
      </ul>
      <a href="#aanvraag" class="btn-primary mt-6">
        Plan jouw proeverij
      </a>
    </div>
    <Image
      src={stillImage}
      alt="Deelnemers aan een Flavory-proeverij bekijken hun wijn bij kaarslicht"
      widths={[400, 640, 960]}
      sizes="(min-width: 768px) 50vw, 90vw"
      class="aspect-video w-full rounded-[var(--radius-card)] object-cover"
      loading="eager"
    />
  </section>

  <section class="container-site grid items-center gap-8 py-8 md:grid-cols-[1fr_2fr] md:py-12">
    <Image
      src={bartImage}
      alt="Bart Claessens, oprichter van Flavory en gastheer van de proeverijen"
      widths={[320, 480]}
      sizes="(min-width: 768px) 30vw, 80vw"
      class="mx-auto aspect-square w-full max-w-xs rounded-full object-cover"
    />
    <div class="prose-flavory">
      <h2>Wijn smaakt beter als je weet wat je drinkt</h2>
      <p>
        Daar zijn we bij Flavory van overtuigd. We willen je uitdagen om echt te ruiken en te proeven. Geen elitair
        gedoe, gewoon goede verhalen en nog betere wijn.
      </p>
      <p>
        Oprichter Bart leidt de proeverij zelf. Je leert hoe je wijn proeft, ontdekt je eigen voorkeur, luistert naar
        wijnverhalen en probeert ondertussen de anderen te verslaan. Wie wordt de grootste wijnkenner van het team?
      </p>
      <h3>Wij komen naar jou toe</h3>
      <p>
        Of je nu in Antwerpen, Gent of Leuven zit: we brengen alles mee, van glazen en koelers tot de wijn. Jij zorgt
        voor de ruimte en het gezelschap.
      </p>
      <p>
        Liever thuis spelen met een kleinere groep? Kies dan een <a href="/shop/">Flavory-box</a>. Zoek je een geschenk
        voor klanten of collega's? Bekijk onze <a href="/zakelijk/">relatiegeschenken</a>.
      </p>
    </div>
  </section>

  <section id="aanvraag" class="container-site scroll-mt-28 py-8 md:py-12" aria-labelledby="aanvraag-title">
    <div class="grid gap-8 rounded-[var(--radius-card)] bg-white p-6 ring-1 ring-line md:grid-cols-[1fr_2fr] md:p-10">
      <div>
        <h2 id="aanvraag-title" class="h3">
          Verstuur je aanvraag
        </h2>
        <p class="mt-3">Wil je meer weten? Vul vrijblijvend het formulier in. We nemen daarna contact met je op.</p>
      </div>
      <ContactForm name="proeverij" submitLabel="Aanvraag versturen" />
    </div>
  </section>
</BaseLayout>
